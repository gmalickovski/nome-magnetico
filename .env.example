# App
APP_ENV=development
APP_URL=http://localhost:4321

# Painel operacional (admin.nomemagnetico.com.br)
# Vazio em produção. admin.localhost já é reconhecido sem override.
# ADMIN_HOST_OVERRIDE=admin.localhost
ADMIN_HOST_OVERRIDE=
# Se preenchido, /admin no site público redireciona para cá. Vazio mantém o HQ.
ADMIN_OPS_URL=https://admin.nomemagnetico.com.br

# HQ_API_URL e HQ_INTERNAL_TOKEN não são mais usados (DEV-114).
# Promoções, cupons e trials leem o banco local do NM.

# Supabase (server-side)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Supabase (client-side — prefix PUBLIC_ para Astro expor ao browser)
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Google Analytics 4
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_measurement_protocol_api_secret
GA4_CLIENT_ID_HASH_SECRET=gerar_uuid_aleatorio

# PostHog (analytics de produto, em paralelo ao GA4)
# Sem PUBLIC_POSTHOG_KEY o snippet não inicializa. Não commitar a chave real.
# Host do projeto US: https://us.i.posthog.com
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Servidor (webhook Stripe). Se vazios, o backend usa PUBLIC_POSTHOG_KEY e PUBLIC_POSTHOG_HOST.
# POSTHOG_API_KEY é a project key, a mesma do browser. Sem nenhuma das duas, o purchase não envia.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_NOME_MAGNETICO=price_xxxx
STRIPE_PRICE_NOME_BEBE=price_xxxx
STRIPE_PRICE_NOME_EMPRESA=price_xxxx

# IA — Groq (development)
GROQ_API_KEY=gsk_xxxx

# IA — Claude (production)
ANTHROPIC_API_KEY=sk-ant-xxxx

# IA — OpenAI (fallback)
OPENAI_API_KEY=sk-xxxx

# N8N Webhooks (pagamento e marketing; o formulário de contato não usa n8n)
N8N_WEBHOOK_TRANSACIONAL=https://n8n.seudominio.com.br/events-nm
N8N_WEBHOOK_MARKETING=https://n8n.seudominio.com.br/webhook/nm-email-marketing
# Segredo enviado no header Authorization para o webhook events-nm (DEV-174)
N8N_EVENTS_WEBHOOK_SECRET=
INTERNAL_API_SECRET=gerar_uuid_aleatorio
# Segredo para assinatura de links de download de PDF gratuito (DEV-119)
DOWNLOAD_PDF_SECRET=gerar_uuid_aleatorio_ou_chave_secreta

# SMTP Amazon SES — aviso interno do formulário de contato (somente servidor)
# Mesmas variáveis da edge function send-free-pdf. Sem senha real neste arquivo.
SMTP_HOST=email-smtp.regiao.amazonaws.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contato@seudominio.com.br
# Caixa única do formulário de contato. Vazio usa suporte@nomemagnetico.com.br.
SUPPORT_INBOX_EMAIL=suporte@nomemagnetico.com.br

# Rate Limiting
RATE_LIMIT_TESTE_BLOQUEIO=3

# Cloudflare Turnstile (análise gratuita /api/teste-bloqueio)
# Opcional: sem TURNSTILE_SECRET_KEY a API ignora o captcha.
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Origens permitidas no POST /api/teste-bloqueio (opcional, separadas por vírgula).
# Se vazio, usa APP_URL e a variante com/sem www.
# FREE_ANALYSIS_ALLOWED_ORIGINS=https://nomemagnetico.com.br,https://www.nomemagnetico.com.br

# Sentry — erros de produção (org studio-mlk, projeto nome-magnetico, região DE)
# Sem DSN o SDK fica desligado. Fora de APP_ENV=production também fica desligado,
# a menos que SENTRY_ENABLED=true. Nunca commitar o DSN real.
# O app é Astro: o browser lê o DSN em runtime. PUBLIC_SENTRY_DSN e
# NEXT_PUBLIC_SENTRY_DSN são aliases aceitos no servidor (o ticket cita o nome Next).
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_ORG=studio-mlk
SENTRY_PROJECT=nome-magnetico
SENTRY_URL=https://de.sentry.io
# Opcional. Força envio fora de production (smoke local): true | false
# SENTRY_ENABLED=
# Opcional. Identifica o deploy no Sentry. Sem isso o evento segue sem release.
# SENTRY_RELEASE=
# Source maps: criar em Sentry → Settings → Auth Tokens.
# Scopes: project:releases e org:read. Colocar no build (GitHub Actions secret
# SENTRY_AUTH_TOKEN), não só na VPS. Sem token o build segue e o stack fica minificado.
# SENTRY_AUTH_TOKEN=

# Notion
NOTION_TOKEN=ntn_xxxx
NOTION_FAQ_DB_ID=xxxx
NOTION_SUPPORT_DB_ID=xxxx
NOTION_DEVOPS_PAGE_ID=xxxx

# Nome Social: motor de sugestoes v4 (DEV-301). Padrao: ligado.
# NOME_SOCIAL_MOTOR_V4=false          # rollback para o comportamento DEV-275
# NOME_SOCIAL_GANHO_MINIMO_PONTOS=0   # so sobe o minimo acima de nascimento+1; nunca baixa o piso 70

# IA: teto de tokens por usuario em 24h (soma de ai_usage). Padrao 500000; 0 desliga. DEV-304.
# AI_MAX_TOKENS_PER_USER_DAY=500000

# JEV do chat (decide-live): protecoes de custo e provedores. DEV-303 e DEV-304.
# Ordem: TypeSafe (JEV) > Groq (gratuito) > OpenAI (so reserva) > regras locais.
# NM_JEV_REMOTE_DISABLED=true             # corta toda chamada externa na hora
# NM_JEV_MAX_CALLS_PER_ANON=6             # chamadas externas por visitante em 10 min
# NM_JEV_MAX_CALLS_PER_USER=20            # idem, por usuario logado
# NM_JEV_MAX_CALLS_PER_HOUR=400           # teto global por hora
# NM_JEV_MAX_TOKENS_PER_HOUR=150000       # tokens por hora (Groq e OpenAI); 0 desliga
# NM_JEV_STRUCTURED_TIMEOUT_MS=           # tempo limite Groq/OpenAI (padrao 3500 e 4000)
# GROQ_DECIDE_MODEL=openai/gpt-oss-20b    # modelo gratuito do Groq para a decisao
# OPENAI_DECIDE_MODEL=gpt-4o-mini         # so reserva
