# App
APP_ENV=development
APP_URL=http://localhost:4321

# Painel operacional (admin.nomemagnetico.com.br)
# Vazio em produção. admin.localhost já é reconhecido sem override.
# ADMIN_HOST_OVERRIDE=admin.localhost
ADMIN_HOST_OVERRIDE=
# Se preenchido, /admin no site público redireciona para cá. Vazio mantém o HQ.
ADMIN_OPS_URL=https://admin.nomemagnetico.com.br

# Supabase (server-side)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Supabase (client-side — prefix PUBLIC_ para Astro expor ao browser)
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Google Analytics 4
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_measurement_protocol_api_secret
GA4_CLIENT_ID_HASH_SECRET=gerar_uuid_aleatorio

# PostHog (analytics de produto, em paralelo ao GA4)
# Sem PUBLIC_POSTHOG_KEY o snippet não inicializa. Não commitar a chave real.
# Host do projeto US: https://us.i.posthog.com
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_NOME_MAGNETICO=price_xxxx
STRIPE_PRICE_NOME_BEBE=price_xxxx
STRIPE_PRICE_NOME_EMPRESA=price_xxxx

# IA — Groq (development)
GROQ_API_KEY=gsk_xxxx

# IA — Claude (production)
ANTHROPIC_API_KEY=sk-ant-xxxx

# IA — OpenAI (fallback)
OPENAI_API_KEY=sk-xxxx

# N8N Webhooks
N8N_WEBHOOK_TRANSACIONAL=https://n8n.seudominio.com.br/events-nm
N8N_WEBHOOK_SUPORTE=https://n8n.seudominio.com.br/suport-nm
N8N_WEBHOOK_MARKETING=https://n8n.seudominio.com.br/webhook/nm-email-marketing
INTERNAL_API_SECRET=gerar_uuid_aleatorio

# Rate Limiting
RATE_LIMIT_TESTE_BLOQUEIO=3

# Sentry — erros de produção (org studio-mlk, projeto nome-magnetico, região DE)
# Sem DSN o SDK fica desligado. Fora de APP_ENV=production também fica desligado,
# a menos que SENTRY_ENABLED=true. Nunca commitar o DSN real.
# O app é Astro: o browser lê o DSN em runtime. PUBLIC_SENTRY_DSN e
# NEXT_PUBLIC_SENTRY_DSN são aliases aceitos no servidor (o ticket cita o nome Next).
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_ORG=studio-mlk
SENTRY_PROJECT=nome-magnetico
SENTRY_URL=https://de.sentry.io
# Opcional. Força envio fora de production (smoke local): true | false
# SENTRY_ENABLED=
# Opcional. Identifica o deploy no Sentry. Sem isso o evento segue sem release.
# SENTRY_RELEASE=
# Source maps: criar em Sentry → Settings → Auth Tokens.
# Scopes: project:releases e org:read. Colocar no build (GitHub Actions secret
# SENTRY_AUTH_TOKEN), não só na VPS. Sem token o build segue e o stack fica minificado.
# SENTRY_AUTH_TOKEN=

# Notion
NOTION_TOKEN=ntn_xxxx
NOTION_FAQ_DB_ID=xxxx
NOTION_SUPPORT_DB_ID=xxxx
NOTION_DEVOPS_PAGE_ID=xxxx
