---
import { redeemAccessTrial } from '../../backend/payments/trial-redeem';
import { TRIAL_NOT_FOUND } from '../../backend/payments/promo-math';
import BaseLayout from '../../layouts/BaseLayout.astro';

const code = Astro.url.searchParams.get('code');
const days = Astro.url.searchParams.get('days') ?? '7';
const product = Astro.url.searchParams.get('product') ?? 'all';
const kind = Astro.url.searchParams.get('kind') ?? 'trial';

const user = Astro.locals.user;

if (!user) {
  const resgatarUrl = `/acesso/resgatar?code=${encodeURIComponent(code ?? '')}&days=${days}&product=${encodeURIComponent(product)}&kind=${encodeURIComponent(kind)}`;
  return Astro.redirect(`/auth/login?redirect=${encodeURIComponent(resgatarUrl)}`);
}

if (!code) {
  return Astro.redirect('/app');
}

const result = await redeemAccessTrial({
  trialCode: code,
  userId: user.id,
  userEmail: user.email,
});

if (result.ok) {
  return Astro.redirect('/app?trial=ativado');
}

if (result.alreadyRedeemed || result.alreadyActive) {
  return Astro.redirect('/app?trial=ja_ativo');
}

const message = result.error ?? TRIAL_NOT_FOUND;
---

<BaseLayout
  title="Código de acesso inválido"
  description="Este código de acesso não pôde ser ativado."
  noIndex={true}
>
  <div class="min-h-screen bg-[#131313] flex items-center justify-center px-4 py-16">
    <div class="max-w-md w-full">
      <div class="text-center mb-8">
        <a href="/" class="font-cinzel text-2xl font-bold text-[#D4AF37] tracking-wider">
          NOME MAGNÉTICO
        </a>
      </div>
      <div class="bg-[#1a1a1a] rounded-2xl p-8 shadow-[0_20px_50px_rgba(0,0,0,0.6)] text-center">
        <h1 class="font-cinzel text-2xl font-bold text-[#e5e2e1] mb-3">Não foi possível ativar</h1>
        <p class="text-[#76746a] text-sm leading-relaxed mb-8">{message}</p>
        <a
          href="/"
          class="inline-block rounded-full bg-[#f2ca50] px-8 py-3 text-sm font-medium text-[#131313] shadow-[0_0_24px_rgba(242,202,80,0.18)]"
        >
          Voltar ao início
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
