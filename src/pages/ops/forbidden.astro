---
import AdminAuthLayout from '../../layouts/AdminAuthLayout.astro';
import { OpsLogoutButton } from '../../frontend/components/ops/OpsLogoutButton';
---

<AdminAuthLayout title="Sem permissão">
  <section class="rounded-2xl bg-[#1c1b1a]/80 px-8 py-10 text-center shadow-[0_20px_50px_rgba(0,0,0,0.6)] backdrop-blur-xl">
    <h1 class="font-cinzel text-2xl text-[#e5e2e1]">Sem permissão</h1>
    <p class="mt-4 text-sm leading-relaxed text-[#76746a]">
      Esta conta não faz parte da equipe. O painel operacional fica separado da área do cliente.
    </p>
    <div class="mt-8 flex justify-center">
      <OpsLogoutButton client:load />
    </div>
  </section>
</AdminAuthLayout>
