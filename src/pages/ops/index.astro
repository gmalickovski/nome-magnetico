---
import OpsLayout from '../../layouts/OpsLayout.astro';
import { requestHost, opsHref } from '../../backend/ops/host';
import { getOpsOverview } from '../../backend/ops/users';

if (!Astro.locals.opsAdmin) {
  return Astro.redirect(opsHref(requestHost(Astro.request, Astro.url), '/login'));
}

const hostname = requestHost(Astro.request, Astro.url);
let overview: { users: number; admins: number; testUsers: number } | null = null;
let loadError = false;

try {
  overview = await getOpsOverview();
} catch (error) {
  console.error('[ops] falha ao carregar o painel:', error);
  loadError = true;
}

const cards = overview
  ? [
      { label: 'Usuários', value: overview.users },
      { label: 'Admins', value: overview.admins },
      { label: 'Contas teste', value: overview.testUsers },
    ]
  : [];
---

<OpsLayout title="Painel" section="home" hostname={hostname} adminEmail={Astro.locals.user?.email}>
  <header class="mb-8">
    <p class="text-xs font-medium uppercase tracking-[0.16em] text-[#76746a]">Operação</p>
    <h1 class="mt-2 font-cinzel text-3xl font-bold text-[#e5e2e1]">Painel</h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[#76746a]">
      Visão inicial da operação do Nome Magnético. A lista de usuários já pode ser consultada. Assinaturas, cobrança e suporte entram nas próximas fatias.
    </p>
  </header>

  {loadError && (
    <p class="rounded-2xl bg-[#1c1b19] px-5 py-4 text-sm text-[#e5e2e1] shadow-[0_20px_50px_rgba(0,0,0,0.45)]">
      Não foi possível carregar os números agora.
    </p>
  )}

  {overview && (
    <section class="grid gap-4 sm:grid-cols-3">
      {cards.map((card) => (
        <article class="rounded-2xl bg-[#1c1b19] px-5 py-6 shadow-[0_20px_50px_rgba(0,0,0,0.45)]">
          <p class="text-xs font-medium uppercase tracking-[0.14em] text-[#76746a]">{card.label}</p>
          <p class="mt-3 font-cinzel text-3xl text-[#f2ca50]">{card.value}</p>
        </article>
      ))}
    </section>
  )}

  <a
    href={opsHref(hostname, '/users')}
    class="mt-8 inline-flex rounded-full bg-[#f2ca50] px-5 py-2.5 text-sm font-medium text-[#131313] shadow-[0_12px_30px_rgba(242,202,80,0.18)] transition duration-700 hover:bg-[#d4af37]"
  >
    Ver usuários
  </a>
</OpsLayout>
