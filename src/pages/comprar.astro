---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CheckoutFlow } from '../frontend/components/purchase/CheckoutFlow';
import { hasActiveSubscription } from '../backend/db/subscriptions';
import { createUserClient } from '../backend/db/supabase';
import type { PriceInfo, ActivePromotion } from '../backend/payments/prices';
import { applyPricingPageCache, loadPagePricing } from '../backend/pricing/astro-pricing';
import { AVISO_AUTOCONHECIMENTO } from '../shared/legal';
import { readLinkedCoupon, withLinkedCoupon } from '../shared/checkout-coupon-link';

applyPricingPageCache(Astro);

const user = Astro.locals.user;

// Admin: redirecionar direto para o app
if (user) {
  try {
    const client = createUserClient(Astro.locals.accessToken ?? '');
    const { data: profile } = await client
      .from('profiles').select('role').eq('id', user.id).single();
    if (profile?.role === 'admin') return Astro.redirect('/app');
  } catch {}
}

const produto = Astro.url.searchParams.get('produto') ?? '';
const autoOpenCheckout = Astro.url.searchParams.get('checkout') === '1';
const productType = 'nome_social' as const;
const checkoutPath = withLinkedCoupon(`/comprar?produto=${productType}&checkout=1`, Astro.url.searchParams);
const linkedCoupon = readLinkedCoupon(Astro.url.searchParams);
if (linkedCoupon) Astro.response.headers.set('Cache-Control', 'private, no-store');

// Não-logados com produto explícito → enviar para cadastro/login
if (!user && produto === productType) {
  if (linkedCoupon) {
    const redirect = Astro.redirect(`/auth/cadastro?redirect=${encodeURIComponent(checkoutPath)}`);
    redirect.headers.set('Cache-Control', 'private, no-store');
    return redirect;
  }
  return Astro.redirect(`/auth/cadastro?produto=${productType}`);
}

let isOwned = false;
if (user) {
  isOwned = await hasActiveSubscription(user.id, productType);
}

// Preços e promoção do banco local (fallback Stripe sem promoção)
let hqPrices: Record<string, PriceInfo> | undefined;
let promotion: ActivePromotion | null = null;
try {
  const result = await loadPagePricing();
  hqPrices = result.prices;
  promotion = result.promotion;
} catch (err) {
  console.warn('[comprar] Falha ao carregar preços/promoção — usando fallback:', err);
}

const paymentLinks = {
  nome_social: linkedCoupon
    ? `/auth/login?redirect=${encodeURIComponent(checkoutPath)}`
    : '/auth/login?redirect=/comprar?produto=nome_social',
};
// BreadcrumbList para /comprar — melhora navegação no Google e AI Overviews
const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Início',
      item: 'https://nomemagnetico.com.br',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Planos de Análise Numerológica',
      item: 'https://nomemagnetico.com.br/comprar',
    },
  ],
};
---

<BaseLayout
  title="Planos de Análise Numerológica — Nome Magnético"
  description="Harmonize sua assinatura a partir do nome de nascimento com o Nome Social. Pagamento único, acesso imediato por 30 dias, PDF para download e garantia de 7 dias."
  keywords="comprar numerologia cabalística, planos numerologia, preço mapa numerológico, análise nome cabalística preço, numerologia nome completo comprar, mapa numerológico online, análise bloqueios energéticos nome"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
  <CheckoutFlow
    client:load
    productType={productType}
    isLoggedIn={!!user}
    isOwned={isOwned}
    paymentLinks={paymentLinks}
    hqPrices={hqPrices}
    promotion={promotion}
    autoOpenCheckout={autoOpenCheckout}
    checkoutPath={checkoutPath}
    autoconhecimentoAviso={AVISO_AUTOCONHECIMENTO}
  />
</BaseLayout>
