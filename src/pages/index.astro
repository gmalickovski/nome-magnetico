---
import LandingLayout from '../layouts/LandingLayout.astro';
import { LandingHeader } from '../frontend/components/landing/LandingHeader';
import { HeroSection } from '../frontend/components/landing/HeroSection';
import { HowItWorksSection } from '../frontend/components/landing/HowItWorksSection';
import { ProductsSection } from '../frontend/components/landing/ProductsSection';
import { SignatureUseCasesSection } from '../frontend/components/landing/SignatureUseCasesSection';
import { PricingSection } from '../frontend/components/landing/PricingSection';
import { PromoBanner } from '../frontend/components/landing/PromoBanner';
import { ProductVotingSection } from '../frontend/components/landing/ProductVotingSection';
import { FAQSection } from '../frontend/components/landing/FAQSection';
import type { FaqItemProps } from '../frontend/components/landing/FAQSection';
import { LandingFooter } from '../frontend/components/landing/LandingFooter';
import { getSupabaseFaqs } from '../backend/faqs/getSupabaseFaqs';
import { applyPricingPageCache, loadPagePricing } from '../backend/pricing/astro-pricing';
import type { PriceInfo, ActivePromotion } from '../backend/payments/prices';

applyPricingPageCache(Astro);

let faqItems: FaqItemProps[] = [];
try {
  faqItems = await getSupabaseFaqs({ featuredOnly: true });
} catch (err) {
  console.warn('[index] Falha ao carregar FAQs do Supabase — usando fallback:', err);
}

let hqPrices: Record<string, PriceInfo> | undefined;
let promotion: ActivePromotion | null = null;
try {
  const result = await loadPagePricing();
  hqPrices = result.prices;
  promotion = result.promotion;
} catch (err) {
  console.warn('[index] Falha ao carregar preços/promoção — usando fallback:', err);
}

const user = Astro.locals.user;
const nomeSocialPrice = hqPrices?.nome_social?.cents ?? 0;
const schemaPrice = nomeSocialPrice > 0 ? (nomeSocialPrice / 100).toFixed(2) : undefined;
---

<LandingLayout
  title="Numerologia Cabalística do Seu Nome — Veja Sua Nota Hoje e o Potencial da Sua Assinatura"
  description="Descubra a nota atual do seu nome de nascimento (0 a 100), mapeie sequências no Triângulo da Vida e veja o potencial que sua assinatura pode alcançar com o Método Nome Magnético."
  keywords="numerologia cabalística, análise do nome numerologia, bloqueios energéticos nome, numerologia nome completo, mapa numerológico completo, nome social numerologia, mudar nome numerologia, nome sem bloqueios, análise vibracional gratuita nome, arquétipo junguiano nome"
  schemaOfferPrice={schemaPrice}
  schemaEstimatedCost={schemaPrice}
>
  {promotion && <PromoBanner promotion={promotion} client:load />}
  <LandingHeader client:load />
  <HeroSection client:load />
  <HowItWorksSection client:load />
  <ProductsSection client:visible />
  <SignatureUseCasesSection client:visible />
  {/* Teaser calculadora gratuita */}
  <section id="teste" class="py-20 md:py-28 bg-[#111111]">
    <div class="max-w-[1440px] mx-auto px-6 md:px-10 lg:px-12">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-[#D4AF37] text-xs md:text-sm font-bold tracking-[0.15em] mb-4 md:mb-6">
          Ferramenta gratuita
        </p>
        <h2 class="font-cinzel text-3xl md:text-4xl lg:text-5xl font-bold text-[#e5e2e1] mb-4 leading-tight">
          Veja Sua Nota Hoje<br/>× Seu Potencial — Grátis
        </h2>
        <p class="text-gray-400 text-sm md:text-base max-w-xl mx-auto mb-8 leading-relaxed">
          Calcule gratuitamente a nota atual do seu nome de nascimento (escala N1 a N5), veja as sequências no Triângulo da Vida, a Marca da sua Data e quanto sua assinatura pode subir com a harmonização — relatório em PDF incluído.
        </p>
        <a
          href="/analise-gratuita"
          data-cta-id="analise_gratis"
          data-cta-position="home_teste"
          class="inline-block bg-[#D4AF37] text-[#1A1A1A] font-semibold text-base px-10 py-3 rounded-full hover:bg-[#f2ca50] transition-colors duration-300 shadow-lg shadow-[#D4AF37]/20 motion-reduce:transition-none"
        >
          Fazer Análise Gratuita
        </a>
        <p class="text-gray-600 text-sm mt-4">Gratuito · Acesso na hora · Relatório completo com PDF</p>
      </div>
    </div>
  </section>
  <PricingSection hqPrices={hqPrices} promotion={promotion} isLoggedIn={!!user} client:visible />
  <ProductVotingSection variant="landing" client:visible />
  <FAQSection items={faqItems} client:visible />
  <LandingFooter client:visible />
</LandingLayout>
