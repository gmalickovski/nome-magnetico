---
import AppLayout from '../../../layouts/AppLayout.astro';
import { getUserAnalyses } from '../../../backend/db/analyses';
import { getProfile } from '../../../backend/db/users';
import { hasActiveSubscription } from '../../../backend/db/subscriptions';
import { buildSavedAnalysesItems } from '../../../backend/numerology/saved-analyses-view';
import MyAnalysesWorkspace from '../../../frontend/components/app/analises/MyAnalysesWorkspace';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');

const profile = await getProfile(user.id);
const isAdmin = profile?.role === 'admin';

const analyses = await getUserAnalyses(user.id);
const savedItems = buildSavedAnalysesItems(analyses, {
  isAdmin,
  profileBirthName: profile?.birth_name ?? null,
  profileBirthDate: profile?.birth_date ?? null,
});
const hasPaidAnalysisHistory = savedItems.some(
  (item) => !item.isFree && item.productType !== 'analise_gratuita',
);
const hasAnyPaidAccess =
  isAdmin ||
  (await Promise.all([
    hasActiveSubscription(user.id, 'nome_social'),
    hasActiveSubscription(user.id, 'nome_bebe'),
    hasActiveSubscription(user.id, 'nome_empresa'),
  ]).then((results) => results.some(Boolean)));
const isLocked = !hasAnyPaidAccess && !hasPaidAnalysisHistory;
const initialSelectedId = Astro.url.searchParams.get('id');
---

<AppLayout title="Minhas Análises" noPadding mobileFullViewport>
  {!isLocked && hasAnyPaidAccess && (
    <a
      slot="header-actions"
      href="/app/analise/nome-social"
      data-nm-header-cta="analise"
      data-user-id={user.id}
      data-default-label="+ Nova Análise"
      data-resume-label="Retomar Análise"
      class="inline-flex items-center justify-center gap-2 bg-[#D4AF37] text-[#131313] text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-full shadow-[0_2px_16px_rgba(212,175,55,0.35)] hover:bg-[#f2ca50] hover:shadow-[0_4px_24px_rgba(212,175,55,0.5)] active:scale-95 transition-all duration-300"
    >
      + Nova Análise
    </a>
  )}

  <div class="nm-chat-shell">
    <MyAnalysesWorkspace
      client:load
      initialItems={savedItems}
      userId={user.id}
      hasAnyPaidAccess={hasAnyPaidAccess}
      isLocked={isLocked}
      initialSelectedId={initialSelectedId}
    />
  </div>
</AppLayout>
