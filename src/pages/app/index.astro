---
import AppLayout from '../../layouts/AppLayout.astro';
import { getActiveSubscription, hasActiveSubscription, hasAnySubscription } from '../../backend/db/subscriptions';
import { createUserClient, supabase } from '../../backend/db/supabase';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');

// Desabilitar cache para o botÃ£o voltar do navegador nÃ£o repuxar dados velhos
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

import FreeUsedModal from '../../frontend/components/app/FreeUsedModal';
import { FreePDFAutoGenerator } from '../../frontend/components/app/FreePDFAutoGenerator';
import { MailWarning } from '../../frontend/components/app/MailWarning';
import { DashboardCheckoutButton } from '../../frontend/components/app/DashboardCheckoutButton';
import { getPricesAndPromo, type PriceInfo } from '../../backend/payments/prices';
import { InitialAnalysisModal } from '../../frontend/components/app/InitialAnalysisModal';

// Funções de numerologia locais para cálculo instantâneo da análise gratuita do lead
import { calcularTodosTriangulos, detectarBloqueios } from '../../backend/numerology/triangle';
import {
  calcularExpressao,
  calcularDestino,
  calcularMotivacao,
  calcularImpressao,
  calcularMissao,
} from '../../backend/numerology/numbers';
import {
  detectarLicoesCarmicas,
  detectarTendenciasOcultas,
  mapearFrequencias,
  calcularDebitosCarmicos,
} from '../../backend/numerology/karmic';
import { avaliarCompatibilidade } from '../../backend/numerology/harmonization';
import {
  avaliarNome,
  calcularScoreV1SemOcorrenciasExtras,
  persistenciaScoreFields,
} from '../../backend/numerology/score';
import { getScoreVersion } from '../../backend/numerology/score-version';

// Verifica parÃ¢metros de URL
const showFreeUsedModal   = Astro.url.searchParams.get('free_used') === 'true';
const showCheckoutSuccess = Astro.url.searchParams.get('checkout') === 'success';
const checkoutProduct     = Astro.url.searchParams.get('produto') ?? null;

// Verificar admin e dados do perfil
let isAdmin     = false;
let profileData: any = null;
let freeAnalysisId: string | null = null;
let freeAnalysisStatus: string | null = null;
let freeAnalysis: any = null;
let bestSocialAnalysis: any = null;

const _client = createUserClient(Astro.locals.accessToken ?? '');

try {
  const { data: profile } = await _client
    .from('profiles').select('*').eq('id', user.id).single();
  isAdmin = profile?.role === 'admin';
  profileData = profile;
} catch {}

const needsEmailConfirmation = !(
  profileData?.email_verified_at ||
  user.user_metadata?.email_verified_at
);

import { obterNivelV3 } from '../../shared/score-v3';

// Busca análise gratuita concluída ou em processamento
try {
  const { data: foundFreeAnalysis } = await _client
    .from('analyses')
    .select('id, nome_completo, data_nascimento, score, score_v3, score_version, bloqueios, status')
    .or('is_free.eq.true,product_type.eq.analise_gratuita')
    .eq('user_id', user.id)
    .order('created_at', { ascending: false })
    .limit(1)
    .maybeSingle();

  if (foundFreeAnalysis) {
    freeAnalysisStatus = foundFreeAnalysis.status;
    if (foundFreeAnalysis.status === 'complete') {
      freeAnalysis = foundFreeAnalysis;
      freeAnalysisId = foundFreeAnalysis.id;
    } else if (foundFreeAnalysis.status === 'pending' || foundFreeAnalysis.status === 'processing') {
      freeAnalysisId = foundFreeAnalysis.id;
    }
  }
} catch {}

// Sincronização automática de lead por e-mail para novas contas
let leadNome: string | null = null;
let leadData: string | null = null;
let showOnboardingModal = false;

if (!freeAnalysisId && user.email) {
  try {
    const { data: lead } = await supabase
      .from('free_analyses_leads')
      .select('id, nome_completo, data_nascimento')
      .eq('email', user.email.toLowerCase().trim())
      .order('created_at', { ascending: false })
      .limit(1)
      .maybeSingle();

    if (lead) {
      leadNome = lead.nome_completo;
      const parts = lead.data_nascimento.split('-');
      const formattedBirthDate = parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : lead.data_nascimento;
      leadData = formattedBirthDate;

      // 1. Calcular a numerologia localmente (sem chamar IA)
      const todosTriangulos = calcularTodosTriangulos(lead.nome_completo, formattedBirthDate);
      const bloqueios = detectarBloqueios(todosTriangulos);
      const expressao = calcularExpressao(lead.nome_completo);
      const destino = calcularDestino(formattedBirthDate);
      const motivacao = calcularMotivacao(lead.nome_completo);
      const impressao = calcularImpressao(lead.nome_completo);
      const missao = calcularMissao(lead.nome_completo, formattedBirthDate);
      const licoesCarmicas = detectarLicoesCarmicas(lead.nome_completo);
      const tendenciasOcultas = detectarTendenciasOcultas(lead.nome_completo);
      const debitosCarmicos = calcularDebitosCarmicos(formattedBirthDate, destino, motivacao, expressao);
      const frequencias = mapearFrequencias(lead.nome_completo);
      const scoreLegado = calcularScoreV1SemOcorrenciasExtras({
        bloqueios,
        licoesCarmicas: licoesCarmicas.length,
        tendenciasOcultas: tendenciasOcultas.length,
        debitosCarmicos,
        compatibilidade: avaliarCompatibilidade(expressao, destino),
      });
      const scoreFields = persistenciaScoreFields({
        scoreLegado,
        nomeParaV3: lead.nome_completo,
        dataNascimento: formattedBirthDate,
      });

      // 2. Criar a análise no banco como concluída (complete)
      const { data: newAnalysis, error: analysisError } = await supabase
        .from('analyses')
        .insert({
          user_id: user.id,
          product_type: 'analise_gratuita',
          nome_completo: lead.nome_completo,
          data_nascimento: lead.data_nascimento,
          numero_expressao: expressao,
          numero_destino: destino,
          numero_motivacao: motivacao,
          numero_missao: missao,
          numero_impressao: impressao,
          numero_personalidade: impressao,
          arcano_regente: todosTriangulos.vida.arcanoRegente,
          bloqueios: bloqueios,
          triangulo_vida: todosTriangulos.vida,
          triangulo_pessoal: todosTriangulos.pessoal,
          triangulo_social: todosTriangulos.social,
          triangulo_destino: todosTriangulos.destino,
          licoes_carmicas: licoesCarmicas,
          tendencias_ocultas: tendenciasOcultas,
          debitos_carmicos: debitosCarmicos,
          frequencias_numeros: {
            frequencias,
            ranking: {
              melhorNome: { nomeCompleto: lead.nome_completo },
              dataNascimento: lead.data_nascimento,
            },
          },
          ...scoreFields,
          is_free: true,
          status: 'complete',
          completed_at: new Date().toISOString(),
        })
        .select()
        .single();

      if (!analysisError && newAnalysis) {
        freeAnalysis = newAnalysis;
        freeAnalysisId = newAnalysis.id;
      } else if (analysisError) {
        console.error('[index.astro] Erro ao criar análise gratuita:', analysisError.message);
      }

      // Salva dados no profiles
      await supabase.from('profiles').update({
        birth_name: lead.nome_completo,
        birth_date: lead.data_nascimento,
        updated_at: new Date().toISOString(),
      }).eq('id', user.id);
    } else {
      // Se não há lead e não há análise, mostra o modal de onboarding
      showOnboardingModal = true;
    }
  } catch (e) {
    console.error('[index.astro] Erro ao sincronizar lead gratuito:', e);
    showOnboardingModal = true;
  }
}

// Admin: acesso total sem verificar subscriptions.
// Nome de Bebê e Nome Empresarial não são mais vendidos; assinaturas antigas ainda ativas
// só evitam o aviso de "acesso expirado" e continuam vendo as análises em /app/analises.
const [hasNomeSocial, hasLegacyAccess] = isAdmin
  ? [true, false]
  : await Promise.all([
      hasActiveSubscription(user.id, 'nome_social'),
      Promise.all([
        hasActiveSubscription(user.id, 'nome_bebe'),
        hasActiveSubscription(user.id, 'nome_empresa'),
      ]).then(([bebe, empresa]) => bebe || empresa),
    ]);

const hasAnyAccess = hasNomeSocial || hasLegacyAccess;

try {
  const { data: foundBestSocial } = await _client
    .from('analyses')
    .select('id, nome_completo, data_nascimento, score, score_v3, score_version, bloqueios, status, frequencias_numeros, created_at')
    .eq('user_id', user.id)
    .eq('product_type', 'nome_social')
    .eq('status', 'complete')
    .order('score', { ascending: false, nullsFirst: false })
    .order('created_at', { ascending: false })
    .limit(1)
    .maybeSingle();
  bestSocialAnalysis = foundBestSocial;
} catch {}

// Detectar análises legadas que qualificam para o recálculo grátis v3
let legacyAnalysesToRecalculate: any[] = [];
try {
  const { data: userAnalyses } = await _client
    .from('analyses')
    .select('id, nome_completo, score, score_version, product_type, is_free, parent_analysis_id, recalculated_from_version, created_at')
    .eq('user_id', user.id)
    .eq('status', 'complete')
    .order('created_at', { ascending: false });

  if (userAnalyses && userAnalyses.length > 0) {
    const recalculatedParentIds = new Set(
      userAnalyses
        .filter(a => a.parent_analysis_id && a.score_version === 'v3')
        .map(a => a.parent_analysis_id)
    );
    // Qualificam apenas análises salvas do motor antigo (v1) que o usuário realizou
    // (produtos nome_social, nome_bebe, nome_empresa) — diagnósticos gratuitos de nascimento
    // não devem exibir banner de atualização de motor antigo.
    legacyAnalysesToRecalculate = userAnalyses.filter(
      a => a.product_type !== 'analise_gratuita' &&
           !a.is_free &&
           (!a.score_version || a.score_version === 'v1') &&
           !a.parent_analysis_id &&
           !a.recalculated_from_version &&
           !recalculatedParentIds.has(a.id)
    );
  }
} catch (e) {
  console.warn('[index.astro] Erro ao buscar análises legadas para recálculo:', e);
}

const legacyCount = legacyAnalysesToRecalculate.length;
const singleLegacyAnalysis = legacyCount === 1 ? legacyAnalysesToRecalculate[0] : null;

// Detectar estado expirado (já comprou antes, mas nenhuma ativa)
const isExpired = !isAdmin && !hasAnyAccess && await hasAnySubscription(user.id);

let nomeSocialEndsAt: string | null = null;
if (hasNomeSocial && !isAdmin) {
  const activeSocial = await getActiveSubscription(user.id, 'nome_social');
  nomeSocialEndsAt = activeSocial?.ends_at
    ?? (profileData?.is_test ? profileData.test_ends_at ?? null : null);
}

function formatAccessDate(iso: string | null) {
  if (!iso) return null;
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return null;
  return new Intl.DateTimeFormat('pt-BR', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
    timeZone: 'America/Sao_Paulo',
  }).format(date);
}

const accessEndLabel = formatAccessDate(nomeSocialEndsAt);
const nomeSocialCheckoutClass = 'inline-flex items-center justify-center rounded-full bg-[#D4AF37] px-5 py-2.5 text-sm font-bold text-[#131313] transition hover:bg-[#f2ca50]';

const PRICE_UNAVAILABLE: PriceInfo = { cents: 0, formatted: 'Indisponível', hasDiscount: false };
const { prices, promotion } = await getPricesAndPromo().catch(() => ({ prices: {}, promotion: null }));
const priceMap = prices as Record<string, PriceInfo>;

function getScoreTheme(scoreValue: number | null | undefined, scoreVersion?: string | null) {
  const score = Math.max(0, Math.min(100, scoreValue ?? 0));
  if (scoreVersion === 'v3') {
    const nivel = obterNivelV3(score);
    if (nivel.codigo === 'N5') {
      return {
        label: `${nivel.codigo} · ${nivel.rotulo}`,
        color: '#34d399',
        border: 'rgba(16,185,129,0.34)',
        bg: 'rgba(16,185,129,0.06)',
        shadow: '0 0 42px rgba(16,185,129,0.12)',
        pillBg: 'rgba(16,185,129,0.12)',
        pillColor: '#6ee7b7',
        isV3: true,
      };
    }
    if (nivel.codigo === 'N4') {
      return {
        label: `${nivel.codigo} · ${nivel.rotulo}`,
        color: '#a3e635',
        border: 'rgba(132,204,22,0.30)',
        bg: 'rgba(132,204,22,0.05)',
        shadow: '0 0 42px rgba(132,204,22,0.10)',
        pillBg: 'rgba(132,204,22,0.10)',
        pillColor: '#bef264',
        isV3: true,
      };
    }
    if (nivel.codigo === 'N3') {
      return {
        label: `${nivel.codigo} · ${nivel.rotulo}`,
        color: '#facc15',
        border: 'rgba(234,179,8,0.36)',
        bg: 'rgba(234,179,8,0.07)',
        shadow: '0 0 42px rgba(234,179,8,0.12)',
        pillBg: 'rgba(234,179,8,0.13)',
        pillColor: '#fef08a',
        isV3: true,
      };
    }
    if (nivel.codigo === 'N2') {
      return {
        label: `${nivel.codigo} · ${nivel.rotulo}`,
        color: '#f97316',
        border: 'rgba(249,115,22,0.38)',
        bg: 'rgba(249,115,22,0.07)',
        shadow: '0 0 42px rgba(249,115,22,0.14)',
        pillBg: 'rgba(249,115,22,0.14)',
        pillColor: '#ffedd5',
        isV3: true,
      };
    }
    return {
      label: `${nivel.codigo} · ${nivel.rotulo}`,
      color: '#ef4444',
      border: 'rgba(239,68,68,0.38)',
      bg: 'rgba(239,68,68,0.07)',
      shadow: '0 0 42px rgba(239,68,68,0.14)',
      pillBg: 'rgba(239,68,68,0.14)',
      pillColor: '#fca5a5',
      isV3: true,
    };
  }

  // Retrocompatibilidade v1 / sem score_version
  if (score >= 90) {
    return {
      label: 'Excelente',
      color: '#34d399',
      border: 'rgba(16,185,129,0.34)',
      bg: 'rgba(16,185,129,0.06)',
      shadow: '0 0 42px rgba(16,185,129,0.12)',
      pillBg: 'rgba(16,185,129,0.12)',
      pillColor: '#6ee7b7',
      isV3: false,
    };
  }
  if (score >= 70) {
    return {
      label: 'Bom',
      color: '#a3e635',
      border: 'rgba(132,204,22,0.30)',
      bg: 'rgba(132,204,22,0.05)',
      shadow: '0 0 42px rgba(132,204,22,0.10)',
      pillBg: 'rgba(132,204,22,0.10)',
      pillColor: '#bef264',
      isV3: false,
    };
  }
  if (score >= 40) {
    return {
      label: 'Aceitável',
      color: '#facc15',
      border: 'rgba(234,179,8,0.36)',
      bg: 'rgba(234,179,8,0.07)',
      shadow: '0 0 42px rgba(234,179,8,0.12)',
      pillBg: 'rgba(234,179,8,0.13)',
      pillColor: '#fef08a',
      isV3: false,
    };
  }
  if (score >= 20) {
    return {
      label: 'Não recomendado',
      color: '#f97316',
      border: 'rgba(249,115,22,0.38)',
      bg: 'rgba(249,115,22,0.07)',
      shadow: '0 0 42px rgba(249,115,22,0.14)',
      pillBg: 'rgba(249,115,22,0.14)',
      pillColor: '#ffedd5',
      isV3: false,
    };
  }
  return {
    label: 'Crítico',
    color: '#ef4444',
    border: 'rgba(239,68,68,0.38)',
    bg: 'rgba(239,68,68,0.07)',
    shadow: '0 0 42px rgba(239,68,68,0.14)',
    pillBg: 'rgba(239,68,68,0.14)',
    pillColor: '#fca5a5',
    isV3: false,
  };
}

const featuredAnalysis = bestSocialAnalysis ?? freeAnalysis;
const featuredAnalysisId = featuredAnalysis?.id ?? null;
const featuredIsSocial = !!bestSocialAnalysis;
let featuredIsV3 = featuredAnalysis?.score_version === 'v3';
let featuredScoreRaw = featuredIsV3 ? (featuredAnalysis?.score_v3 ?? featuredAnalysis?.score) : featuredAnalysis?.score;
let featuredVersion = featuredAnalysis?.score_version;
const featuredBlockCount = featuredAnalysis?.bloqueios?.length ?? 0;

if (getScoreVersion() === 'v3') {
  if (featuredIsV3 && featuredAnalysis?.score_v3 != null) {
    featuredScoreRaw = featuredAnalysis.score_v3;
  } else if (featuredAnalysis?.nome_completo) {
    const rawBirth = featuredAnalysis.data_nascimento || profileData?.birth_date;
    if (rawBirth) {
      const parts = String(rawBirth).split('-');
      const dataPt = parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : String(rawBirth);
      const targetName = (featuredIsSocial && featuredAnalysis?.frequencias_numeros?.ranking?.melhorNome?.nomeCompleto)
        ? featuredAnalysis.frequencias_numeros.ranking.melhorNome.nomeCompleto
        : featuredAnalysis.nome_completo;
      try {
        const v3Eval = avaliarNome(targetName, dataPt);
        featuredScoreRaw = v3Eval.score_v3;
        featuredIsV3 = true;
        featuredVersion = 'v3';
      } catch (e) {
        console.warn('[index.astro] Erro ao calcular score v3 dinâmico no featured:', e);
      }
    }
  }
}

const featuredTheme = getScoreTheme(featuredScoreRaw, featuredVersion);
const featuredName =
  bestSocialAnalysis?.frequencias_numeros?.ranking?.melhorNome?.nomeCompleto
    ?? bestSocialAnalysis?.nome_completo
    ?? freeAnalysis?.nome_completo
    ?? '';
const socialPrice = priceMap.nome_social;
const socialPriceLabel = socialPrice && socialPrice.cents > 0
  ? (socialPrice.hasDiscount && socialPrice.discountedFormatted ? socialPrice.discountedFormatted : socialPrice.formatted)
  : null;

---

<AppLayout title="Dashboard">
  {needsEmailConfirmation && user.email && (
    <MailWarning client:load email={user.email} />
  )}

  <div class="space-y-8 max-w-[1440px] mx-auto w-full">

    <!-- Banner: Pagamento confirmado -->
    {showCheckoutSuccess && (
      <div
        id="checkout-success-banner"
        class="relative bg-gradient-to-r from-[#D4AF37]/15 to-[#D4AF37]/8 rounded-2xl p-5 flex items-start justify-between gap-4 overflow-hidden"
      >
        <div class="absolute inset-0 bg-gradient-to-b from-[#D4AF37]/5 to-transparent pointer-events-none rounded-2xl"></div>
        <div class="relative flex items-start gap-3 flex-1">
          <span class="text-2xl flex-shrink-0 mt-0.5">ðŸŽ‰</span>
          <div>
            <h3 class="font-cinzel text-base font-bold text-[#D4AF37] mb-0.5">Pagamento confirmado!</h3>
            <p class="text-[#e5e2e1] text-sm leading-relaxed">
              Bem-vindo ao Nome Magnético. Seu acesso ao Nome Social está liberado. Você já pode harmonizar seu nome.
            </p>
          </div>
        </div>
        <button
          id="dismiss-success-banner"
          class="relative text-gray-500 hover:text-white transition-colors flex-shrink-0 mt-0.5"
          aria-label="Fechar"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    )}
    {showCheckoutSuccess && (
      <script define:vars={{ _checkoutProduct: checkoutProduct }}>
        (function () {
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'purchase_complete', _checkoutProduct ? { produto: _checkoutProduct } : undefined);
          }
          var banner = document.getElementById('checkout-success-banner');
          var dismissBtn = document.getElementById('dismiss-success-banner');
          function dismissBanner() {
            if (banner) {
              banner.style.transition = 'opacity 0.4s ease, max-height 0.5s ease, padding 0.5s ease, margin 0.5s ease';
              banner.style.opacity = '0';
              banner.style.maxHeight = '0';
              banner.style.padding = '0';
              banner.style.margin = '0';
              setTimeout(function () { if (banner && banner.parentNode) banner.parentNode.removeChild(banner); }, 500);
            }
            if (window.history && window.history.replaceState) {
              var url = new URL(window.location.href);
              url.searchParams.delete('checkout');
              url.searchParams.delete('produto');
              window.history.replaceState({}, '', url.toString());
            }
          }
          if (dismissBtn) dismissBtn.addEventListener('click', dismissBanner);
          setTimeout(dismissBanner, 8000);
        })();
      </script>
    )}

    <!-- Banner: Melhoria do Motor v3 e Recálculo Gratuito -->
    {legacyCount > 0 && (
      <div
        id="recalc-v3-banner"
        class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-[#D4AF37]/15 via-purple-500/10 to-[#D4AF37]/10 border border-[#D4AF37]/30 p-5 md:p-6 shadow-2xl shadow-black/40"
      >
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-5">
          <div class="space-y-1.5 flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#D4AF37]/20 text-[#D4AF37] border border-[#D4AF37]/40 tracking-wider uppercase">
                ✦ Novo Motor v3
              </span>
              <span class="text-xs text-gray-400">Atualização Disponível</span>
            </div>
            <h3 class="font-cinzel text-lg md:text-xl font-bold text-[#e5e2e1]">
              Melhoramos o cálculo do seu score numerológico
            </h3>
            <p class="text-gray-300 text-xs sm:text-sm leading-relaxed max-w-2xl">
              {legacyCount === 1 ? (
                <>
                  Sua análise de <strong class="text-white">{singleLegacyAnalysis.nome_completo}</strong> foi calculada com o motor anterior. O motor v3 traz critérios mais precisos para bloqueios e débitos kármicos. Você pode gerar a nova versão gratuitamente preservando a original.
                </>
              ) : (
                <>
                  Você possui <strong class="text-white">{legacyCount} análises</strong> calculadas com a versão anterior do motor. O motor v3 traz critérios aprimorados para bloqueios e débitos kármicos. Você pode recalcular todas gratuitamente preservando os históricos originais.
                </>
              )}
            </p>
          </div>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full md:w-auto shrink-0">
            <a
              href="/como-funciona-o-score"
              class="text-xs text-center text-gray-400 hover:text-[#D4AF37] underline decoration-dotted underline-offset-4 py-2 px-3 transition-colors"
            >
              Entenda as mudanças
            </a>
            <button
              id="btn-recalc-v3"
              type="button"
              data-analysis-ids={JSON.stringify(legacyAnalysesToRecalculate.map(a => a.id))}
              data-is-multiple={legacyCount > 1 ? 'true' : 'false'}
              class="inline-flex items-center justify-center gap-2 rounded-full bg-[#D4AF37] px-6 py-3 text-xs sm:text-sm font-bold text-[#131313] transition hover:bg-[#f2ca50] hover:scale-[1.02] active:scale-[0.98] cursor-pointer shadow-lg shadow-yellow-500/15"
            >
              <span id="btn-recalc-spinner" class="hidden w-4 h-4 border-2 border-black/40 border-t-black rounded-full animate-spin"></span>
              <span id="btn-recalc-text">
                {legacyCount === 1
                  ? 'Recalcular análise com motor v3 (grátis)'
                  : `Recalcular ${legacyCount} análises com motor v3 (grátis)`}
              </span>
            </button>
          </div>
        </div>
      </div>
    )}

    {legacyCount > 0 && (
      <script>
        (function () {
          const btn = document.getElementById('btn-recalc-v3') as HTMLButtonElement | null;
          const spinner = document.getElementById('btn-recalc-spinner');
          const text = document.getElementById('btn-recalc-text');
          const banner = document.getElementById('recalc-v3-banner');

          if (!btn) return;

          const rawIds = btn.dataset.analysisIds;
          let analysisIds: string[] = [];
          try {
            analysisIds = rawIds ? JSON.parse(rawIds) : [];
          } catch {
            analysisIds = [];
          }
          const isMultiple = btn.dataset.isMultiple === 'true';

          btn.addEventListener('click', async () => {
            if (!analysisIds.length) return;

            btn.disabled = true;
            if (spinner) spinner.classList.remove('hidden');
            if (text) text.textContent = isMultiple ? 'Recalculando análises...' : 'Recalculando análise...';

            try {
              const res = await fetch('/api/recalculate-v3', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(isMultiple ? { analysisIds } : { analysisId: analysisIds[0] }),
              });
              const data = await res.json();
              if (res.ok) {
                if (text) text.textContent = 'Sucesso! Atualizando...';
                if (!isMultiple && data.analysisId) {
                  window.location.href = `/app/resultado/${data.analysisId}`;
                } else {
                  window.location.reload();
                }
              } else {
                throw new Error(data.error || 'Erro ao recalcular');
              }
            } catch (err) {
              alert(err instanceof Error ? err.message : 'Falha ao recalcular análise.');
              btn.disabled = false;
              if (spinner) spinner.classList.add('hidden');
              if (text) {
                text.textContent = isMultiple
                  ? `Recalcular ${analysisIds.length} análises com motor v3 (grátis)`
                  : 'Recalcular análise com motor v3 (grátis)';
              }
            }
          });
        })();
      </script>
    )}

    <!-- Banner: Expirado -->
    {isExpired && (
      <div class="bg-red-500/10 border border-red-500/30 rounded-2xl p-6 flex flex-col md:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="font-cinzel text-lg font-bold text-red-400 mb-1">
            Seu acesso expirou
          </h3>
          <p class="text-gray-400 text-sm">Renove para continuar realizando análises numerológicas completas.</p>
        </div>
        <a
          href="/comprar"
          class="flex-shrink-0 bg-[#D4AF37] text-[#1A1A1A] font-medium px-6 py-2.5 rounded-full hover:bg-[#f2ca50] transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
        >
          Renovar Acesso
        </a>
      </div>
    )}

    <!-- Banner: Novo usuário (nunca comprou) -->
    {false && !isAdmin && !hasAnyAccess && !isExpired && (
      <div class="bg-[#D4AF37]/10 border border-[#D4AF37]/30 rounded-2xl p-6 flex flex-col md:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="font-cinzel text-lg font-bold text-[#D4AF37] mb-1">
            Comece sua jornada numerológica
          </h3>
          <p class="text-gray-400 text-sm">Adquira um dos produtos para realizar sua análise cabalística completa.</p>
        </div>
        <a
          href="/comprar"
          class="flex-shrink-0 bg-[#D4AF37] text-[#1A1A1A] font-medium px-6 py-2.5 rounded-full hover:bg-[#f2ca50] transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
        >
          Ver Todos os Produtos
        </a>
      </div>
    )}

    {(freeAnalysisStatus === 'pending' || freeAnalysisStatus === 'processing') && (
      <section
        class="rounded-3xl border bg-white/[0.03] p-6 md:p-8 text-center flex flex-col items-center justify-center min-h-[220px]"
        style="border-color: rgba(212,175,55,0.22); box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), 0 20px 50px rgba(0,0,0,0.6);"
      >
        <div class="relative flex items-center justify-center w-16 h-16 mb-4">
          <div class="absolute inset-0 rounded-full bg-[#D4AF37]/10 animate-ping pointer-events-none"></div>
          <svg class="h-10 w-10 animate-spin text-[#D4AF37] relative z-10" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" />
            <path class="opacity-80" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z" />
          </svg>
        </div>
        <h3 class="font-cinzel text-xl font-bold text-[#D4AF37] mb-2 tracking-wide">
          Analisando seu Nome de Nascimento...
        </h3>
        <p class="text-sm text-gray-400 max-w-md mx-auto leading-relaxed font-light">
          Nossos algoritmos cabalísticos estão processando sua frequência original de nascimento e decodificando seus bloqueios energéticos. Isso levará apenas alguns segundos.
        </p>

        <script is:inline define:vars={{ analysisId: freeAnalysisId }}>
          (function() {
            function checkStatus() {
              fetch('/api/analysis-status?id=' + analysisId)
                .then(function(res) { return res.json(); })
                .then(function(data) {
                  if (data.status === 'complete' || data.status === 'error') {
                    window.location.reload();
                  } else {
                    setTimeout(checkStatus, 2000);
                  }
                })
                .catch(function() {
                  setTimeout(checkStatus, 3000);
                });
            }
            if (analysisId) {
              setTimeout(checkStatus, 1500);
            }
          })();
        </script>
      </section>
    )}

    {featuredAnalysis && (
      <section
        class="rounded-3xl border bg-white/[0.03] p-5 md:p-7"
        style={`border-color:${featuredTheme.border}; box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), ${featuredTheme.shadow};`}
      >
        <div class="grid gap-6 md:grid-cols-[1.2fr_0.8fr] md:items-center">
          <div class="order-2 md:order-1">
            <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.22em] text-[#D4AF37]">
              {featuredIsSocial ? 'Melhor harmonização do Nome Social' : 'Análise gratuita de nascimento'}
            </p>
            <h2 class="font-cinzel text-2xl font-bold leading-tight text-[#e5e2e1] md:text-3xl">
              {featuredName}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-gray-500">
              {featuredIsSocial
                ? 'Este é o melhor resultado salvo nas suas harmonizações. Acesse o relatório completo, baixe a análise gratuita ou gere uma nova análise do Nome Social.'
                : hasNomeSocial
                  ? 'Seu diagnóstico inicial está salvo. Baixe novamente o PDF ou avance para harmonizar seu nome.'
                  : 'Seu diagnóstico gratuito está salvo. O próximo passo é o Nome Social: a partir do seu nome de nascimento, você gera a assinatura harmonizada, com ranking de score 0–100 e acesso imediato após o pagamento.'}
            </p>
            {!featuredIsSocial && !hasNomeSocial && socialPriceLabel && (
              <p class="mt-2 text-xs font-medium text-[#D4AF37]">
                Nome Social · {socialPriceLabel} · pagamento único
              </p>
            )}
            <div class="mt-5 flex flex-col gap-3 sm:flex-row">
              {featuredIsSocial ? (
                <>
                  <a
                    href={`/app/resultado/${featuredAnalysisId}`}
                    class="inline-flex items-center justify-center rounded-full border border-[#D4AF37]/35 bg-[#D4AF37]/10 px-5 py-2.5 text-sm font-bold text-[#D4AF37] transition hover:bg-[#D4AF37]/15"
                  >
                    Ver Harmonização
                  </a>
                  <FreePDFAutoGenerator
                    client:load
                    existingAnalysisId={freeAnalysisId}
                    autoRun={false}
                  />
                  <a
                    href="/app/analise/nome-social"
                    class="inline-flex items-center justify-center rounded-full bg-[#D4AF37] px-5 py-2.5 text-sm font-bold text-[#131313] transition hover:bg-[#f2ca50]"
                  >
                    Nova harmonização
                  </a>
                </>
              ) : (
                <>
                  <FreePDFAutoGenerator
                    client:load
                    existingAnalysisId={freeAnalysisId}
                    autoRun={false}
                  />
                  {hasNomeSocial ? (
                    <a
                      href="/app/analise/nome-social"
                      class="inline-flex items-center justify-center rounded-full bg-[#D4AF37] px-5 py-2.5 text-sm font-bold text-[#131313] transition hover:bg-[#f2ca50]"
                    >
                      Harmonizar meu Nome
                    </a>
                  ) : (
                    <DashboardCheckoutButton
                      client:load
                      product="nome_social"
                      priceInfo={priceMap.nome_social ?? PRICE_UNAVAILABLE}
                      promotion={promotion}
                      label="Harmonizar meu Nome"
                      className="inline-flex items-center justify-center rounded-full bg-[#D4AF37] px-5 py-2.5 text-sm font-bold text-[#131313] transition hover:bg-[#f2ca50]"
                    />
                  )}
                </>
              )}
            </div>
          </div>

          {(() => {
            const theme = featuredTheme;
            const scoreVal = Math.max(0, Math.min(100, featuredScoreRaw ?? 0));
            // Circunferência de raio 44 é 2 * PI * 44 = 276.46
            const circumference = 276.46;
            const strokeDashoffset = circumference * (1 - scoreVal / 100);
            return (
              <div class="relative flex flex-col items-center justify-center mx-auto order-1 md:order-2">
                <div class="relative flex items-center justify-center w-52 h-52 sm:w-60 sm:h-60 md:w-64 md:h-64">
                  <!-- SVG de Progresso Circular -->
                  <svg class="absolute inset-0 w-full h-full transform -rotate-90 pointer-events-none" viewBox="0 0 100 100">
                    <!-- Círculo de Fundo -->
                    <circle
                      cx="50"
                      cy="50"
                      r="44"
                      fill="transparent"
                      stroke="rgba(255,255,255,0.04)"
                      stroke-width="4.5"
                    />
                    <!-- Círculo de Progresso -->
                    <circle
                      cx="50"
                      cy="50"
                      r="44"
                      fill="transparent"
                      stroke={theme.color}
                      stroke-width="4.5"
                      stroke-dasharray={circumference}
                      stroke-dashoffset={strokeDashoffset}
                      stroke-linecap="round"
                      style="transition: stroke-dashoffset 1.2s cubic-bezier(0.4, 0, 0.2, 1), stroke 0.4s ease;"
                    />
                  </svg>

                  <!-- Conteúdo Interno com padding e centralização estrita -->
                  <div
                    class="flex flex-col items-center justify-center rounded-full w-[82%] h-[82%] p-3 sm:p-4 text-center overflow-hidden bg-[#111111]"
                    style={`background:radial-gradient(circle at 50% 30%, ${theme.bg}, #111111 62%); box-shadow:${theme.shadow};`}
                  >
                    <span class="font-cinzel text-5xl sm:text-6xl font-bold leading-none tracking-tight" style={`color:${theme.color};`}>
                      {scoreVal}
                    </span>
                    <span class="mt-1 text-[9px] sm:text-[10px] font-bold uppercase tracking-[0.18em] text-gray-500 leading-tight">
                      {featuredIsSocial ? 'Melhor score' : 'Score atual'}
                    </span>

                    <div class="mt-2 sm:mt-2.5 flex flex-col items-center justify-center w-full max-w-[88%] gap-1">
                      <span
                        class="inline-block rounded-full px-2.5 py-0.5 text-[9px] sm:text-[10px] font-bold uppercase tracking-wider text-center leading-tight max-w-full truncate"
                        style={`background-color:${theme.pillBg}; color:${theme.pillColor};`}
                        title={theme.label}
                      >
                        {theme.label}
                      </span>
                      <span class="text-[9px] sm:text-[10px] font-semibold text-gray-400 uppercase tracking-wider leading-tight text-center">
                        {featuredBlockCount} {featuredBlockCount === 1 ? 'bloqueio' : 'bloqueios'}
                      </span>
                    </div>
                  </div>
                </div>

                {featuredIsV3 && (
                  <div class="mt-3.5 flex items-center gap-2">
                    <span class="rounded-full bg-[#D4AF37]/10 border border-[#D4AF37]/30 px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-wider text-[#D4AF37]">
                      Motor v3
                    </span>
                    <a
                      href="/como-funciona-o-score"
                      class="text-[11px] text-gray-400 hover:text-[#D4AF37] transition-colors underline underline-offset-2"
                    >
                      Como calculamos?
                    </a>
                  </div>
                )}
              </div>
            );
          })()}
        </div>
      </section>
    )}

    {!freeAnalysisId && leadNome && leadData && (
      <div>
        <FreePDFAutoGenerator
          client:load
          existingAnalysisId={null}
          leadNome={leadNome}
          leadData={leadData}
          autoRun={true}
        />
      </div>
    )}

    <section
      class="rounded-3xl bg-white/[0.03] p-6 md:p-8"
      style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.035), 0 18px 55px rgba(0,0,0,0.28);"
    >
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="min-w-0">
          <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.22em] text-[#D4AF37]">Nome Social</p>
          <h2 class="font-cinzel text-2xl font-bold text-[#e5e2e1]">Harmonização do nome</h2>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-gray-400">
            Harmonize sua assinatura e veja qual variação do nome flui melhor com a sua Expressão e o seu Destino.
          </p>
          <p class="mt-4 text-sm text-[#e5e2e1]">
            {isAdmin
              ? 'Acesso de administrador.'
              : hasNomeSocial
                ? (accessEndLabel ? `Acesso ativo até ${accessEndLabel}.` : 'Acesso ativo.')
                : isExpired
                  ? 'Seu acesso ao Nome Social expirou.'
                  : 'Você ainda não tem acesso ao Nome Social.'}
          </p>
        </div>
        <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center">
          <span class:list={[
            'rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-[0.14em]',
            isAdmin
              ? 'bg-[#bea5ff]/15 text-[#d7c6ff]'
              : hasNomeSocial
                ? 'bg-emerald-500/12 text-emerald-300'
                : isExpired
                  ? 'bg-red-500/12 text-red-300'
                  : 'bg-white/[0.06] text-gray-400'
          ]}>
            {isAdmin ? 'Admin' : hasNomeSocial ? 'Ativo' : isExpired ? 'Expirado' : 'Disponível'}
          </span>
          {hasNomeSocial ? (
            <a href="/app/analise/nome-social" class={nomeSocialCheckoutClass}>
              Iniciar harmonização
            </a>
          ) : (
            <DashboardCheckoutButton
              client:load
              product="nome_social"
              priceInfo={socialPrice ?? PRICE_UNAVAILABLE}
              promotion={promotion}
              label={isExpired ? 'Renovar' : 'Adquirir'}
              className={nomeSocialCheckoutClass}
            />
          )}
        </div>
      </div>
    </section>

    {isAdmin && (
      <a
        href="/app/admin-analise"
        class="block rounded-3xl bg-[#bea5ff]/[0.06] p-6 transition hover:bg-[#bea5ff]/10"
        style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 18px 55px rgba(0,0,0,0.28);"
      >
        <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.22em] text-[#d7c6ff]">Exclusivo admin</p>
        <h2 class="font-cinzel text-xl font-bold text-[#e5e2e1]">Área do Analista</h2>
        <p class="mt-2 text-sm text-gray-400">Crie análises personalizadas em tempo real e emita PDFs na hora.</p>
      </a>
    )}

  </div>
  
  {showFreeUsedModal && <FreeUsedModal client:only="react" />}
  {showOnboardingModal && <InitialAnalysisModal client:only="react" />}


  <script define:vars={{ isAdmin }}>
    (function () {
      try {
        if (isAdmin) {
          localStorage.setItem('nm-user-role', 'admin');
        } else {
          localStorage.removeItem('nm-user-role');
        }
      } catch (e) {}
    })();
  </script>
</AppLayout>
