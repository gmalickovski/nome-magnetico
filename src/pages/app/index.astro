---
import { resolveRadarContext, readContextualRadarSnapshot } from '../../shared/interactive-engine/radar-context';
import { getArquetipo } from '../../backend/numerology/archetypes';
import AppLayout from '../../layouts/AppLayout.astro';
import { getActiveSubscription, hasActiveSubscription, hasAnySubscription, getRefundableSubscriptions } from '../../backend/db/subscriptions';
import { createUserClient, supabase } from '../../backend/db/supabase';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');

// Desabilitar cache para o botÃ£o voltar do navegador nÃ£o repuxar dados velhos
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

import FreeUsedModal from '../../frontend/components/app/FreeUsedModal';
import { FreePDFAutoGenerator } from '../../frontend/components/app/FreePDFAutoGenerator';
import { MailWarning } from '../../frontend/components/app/MailWarning';
import { getPricesAndPromo, type PriceInfo } from '../../backend/payments/prices';
import AppDashboard, { type DashboardHeroSlide } from '../../frontend/components/app/dashboard/AppDashboard';
import type { ChecklistKey } from '../../frontend/lib/app-dashboard-checklist';
import type { RadarAxesData } from '../../frontend/components/app/chat/chat-types';
import {
  computeContextualRadarAxes,
  getRadarAxisLabels,
  motorRadarToRecord,
} from '../../shared/interactive-engine/motor-radar';

// Funções de numerologia locais para cálculo instantâneo da análise gratuita do lead
import { calcularTodosTriangulos, detectarBloqueios } from '../../backend/numerology/triangle';
import {
  calcularCincoNumeros,
  calcularExpressao,
  calcularDestino,
  calcularMotivacao,
  calcularImpressao,
  calcularMissao,
} from '../../backend/numerology/numbers';
import {
  detectarLicoesCarmicas,
  detectarTendenciasOcultas,
  mapearFrequencias,
  calcularDebitosCarmicos,
} from '../../backend/numerology/karmic';
import { avaliarCompatibilidade } from '../../backend/numerology/harmonization';
import {
  avaliarNome,
  calcularScoreV1SemOcorrenciasExtras,
  persistenciaScoreFields,
} from '../../backend/numerology/score';
import { getScoreVersion } from '../../backend/numerology/score-version';

// Verifica parÃ¢metros de URL
const showFreeUsedModal   = Astro.url.searchParams.get('free_used') === 'true';
const showCheckoutSuccess = Astro.url.searchParams.get('checkout') === 'success';
const checkoutProduct     = Astro.url.searchParams.get('produto') ?? null;
const resumeChat          = Astro.url.searchParams.get('resume') === '1';

if (showCheckoutSuccess && resumeChat && (checkoutProduct === null || checkoutProduct === 'nome_social')) {
  return Astro.redirect('/app/analise/nome-social?checkout=success&produto=nome_social&resume=1');
}

// Verificar admin e dados do perfil
let isAdmin     = false;
let profileData: any = null;
let freeAnalysisId: string | null = null;
let freeAnalysisStatus: string | null = null;
let freeAnalysis: any = null;
let bestSocialAnalysis: any = null;

const _client = createUserClient(Astro.locals.accessToken ?? '');

try {
  const { data: profile } = await _client
    .from('profiles').select('*').eq('id', user.id).single();
  isAdmin = profile?.role === 'admin';
  profileData = profile;
} catch {}

const refundable = isAdmin ? [] : await getRefundableSubscriptions(user.id);
const showRefundButton = refundable.length > 0;

const needsEmailConfirmation = !user.email_confirmed_at;

import { obterNivelV3 } from '../../shared/score-v3';

// Busca análise gratuita concluída ou em processamento
try {
  const { data: foundFreeAnalysis } = await _client
    .from('analyses')
    .select('id, nome_completo, data_nascimento, score, score_v3, score_version, bloqueios, status, product_type, is_free, licoes_carmicas, frequencias_numeros, numero_expressao, numero_destino, numero_motivacao, numero_missao, numero_impressao, created_at')
    .or('is_free.eq.true,product_type.eq.analise_gratuita')
    .eq('user_id', user.id)
    .order('created_at', { ascending: false })
    .limit(1)
    .maybeSingle();

  if (foundFreeAnalysis) {
    freeAnalysisStatus = foundFreeAnalysis.status;
    if (foundFreeAnalysis.status === 'complete') {
      freeAnalysis = foundFreeAnalysis;
      freeAnalysisId = foundFreeAnalysis.id;
    } else if (foundFreeAnalysis.status === 'pending' || foundFreeAnalysis.status === 'processing') {
      freeAnalysisId = foundFreeAnalysis.id;
    }
  }
} catch {}

// Sincronização automática de lead por e-mail para novas contas
let leadNome: string | null = null;
let leadData: string | null = null;
if (!freeAnalysisId && user.email) {
  try {
    const { data: lead } = await supabase
      .from('free_analyses_leads')
      .select('id, nome_completo, data_nascimento')
      .eq('email', user.email.toLowerCase().trim())
      .order('created_at', { ascending: false })
      .limit(1)
      .maybeSingle();

    if (lead) {
      leadNome = lead.nome_completo;
      const parts = lead.data_nascimento.split('-');
      const formattedBirthDate = parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : lead.data_nascimento;
      leadData = formattedBirthDate;

      // 1. Calcular a numerologia localmente (sem chamar IA)
      const todosTriangulos = calcularTodosTriangulos(lead.nome_completo, formattedBirthDate);
      const bloqueios = detectarBloqueios(todosTriangulos);
      const expressao = calcularExpressao(lead.nome_completo);
      const destino = calcularDestino(formattedBirthDate);
      const motivacao = calcularMotivacao(lead.nome_completo);
      const impressao = calcularImpressao(lead.nome_completo);
      const missao = calcularMissao(lead.nome_completo, formattedBirthDate);
      const licoesCarmicas = detectarLicoesCarmicas(lead.nome_completo);
      const tendenciasOcultas = detectarTendenciasOcultas(lead.nome_completo);
      const debitosCarmicos = calcularDebitosCarmicos(formattedBirthDate, destino, motivacao, expressao);
      const frequencias = mapearFrequencias(lead.nome_completo);
      const scoreLegado = calcularScoreV1SemOcorrenciasExtras({
        bloqueios,
        licoesCarmicas: licoesCarmicas.length,
        tendenciasOcultas: tendenciasOcultas.length,
        debitosCarmicos,
        compatibilidade: avaliarCompatibilidade(expressao, destino),
      });
      const scoreFields = persistenciaScoreFields({
        scoreLegado,
        nomeParaV3: lead.nome_completo,
        dataNascimento: formattedBirthDate,
      });

      // 2. Criar a análise no banco como concluída (complete)
      const { data: newAnalysis, error: analysisError } = await supabase
        .from('analyses')
        .insert({
          user_id: user.id,
          product_type: 'analise_gratuita',
          nome_completo: lead.nome_completo,
          data_nascimento: lead.data_nascimento,
          numero_expressao: expressao,
          numero_destino: destino,
          numero_motivacao: motivacao,
          numero_missao: missao,
          numero_impressao: impressao,
          numero_personalidade: impressao,
          arcano_regente: todosTriangulos.vida.arcanoRegente,
          bloqueios: bloqueios,
          triangulo_vida: todosTriangulos.vida,
          triangulo_pessoal: todosTriangulos.pessoal,
          triangulo_social: todosTriangulos.social,
          triangulo_destino: todosTriangulos.destino,
          licoes_carmicas: licoesCarmicas,
          tendencias_ocultas: tendenciasOcultas,
          debitos_carmicos: debitosCarmicos,
          frequencias_numeros: {
            frequencias,
            ranking: {
              melhorNome: { nomeCompleto: lead.nome_completo },
              dataNascimento: lead.data_nascimento,
            },
          },
          ...scoreFields,
          is_free: true,
          status: 'complete',
          completed_at: new Date().toISOString(),
        })
        .select()
        .single();

      if (!analysisError && newAnalysis) {
        freeAnalysis = newAnalysis;
        freeAnalysisId = newAnalysis.id;
      } else if (analysisError) {
        console.error('[index.astro] Erro ao criar análise gratuita:', analysisError.message);
      }

      // Salva dados no profiles
      await supabase.from('profiles').update({
        birth_name: lead.nome_completo,
        birth_date: lead.data_nascimento,
        updated_at: new Date().toISOString(),
      }).eq('id', user.id);
    }
  } catch (e) {
    console.error('[index.astro] Erro ao sincronizar lead gratuito:', e);
  }
}

// Admin: acesso total sem verificar subscriptions.
// Nome de Bebê e Nome Empresarial não são mais vendidos; assinaturas antigas ainda ativas
// só evitam o aviso de "acesso expirado" e continuam vendo as análises em /app/analises.
const [hasNomeSocial, hasLegacyAccess] = isAdmin
  ? [true, false]
  : await Promise.all([
      hasActiveSubscription(user.id, 'nome_social'),
      Promise.all([
        hasActiveSubscription(user.id, 'nome_bebe'),
        hasActiveSubscription(user.id, 'nome_empresa'),
      ]).then(([bebe, empresa]) => bebe || empresa),
    ]);

const hasAnyAccess = hasNomeSocial || hasLegacyAccess;

let allCompletedAnalyses: any[] = [];
let legacyAnalysesToRecalculate: any[] = [];
try {
  const { data: userAnalyses } = await _client
    .from('analyses')
    .select('id, nome_completo, data_nascimento, score, score_v3, score_version, bloqueios, product_type, is_free, frequencias_numeros, nome_harmonizado, numero_expressao, numero_destino, numero_motivacao, numero_missao, numero_impressao, licoes_carmicas, parent_analysis_id, recalculated_from_version, created_at, status')
    .eq('user_id', user.id)
    .eq('status', 'complete')
    .order('created_at', { ascending: false });

  allCompletedAnalyses = userAnalyses ?? [];

  const paidSocialCandidates = allCompletedAnalyses.filter(
    (a) => a.product_type === 'nome_social' && !a.is_free,
  );
  const favoritedSocial = paidSocialCandidates.find(
    (a) => Boolean((a.frequencias_numeros as Record<string, any> | null)?.is_favorite),
  );
  const favoritedAnyPaid = allCompletedAnalyses.find(
    (a) =>
      !a.is_free &&
      a.product_type !== 'analise_gratuita' &&
      Boolean((a.frequencias_numeros as Record<string, any> | null)?.is_favorite),
  );

  if (favoritedSocial) {
    bestSocialAnalysis = favoritedSocial;
  } else if (paidSocialCandidates.length > 0) {
    bestSocialAnalysis = [...paidSocialCandidates].sort(
      (a, b) => (b.score_v3 ?? b.score ?? 0) - (a.score_v3 ?? a.score ?? 0),
    )[0];
  } else if (favoritedAnyPaid) {
    bestSocialAnalysis = favoritedAnyPaid;
  }

  if (allCompletedAnalyses.length > 0) {
    const recalculatedParentIds = new Set(
      allCompletedAnalyses
        .filter(a => a.parent_analysis_id && a.score_version === 'v3')
        .map(a => a.parent_analysis_id)
    );
    // Qualificam apenas análises salvas do motor antigo (v1) que o usuário realizou
    // (produtos nome_social, nome_bebe, nome_empresa) — diagnósticos gratuitos de nascimento
    // não devem exibir banner de atualização de motor antigo.
    legacyAnalysesToRecalculate = allCompletedAnalyses.filter(
      a => a.product_type !== 'analise_gratuita' &&
           !a.is_free &&
           (!a.score_version || a.score_version === 'v1') &&
           !a.parent_analysis_id &&
           !a.recalculated_from_version &&
           !recalculatedParentIds.has(a.id)
    );
  }
} catch (e) {
  console.warn('[index.astro] Erro ao buscar análises concluídas:', e);
}

const legacyCount = legacyAnalysesToRecalculate.length;
const singleLegacyAnalysis = legacyCount === 1 ? legacyAnalysesToRecalculate[0] : null;

// Detectar estado expirado (já comprou antes, mas nenhuma ativa)
const isExpired = !isAdmin && !hasAnyAccess && await hasAnySubscription(user.id);

let nomeSocialEndsAt: string | null = null;
if (hasNomeSocial && !isAdmin) {
  const activeSocial = await getActiveSubscription(user.id, 'nome_social');
  nomeSocialEndsAt = activeSocial?.ends_at
    ?? (profileData?.is_test ? profileData.test_ends_at ?? null : null);
}

function formatAccessDate(iso: string | null) {
  if (!iso) return null;
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return null;
  return new Intl.DateTimeFormat('pt-BR', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
    timeZone: 'America/Sao_Paulo',
  }).format(date);
}

const accessEndLabel = formatAccessDate(nomeSocialEndsAt);
const PRICE_UNAVAILABLE: PriceInfo = { cents: 0, formatted: 'Indisponível', hasDiscount: false };
const { prices, promotion } = await getPricesAndPromo().catch(() => ({ prices: {}, promotion: null }));
const priceMap = prices as Record<string, PriceInfo>;

function getScoreTheme(scoreValue: number | null | undefined, scoreVersion?: string | null) {
  const score = Math.max(0, Math.min(100, scoreValue ?? 0));
  if (scoreVersion === 'v3') {
    const nivel = obterNivelV3(score);
    if (nivel.codigo === 'N5') {
      return {
        label: `${nivel.codigo} · ${nivel.rotulo}`,
        color: '#34d399',
        border: 'rgba(16,185,129,0.34)',
        bg: 'rgba(16,185,129,0.06)',
        shadow: '0 0 42px rgba(16,185,129,0.12)',
        pillBg: 'rgba(16,185,129,0.12)',
        pillColor: '#6ee7b7',
        isV3: true,
      };
    }
    if (nivel.codigo === 'N4') {
      return {
        label: `${nivel.codigo} · ${nivel.rotulo}`,
        color: '#a3e635',
        border: 'rgba(132,204,22,0.30)',
        bg: 'rgba(132,204,22,0.05)',
        shadow: '0 0 42px rgba(132,204,22,0.10)',
        pillBg: 'rgba(132,204,22,0.10)',
        pillColor: '#bef264',
        isV3: true,
      };
    }
    if (nivel.codigo === 'N3') {
      return {
        label: `${nivel.codigo} · ${nivel.rotulo}`,
        color: '#facc15',
        border: 'rgba(234,179,8,0.36)',
        bg: 'rgba(234,179,8,0.07)',
        shadow: '0 0 42px rgba(234,179,8,0.12)',
        pillBg: 'rgba(234,179,8,0.13)',
        pillColor: '#fef08a',
        isV3: true,
      };
    }
    if (nivel.codigo === 'N2') {
      return {
        label: `${nivel.codigo} · ${nivel.rotulo}`,
        color: '#f97316',
        border: 'rgba(249,115,22,0.38)',
        bg: 'rgba(249,115,22,0.07)',
        shadow: '0 0 42px rgba(249,115,22,0.14)',
        pillBg: 'rgba(249,115,22,0.14)',
        pillColor: '#ffedd5',
        isV3: true,
      };
    }
    return {
      label: `${nivel.codigo} · ${nivel.rotulo}`,
      color: '#ef4444',
      border: 'rgba(239,68,68,0.38)',
      bg: 'rgba(239,68,68,0.07)',
      shadow: '0 0 42px rgba(239,68,68,0.14)',
      pillBg: 'rgba(239,68,68,0.14)',
      pillColor: '#fca5a5',
      isV3: true,
    };
  }

  // Retrocompatibilidade v1 / sem score_version
  if (score >= 90) {
    return {
      label: 'Excelente',
      color: '#34d399',
      border: 'rgba(16,185,129,0.34)',
      bg: 'rgba(16,185,129,0.06)',
      shadow: '0 0 42px rgba(16,185,129,0.12)',
      pillBg: 'rgba(16,185,129,0.12)',
      pillColor: '#6ee7b7',
      isV3: false,
    };
  }
  if (score >= 70) {
    return {
      label: 'Bom',
      color: '#a3e635',
      border: 'rgba(132,204,22,0.30)',
      bg: 'rgba(132,204,22,0.05)',
      shadow: '0 0 42px rgba(132,204,22,0.10)',
      pillBg: 'rgba(132,204,22,0.10)',
      pillColor: '#bef264',
      isV3: false,
    };
  }
  if (score >= 40) {
    return {
      label: 'Aceitável',
      color: '#facc15',
      border: 'rgba(234,179,8,0.36)',
      bg: 'rgba(234,179,8,0.07)',
      shadow: '0 0 42px rgba(234,179,8,0.12)',
      pillBg: 'rgba(234,179,8,0.13)',
      pillColor: '#fef08a',
      isV3: false,
    };
  }
  if (score >= 20) {
    return {
      label: 'Não recomendado',
      color: '#f97316',
      border: 'rgba(249,115,22,0.38)',
      bg: 'rgba(249,115,22,0.07)',
      shadow: '0 0 42px rgba(249,115,22,0.14)',
      pillBg: 'rgba(249,115,22,0.14)',
      pillColor: '#ffedd5',
      isV3: false,
    };
  }
  return {
    label: 'Crítico',
    color: '#ef4444',
    border: 'rgba(239,68,68,0.38)',
    bg: 'rgba(239,68,68,0.07)',
    shadow: '0 0 42px rgba(239,68,68,0.14)',
    pillBg: 'rgba(239,68,68,0.14)',
    pillColor: '#fca5a5',
    isV3: false,
  };
}

const featuredAnalysis = bestSocialAnalysis ?? freeAnalysis;
const featuredAnalysisId = featuredAnalysis?.id ?? null;
const featuredIsSocial = !!bestSocialAnalysis;
let featuredIsV3 = featuredAnalysis?.score_version === 'v3';
let featuredScoreRaw = featuredIsV3 ? (featuredAnalysis?.score_v3 ?? featuredAnalysis?.score) : featuredAnalysis?.score;
let featuredVersion = featuredAnalysis?.score_version;
if (getScoreVersion() === 'v3') {
  if (featuredIsV3 && featuredAnalysis?.score_v3 != null) {
    featuredScoreRaw = featuredAnalysis.score_v3;
  } else if (featuredAnalysis?.nome_completo) {
    const rawBirth = featuredAnalysis.data_nascimento || profileData?.birth_date;
    if (rawBirth) {
      const parts = String(rawBirth).split('-');
      const dataPt = parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : String(rawBirth);
      const targetName = (featuredIsSocial && featuredAnalysis?.frequencias_numeros?.ranking?.melhorNome?.nomeCompleto)
        ? featuredAnalysis.frequencias_numeros.ranking.melhorNome.nomeCompleto
        : featuredAnalysis.nome_completo;
      try {
        const v3Eval = avaliarNome(targetName, dataPt);
        featuredScoreRaw = v3Eval.score_v3;
        featuredIsV3 = true;
        featuredVersion = 'v3';
      } catch (e) {
        console.warn('[index.astro] Erro ao calcular score v3 dinâmico no featured:', e);
      }
    }
  }
}

const featuredTheme = getScoreTheme(featuredScoreRaw, featuredVersion);
const socialPrice = priceMap.nome_social;

const showDashboardPanel =
  !!featuredAnalysis
  && featuredAnalysis.status === 'complete'
  && !!featuredAnalysisId;

const nomeHojeDashboard =
  freeAnalysis?.nome_completo
  ?? profileData?.birth_name
  ?? featuredAnalysis?.nome_completo
  ?? '';

const rankingFeatured = (featuredAnalysis?.frequencias_numeros as Record<string, any> | null)?.ranking as
  | { selectedNomeSocial?: string; melhorNome?: { nomeCompleto?: string; score?: number } }
  | undefined;

const nomeHarmonizadoDashboard: string | null =
  rankingFeatured?.selectedNomeSocial
  ?? (featuredAnalysis as any)?.nome_harmonizado
  ?? rankingFeatured?.melhorNome?.nomeCompleto
  ?? null;

const bloqueioTitulosDashboard: string[] = (featuredAnalysis?.bloqueios ?? [])
  .map((b: { titulo?: string }) => b?.titulo?.trim())
  .filter((t: string | undefined): t is string => Boolean(t));

const dashboardScore = Math.max(0, Math.min(100, featuredScoreRaw ?? 0));

const rawBirthRadar =
  freeAnalysis?.data_nascimento
  ?? featuredAnalysis?.data_nascimento
  ?? profileData?.birth_date;
const birthPartsRadar = rawBirthRadar ? String(rawBirthRadar).split('-') : [];
const dataPtRadar = birthPartsRadar.length === 3
  ? `${birthPartsRadar[2]}/${birthPartsRadar[1]}/${birthPartsRadar[0]}`
  : (rawBirthRadar ? String(rawBirthRadar) : '');

let birthScoreDashboard = Math.max(
  0,
  Math.min(100, freeAnalysis?.score_v3 ?? freeAnalysis?.score ?? dashboardScore),
);
let scorePotencialDashboard: number | null = rankingFeatured?.melhorNome?.score != null
  ? Math.max(0, Math.min(100, Math.round(rankingFeatured.melhorNome.score)))
  : null;

if (getScoreVersion() === 'v3' && nomeHojeDashboard && dataPtRadar) {
  try {
    const birthEval = avaliarNome(nomeHojeDashboard, dataPtRadar, { calcularPotencial: true });
    birthScoreDashboard = birthEval.score_v3;
    if (!nomeHarmonizadoDashboard && typeof birthEval.potencial === 'number') {
      scorePotencialDashboard = Math.max(birthScoreDashboard, Math.min(100, Math.round(birthEval.potencial)));
    }
  } catch (e) {
    console.warn('[index.astro] Erro ao calcular score do nome de nascimento no painel:', e);
  }
}

if (nomeHarmonizadoDashboard && dataPtRadar) {
  try {
    scorePotencialDashboard = avaliarNome(nomeHarmonizadoDashboard, dataPtRadar).score_v3;
  } catch (e) {
    console.warn('[index.astro] Erro ao calcular score do nome harmonizado no painel:', e);
  }
}

const featuredFreqData = (featuredAnalysis?.frequencias_numeros as Record<string, any> | null) ?? null;
const featuredRanking = (featuredFreqData?.ranking as Record<string, any> | undefined) ?? undefined;
const featuredAreaFoco: string | null =
  typeof featuredRanking?.areaFoco === 'string'
    ? featuredRanking.areaFoco
    : typeof featuredRanking?.area_foco === 'string'
      ? featuredRanking.area_foco
      : typeof featuredFreqData?.areaFoco === 'string'
        ? featuredFreqData.areaFoco
        : typeof featuredFreqData?.area_foco === 'string'
          ? featuredFreqData.area_foco
          : typeof featuredFreqData?.parametros_usuario?.areaFoco === 'string'
            ? featuredFreqData.parametros_usuario.areaFoco
            : null;
const featuredOndeAssina: string[] = Array.isArray(featuredFreqData?.ondeVaiUsar)
  ? featuredFreqData.ondeVaiUsar
  : Array.isArray(featuredFreqData?.onde_vai_usar)
    ? featuredFreqData.onde_vai_usar
    : Array.isArray(featuredRanking?.ondeVaiUsar)
      ? featuredRanking.ondeVaiUsar
      : Array.isArray(featuredRanking?.onde_vai_usar)
        ? featuredRanking.onde_vai_usar
        : [];
const featuredRadarContext =
  featuredAreaFoco || featuredOndeAssina.length > 0
    ? { areaFoco: featuredAreaFoco, ondeAssinaRaw: featuredOndeAssina }
    : null;

let dashboardRadarAxes: RadarAxesData = {
  expressao: 0.5,
  motivacao: 0.5,
  destino: 0.5,
  harmonia_triangulo: 0.5,
  sequencias: 0.5,
};
let harmonizedRadarAxesDashboard: RadarAxesData | null = null;
let dashboardRadarLabels = getRadarAxisLabels(featuredAreaFoco);

const birthForRadar = nomeHojeDashboard;
if (birthForRadar && dataPtRadar) {
  try {
    const axes = computeContextualRadarAxes(birthForRadar, dataPtRadar, featuredRadarContext);
    dashboardRadarAxes = motorRadarToRecord(axes) as RadarAxesData;
    dashboardRadarLabels = getRadarAxisLabels(featuredAreaFoco);
  } catch (e) {
    console.warn('[index.astro] Erro ao calcular teia do painel:', e);
  }
}

if (nomeHarmonizadoDashboard && dataPtRadar) {
  try {
    const harmAxes = computeContextualRadarAxes(nomeHarmonizadoDashboard, dataPtRadar, featuredRadarContext);
    harmonizedRadarAxesDashboard = motorRadarToRecord(harmAxes) as RadarAxesData;
  } catch (e) {
    console.warn('[index.astro] Erro ao calcular teia harmonizada do painel:', e);
  }
}

const featuredProductType =
  (featuredAnalysis as any)?.product_type
  ?? (bestSocialAnalysis ? 'nome_social' : 'analise_gratuita');
const featuredIsFree = Boolean(
  (featuredAnalysis as any)?.is_free === true
  || featuredProductType === 'analise_gratuita'
  || !bestSocialAnalysis,
);
const signatureChosenDashboard = Boolean(
  rankingFeatured?.selectedNomeSocial || (featuredAnalysis as any)?.nome_harmonizado || nomeHarmonizadoDashboard,
);
const pdfReadyDashboard = Boolean(featuredAnalysis?.status === 'complete');

type DashboardHistoryRow = {
  id: string;
  nome: string;
  dateLabel: string;
  score: number | null;
  productType: string;
  isFree: boolean;
  isFavorite: boolean;
};

function toPtBrBirthDate(raw?: string | null): string {
  if (!raw) return '';
  if (/^\d{2}\/\d{2}\/\d{4}$/.test(raw)) return raw;
  const iso = String(raw).slice(0, 10);
  const parts = iso.split('-');
  return parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : String(raw);
}

type CompatType = 'favoravel' | 'neutro' | 'desfavoravel';

function extractSlideChecklist(
  freqData: Record<string, any> | null | undefined,
  slideKey: string,
): Partial<Record<ChecklistKey, boolean>> | undefined {
  const map = freqData?.checklist_by_slide;
  if (!map || typeof map !== 'object') return undefined;
  const entry = (map as Record<string, unknown>)[slideKey];
  if (!entry || typeof entry !== 'object') return undefined;
  return entry as Partial<Record<ChecklistKey, boolean>>;
}

function buildHeroSlideFromRow(row: any, defaultBirthScore: number): DashboardHeroSlide {
  const freqData = row.frequencias_numeros as Record<string, any> | null;
  const ranking = freqData?.ranking as
    | {
        selectedNomeSocial?: string;
        nomeNascimento?: string;
        dataNascimento?: string;
        areaFoco?: string | null;
        area_foco?: string | null;
        ondeVaiUsar?: string[];
        onde_vai_usar?: string[];
        melhorNome?: { nomeCompleto?: string; nomeEmpresa?: string; expressao?: number; motivacao?: number; missao?: number; impressao?: number; score?: number };
      }
    | undefined;
  const isFreeRow = row.is_free === true || row.product_type === 'analise_gratuita';
  const nomeExibido = isFreeRow
    ? row.nome_completo
    : row.product_type === 'nome_social'
      ? (freqData?.selectedNomeSocial ?? row.nome_harmonizado ?? ranking?.melhorNome?.nomeCompleto ?? row.nome_completo)
      : row.product_type === 'nome_bebe'
        ? (ranking?.melhorNome?.nomeCompleto ?? row.nome_completo)
        : row.product_type === 'nome_empresa'
          ? (freqData?.melhorNome?.nomeEmpresa ?? row.nome_completo)
          : row.nome_completo;

  const birthNameForRow =
    (ranking?.nomeNascimento as string | undefined)?.trim()
    || nomeHojeDashboard
    || row.nome_completo;
  const dataPt = toPtBrBirthDate(ranking?.dataNascimento || row.data_nascimento || rawBirthRadar);

  const rowContext = resolveRadarContext(freqData, ranking);
  const radarLabels = getRadarAxisLabels(rowContext.areaFoco);

  let slideScore = Math.max(0, Math.min(100, Math.round(row.score_v3 ?? row.score ?? 0)));
  if (getScoreVersion() === 'v3' && nomeExibido && dataPt) {
    try {
      slideScore = avaliarNome(nomeExibido, dataPt).score_v3;
    } catch {
      /* mantém score salvo */
    }
  }

  let rowBirthScore = defaultBirthScore;
  if (getScoreVersion() === 'v3' && birthNameForRow && dataPt) {
    try {
      rowBirthScore = avaliarNome(birthNameForRow, dataPt).score_v3;
    } catch {
      rowBirthScore = defaultBirthScore;
    }
  }

  let starNumbers = {
    destino: Number(row.numero_destino ?? 0),
    expressao: Number(row.numero_expressao ?? 0),
    motivacao: Number(row.numero_motivacao ?? 0),
    missao: Number(row.numero_missao ?? 0),
    impressao: Number(row.numero_impressao ?? 0),
  };
  let bloqueiosTitulos: string[] = Array.isArray(row.bloqueios)
    ? row.bloqueios
        .map((b: { titulo?: string }) => b?.titulo?.trim())
        .filter((t: string | undefined): t is string => Boolean(t))
    : [];
  let compatibilidade: CompatType | null = null;

  if (nomeExibido && dataPt) {
    try {
      const cinco = calcularCincoNumeros(nomeExibido, dataPt);
      starNumbers = {
        destino: cinco.destino ?? starNumbers.destino,
        expressao: cinco.expressao,
        motivacao: cinco.motivacao,
        missao: cinco.missao,
        impressao: cinco.impressao,
      };
      const tris = calcularTodosTriangulos(nomeExibido, dataPt);
      const blocs = detectarBloqueios(tris);
      bloqueiosTitulos = blocs.map((b) => b.titulo);
    } catch {
      /* mantém números salvos no banco */
    }
  } else if (row.product_type === 'nome_empresa' && freqData?.melhorNome) {
    const emp = freqData.melhorNome as Record<string, any>;
    starNumbers = {
      destino: Number(freqData.destinoSocio ?? starNumbers.destino),
      expressao: Number(emp.expressao ?? starNumbers.expressao),
      motivacao: Number(emp.motivacao ?? starNumbers.motivacao),
      missao: Number(emp.missao ?? starNumbers.missao),
      impressao: Number(emp.impressao ?? starNumbers.impressao),
    };
  }

  if (starNumbers.expressao > 0 && starNumbers.destino > 0) {
    compatibilidade = avaliarCompatibilidade(starNumbers.expressao, starNumbers.destino);
  }

  let birthRadarAxes: RadarAxesData = dashboardRadarAxes;
  let harmonizedRadarAxes: RadarAxesData | null = null;
  if (birthNameForRow && dataPt) {
    try {
      birthRadarAxes = motorRadarToRecord(
        computeContextualRadarAxes(birthNameForRow, dataPt, rowContext),
      ) as RadarAxesData;
    } catch {
      birthRadarAxes = dashboardRadarAxes;
    }
  }
  const hasDistinctHarmonized =
    row.product_type !== 'nome_social' ||
    nomeExibido.trim().toLowerCase() !== birthNameForRow.trim().toLowerCase();
  if (!isFreeRow && hasDistinctHarmonized && nomeExibido && dataPt) {
    try {
      harmonizedRadarAxes = motorRadarToRecord(
        computeContextualRadarAxes(nomeExibido, dataPt, rowContext),
      ) as RadarAxesData;
    } catch {
      harmonizedRadarAxes = null;
    }
  }

  const savedRadar = readContextualRadarSnapshot(freqData, birthNameForRow, nomeExibido);
  if (savedRadar) {
    birthRadarAxes = motorRadarToRecord(savedRadar.birth);
    harmonizedRadarAxes = isFreeRow ? null : motorRadarToRecord(savedRadar.selected);
  }
  return {
    id: row.id,
    nome: nomeExibido,
    birthName: birthNameForRow,
    score: slideScore,
    birthScore: rowBirthScore,
    bloqueiosCount: bloqueiosTitulos.length,
    bloqueiosTitulos,
    compatibilidade,
    starNumbers,
    arquetipo: starNumbers.expressao > 0 ? getArquetipo(starNumbers.expressao) : null,
    arquetipoNascimento: birthNameForRow && dataPt ? getArquetipo(calcularCincoNumeros(birthNameForRow, dataPt).expressao) : null,
    origem: freqData?.ranking?.nomesCandidatos?.find((c: any) => c.nomeCompleto?.trim().toLowerCase() === nomeExibido.trim().toLowerCase())?.origem,
    productType: row.product_type ?? 'nome_social',
    isFree: isFreeRow,
    isFavorite: !isFreeRow && Boolean(freqData?.is_favorite),
    dateLabel: new Intl.DateTimeFormat('pt-BR', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      timeZone: 'America/Sao_Paulo',
    }).format(new Date(row.created_at)),
    checklistAnalysisId: row.id,
    birthRadarAxes,
    harmonizedRadarAxes,
    radarLabels,
    initialChecklist: extractSlideChecklist(freqData, row.id),
  };
}

function buildSynthesizedBirthSlide(
  targetAnalysisId: string | null,
  targetAnalysisFreqData: Record<string, any> | null | undefined,
  birthName: string,
  dataPt: string,
  fallbackScore: number,
): DashboardHeroSlide | null {
  if (!targetAnalysisId || !birthName.trim()) return null;

  let slideScore = Math.max(0, Math.min(100, Math.round(fallbackScore)));
  let starNumbers = { destino: 0, expressao: 0, motivacao: 0, missao: 0, impressao: 0 };
  let bloqueiosTitulos: string[] = [];
  let birthRadarAxes: RadarAxesData = dashboardRadarAxes;

  if (dataPt) {
    try {
      slideScore = avaliarNome(birthName, dataPt).score_v3;
      const cinco = calcularCincoNumeros(birthName, dataPt);
      starNumbers = {
        destino: cinco.destino,
        expressao: cinco.expressao,
        motivacao: cinco.motivacao,
        missao: cinco.missao,
        impressao: cinco.impressao,
      };
      const tris = calcularTodosTriangulos(birthName, dataPt);
      bloqueiosTitulos = detectarBloqueios(tris).map((b) => b.titulo);
      birthRadarAxes = motorRadarToRecord(
        computeContextualRadarAxes(birthName, dataPt, featuredRadarContext),
      ) as RadarAxesData;
    } catch {
      /* mantém fallback */
    }
  }

  const compatibilidade: CompatType | null =
    starNumbers.expressao > 0 && starNumbers.destino > 0
      ? avaliarCompatibilidade(starNumbers.expressao, starNumbers.destino)
      : null;

  const slideKey = `${targetAnalysisId}__birth`;

  return {
    id: slideKey,
    nome: birthName,
    birthName,
    score: slideScore,
    birthScore: slideScore,
    bloqueiosCount: bloqueiosTitulos.length,
    bloqueiosTitulos,
    compatibilidade,
    starNumbers,
    productType: 'analise_gratuita',
    isFree: true,
    isFavorite: false,
    dateLabel: '',
    pdfAnalysisId: targetAnalysisId,
    checklistAnalysisId: targetAnalysisId,
    resultadoHrefOverride: `/app/resultado/${targetAnalysisId}?modo=nascimento`,
    birthRadarAxes,
    harmonizedRadarAxes: null,
    radarLabels: dashboardRadarLabels,
    initialChecklist: extractSlideChecklist(targetAnalysisFreqData, slideKey),
  };
}

const paidCompletedRows = allCompletedAnalyses.filter(
  (row) => row.is_free !== true && row.product_type !== 'analise_gratuita',
);

// Ordem cronológica crescente (mais antiga -> mais recente), empilhadas à direita do nome inicial
const paidSlides: DashboardHeroSlide[] = [...paidCompletedRows]
  .sort((a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime())
  .map((row) => buildHeroSlideFromRow(row, birthScoreDashboard));

const birthSlideFromFreeRow = freeAnalysis
  ? buildHeroSlideFromRow(freeAnalysis, birthScoreDashboard)
  : null;

const hasDifferentBirthNameInPaid =
  Boolean(nomeHojeDashboard) &&
  paidSlides.some((s) => s.nome.trim().toLowerCase() !== nomeHojeDashboard.trim().toLowerCase());

const birthSlide: DashboardHeroSlide | null =
  birthSlideFromFreeRow ??
  (paidSlides.length === 0 || hasDifferentBirthNameInPaid
    ? buildSynthesizedBirthSlide(
        featuredAnalysisId,
        (featuredAnalysis?.frequencias_numeros as Record<string, any> | null) ?? null,
        nomeHojeDashboard,
        dataPtRadar,
        birthScoreDashboard,
      )
    : null);

const heroSlides: DashboardHeroSlide[] = birthSlide
  ? [birthSlide, ...paidSlides]
  : paidSlides;

const historySourceRows = allCompletedAnalyses.slice(0, 6);
const dashboardHistory: DashboardHistoryRow[] = historySourceRows.map((row) => {
  const freqData = row.frequencias_numeros as Record<string, any> | null;
  const ranking = freqData?.ranking as { melhorNome?: { nomeCompleto?: string } } | undefined;
  const isFreeRow = row.is_free === true || row.product_type === 'analise_gratuita';
  const nomeExibido = isFreeRow
    ? row.nome_completo
    : (row.product_type === 'nome_social' && (freqData?.selectedNomeSocial || row.nome_harmonizado || ranking?.melhorNome?.nomeCompleto))
      ? (freqData?.selectedNomeSocial ?? row.nome_harmonizado ?? ranking?.melhorNome?.nomeCompleto)
      : (row.product_type === 'nome_bebe' && ranking?.melhorNome?.nomeCompleto)
        ? ranking.melhorNome.nomeCompleto
        : (row.product_type === 'nome_empresa' && freqData?.melhorNome?.nomeEmpresa)
          ? freqData.melhorNome.nomeEmpresa
          : row.nome_completo;

  let score: number | null = null;
  const isV3Row = row.score_version === 'v3';
  if (isV3Row && row.score_v3 != null) {
    score = row.score_v3;
  } else if (getScoreVersion() === 'v3' && nomeExibido && row.data_nascimento) {
    const dataPt = toPtBrBirthDate(row.data_nascimento);
    try {
      score = avaliarNome(nomeExibido, dataPt).score_v3;
    } catch {
      score = row.score;
    }
  } else {
    score = row.score;
  }

  return {
    id: row.id,
    nome: nomeExibido,
    dateLabel: new Intl.DateTimeFormat('pt-BR', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      timeZone: 'America/Sao_Paulo',
    }).format(new Date(row.created_at)),
    score,
    productType: row.product_type ?? 'nome_social',
    isFree: isFreeRow,
    isFavorite: !isFreeRow && Boolean(freqData?.is_favorite),
  };
});

const onlyFreeAnalysisDashboard = !!freeAnalysis && !bestSocialAnalysis;

