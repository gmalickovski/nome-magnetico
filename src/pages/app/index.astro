        <div>
          <h3 class="font-cinzel text-lg font-bold text-[#D4AF37] mb-1">
            Comece sua jornada numerológica
          </h3>
          <p class="text-gray-400 text-sm">Adquira um dos produtos para realizar sua análise cabalística completa.</p>
        </div>
        <a
          href="/comprar"
          class="flex-shrink-0 bg-[#D4AF37] text-[#1A1A1A] font-medium px-6 py-2.5 rounded-full hover:bg-[#f2ca50] transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
        >
          Ver Todos os Produtos
        </a>
      </div>
    )}

    {(freeAnalysisStatus === 'pending' || freeAnalysisStatus === 'processing') && (
      <section
        class="rounded-3xl border bg-white/[0.03] p-6 md:p-8 text-center flex flex-col items-center justify-center min-h-[220px]"
        style="border-color: rgba(212,175,55,0.22); box-shadow: inset 0 1px 0 rgba(255,255,255,0.03), 0 20px 50px rgba(0,0,0,0.6);"
      >
        <div class="relative flex items-center justify-center w-16 h-16 mb-4">
          <div class="absolute inset-0 rounded-full bg-[#D4AF37]/10 animate-ping pointer-events-none"></div>
          <svg class="h-10 w-10 animate-spin text-[#D4AF37] relative z-10" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" />
            <path class="opacity-80" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z" />
          </svg>
        </div>
        <h3 class="font-cinzel text-xl font-bold text-[#D4AF37] mb-2 tracking-wide">
          Analisando seu Nome de Nascimento...
        </h3>
        <p class="text-sm text-gray-400 max-w-md mx-auto leading-relaxed font-light">
          Nossos algoritmos cabalísticos estão processando sua frequência original de nascimento e decodificando seus bloqueios energéticos. Isso levará apenas alguns segundos.
        </p>

        <script is:inline define:vars={{ analysisId: freeAnalysisId }}>
          (function() {
            function checkStatus() {
              fetch('/api/analysis-status?id=' + analysisId)
                .then(function(res) { return res.json(); })
                .then(function(data) {
                  if (data.status === 'complete' || data.status === 'error') {
                    // polling-ok: polling legado analise gratis index.astro (manter comportamento sem alterar app)
                    window.location.reload();
                  } else {
                    setTimeout(checkStatus, 2000);
                  }
                })
                .catch(function() {
                  setTimeout(checkStatus, 3000);
                });
            }
            if (analysisId) {
              setTimeout(checkStatus, 1500);
            }
          })();
        </script>
      </section>
    )}

    {showDashboardPanel && (
      <AppDashboard
        client:load
        userId={user.id}
        nomeHoje={nomeHojeDashboard}
        nomeHarmonizado={nomeHarmonizadoDashboard}
        score={dashboardScore}
        birthScore={birthScoreDashboard}
        scorePotencial={scorePotencialDashboard}
        scoreLabel={featuredTheme.label}
        scoreColor={featuredTheme.color}
        bloqueios={bloqueioTitulosDashboard}
        analysisId={featuredAnalysisId!}
        featuredProductType={featuredProductType}
        featuredIsFree={featuredIsFree}
        signatureChosen={signatureChosenDashboard}
        pdfReady={pdfReadyDashboard}
        radarAxes={dashboardRadarAxes}
        harmonizedRadarAxes={harmonizedRadarAxesDashboard}
        radarLabels={dashboardRadarLabels}
        history={dashboardHistory}
        heroSlides={heroSlides}
        hasNomeSocial={hasNomeSocial}
        isAdmin={isAdmin}
        isExpired={isExpired}
        accessEndLabel={accessEndLabel}
        hasPaidAccess={hasAnyAccess}
        onlyFreeAnalysis={onlyFreeAnalysisDashboard}
        socialPrice={socialPrice ?? PRICE_UNAVAILABLE}
        promotion={promotion}
      />
    )}

    {!showDashboardPanel && freeAnalysisStatus !== 'pending' && freeAnalysisStatus !== 'processing' && (
      hasNomeSocial ? (
        <section class="rounded-2xl bg-[#1C1C1C] px-6 py-10 text-center shadow-[0_20px_50px_rgba(0,0,0,0.45)] sm:px-10 sm:py-14">
          <h2 class="font-cinzel text-2xl font-bold text-[#e5e2e1] sm:text-3xl">
            Inicie sua harmonização no chat
          </h2>
          <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-[#A0A0A0]">
            Analise seu nome, elimine bloqueios e compare variações harmonizadas em tempo real.
          </p>
          <a
            href="/app/analise/nome-social"
            data-nm-header-cta="analise"
            data-user-id={user.id}
            data-default-label="Abrir chat de análise"
            data-resume-label="Retomar Análise"
            class="mt-6 inline-flex items-center justify-center rounded-full bg-[#D4AF37] px-6 py-3 text-sm font-bold text-[#111111] transition hover:bg-[#f2ca50]"
          >
            Abrir chat de análise
          </a>
        </section>
      ) : (
        <section class="rounded-2xl bg-[#1C1C1C] px-6 py-10 text-center shadow-[0_20px_50px_rgba(0,0,0,0.45)] sm:px-10 sm:py-14">
          <h2 class="font-cinzel text-2xl font-bold text-[#e5e2e1] sm:text-3xl">
            Comece pela sua análise gratuita
          </h2>
          <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-[#A0A0A0]">
            Descubra o score do seu nome de nascimento e os bloqueios que afetam sua assinatura.
          </p>
          <a
            href="/app/analise-gratuita"
            class="mt-6 inline-flex items-center justify-center rounded-full bg-[#D4AF37] px-6 py-3 text-sm font-bold text-[#111111] transition hover:bg-[#f2ca50]"
          >
            Iniciar análise gratuita
          </a>
        </section>
      )
    )}

    {!freeAnalysisId && leadNome && leadData && (
      <div>
        <FreePDFAutoGenerator
          client:load
          existingAnalysisId={null}
          leadNome={leadNome}
          leadData={leadData}
          autoRun={true}
        />
      </div>
    )}

    {showRefundButton && (
      <div class="flex justify-center sm:justify-end">
        <a href="/app/reembolso"
           class="w-full sm:w-auto text-center rounded-full px-5 py-3 text-sm text-gray-400 border border-white/10 hover:text-gray-200 hover:border-white/20 transition-colors">
          Solicitar reembolso
        </a>
      </div>
    )}

  </div>
  
  {showFreeUsedModal && <FreeUsedModal client:only="react" />}

  <script define:vars={{ isAdmin }}>
    (function () {
      function localSet(key, value) {
        try { localStorage.setItem(key, value); } catch (e) {}
      }
      function localRemove(key) {
        try { localStorage.removeItem(key); } catch (e) {}
      }
      if (isAdmin) {
        localSet('nm-user-role', 'admin');
      } else {
        localRemove('nm-user-role');
      }
    })();
  </script>
</AppLayout>
