---
import AppLayout from '../../layouts/AppLayout.astro';
import { isAdmin } from '../../backend/db/users';
import { isSentryEnabled } from '../../sentry/env';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login?redirect=' + encodeURIComponent(Astro.url.pathname));

if (!(await isAdmin(user.id))) return Astro.redirect('/app');

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const enabled = isSentryEnabled();
---

<AppLayout title="Teste de erros" description="Verificação interna de monitoramento. Sem indexação.">
  <section class="mx-auto max-w-xl rounded-2xl bg-[#1c1c1c] px-6 py-8 shadow-[0_20px_50px_rgba(0,0,0,0.6)] sm:px-8">
    <p class="font-inter text-xs uppercase tracking-[0.1em] text-[#bea5ff]">Monitoramento</p>
    <h1 class="mt-3 font-cinzel text-2xl text-[#e5e2e1]">Teste de erros</h1>
    <p class="mt-4 font-inter text-sm font-light leading-relaxed text-[#e5e2e1]/80">
      Página interna, só para admin. Nada aqui aparece no menu.
      {enabled
        ? ' O monitoramento está ligado neste ambiente.'
        : ' O monitoramento está desligado: falta DSN ou o ambiente não é production.'}
    </p>

    <div class="mt-8 flex flex-col gap-3">
      <button
        id="sentry-server-smoke"
        type="button"
        class="rounded-full bg-[#f2ca50] px-6 py-3 font-inter text-sm font-medium text-[#131313] shadow-[0_0_24px_rgba(242,202,80,0.25)] transition-opacity duration-700 hover:opacity-90"
      >
        Disparar erro no servidor
      </button>
      <p id="sentry-server-result" class="min-h-5 font-inter text-sm text-[#e5e2e1]/70"></p>

      <button
        id="sentry-client-smoke"
        type="button"
        class="rounded-full bg-[#2a2a2a] px-6 py-3 font-inter text-sm font-medium text-[#e5e2e1] transition-opacity duration-700 hover:opacity-90"
      >
        Disparar erro no navegador
      </button>
      <p id="sentry-client-result" class="min-h-5 font-inter text-sm text-[#e5e2e1]/70"></p>
    </div>
  </section>
</AppLayout>

<script>
  import * as Sentry from '@sentry/astro';

  const serverButton = document.getElementById('sentry-server-smoke');
  const serverResult = document.getElementById('sentry-server-result');
  const clientButton = document.getElementById('sentry-client-smoke');
  const clientResult = document.getElementById('sentry-client-result');

  serverButton?.addEventListener('click', async () => {
    if (serverResult) serverResult.textContent = 'Enviando…';
    try {
      const response = await fetch('/api/internal/sentry-test', { method: 'POST' });
      const data = (await response.json()) as { ok?: boolean; eventId?: string | null; error?: string };
      if (serverResult) {
        serverResult.textContent = data.ok
          ? `Evento enviado${data.eventId ? ` (${data.eventId})` : ''}.`
          : (data.error ?? 'Não foi possível enviar.');
      }
    } catch {
      if (serverResult) serverResult.textContent = 'Falha ao chamar o teste.';
    }
  });

  clientButton?.addEventListener('click', () => {
    const eventId = Sentry.captureException(new Error('Sentry smoke test — Nome Magnético (client)'), {
      tags: { smoke: 'client' },
    });
    if (clientResult) {
      clientResult.textContent = eventId
        ? `Evento enviado (${eventId}).`
        : 'O navegador não enviou. O monitoramento está desligado neste ambiente.';
    }
  });
</script>
