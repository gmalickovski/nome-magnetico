---
import AppLayout from '../../layouts/AppLayout.astro';
import { FAQSection } from '../../frontend/components/landing/FAQSection';
import type { FaqItemProps } from '../../frontend/components/landing/FAQSection';
import { SupportForm } from '../../frontend/components/support/SupportForm';
import { getSupabaseFaqs } from '../../backend/faqs/getSupabaseFaqs';
import { listCustomerSupportTickets } from '../../backend/support/read-tickets';
import { supportDate, supportStatusLabel } from '../../shared/support-tickets';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login');
}
Astro.response.headers.set('Cache-Control', 'private, no-store');

const requestedPage = Number(Astro.url.searchParams.get('historico') ?? 1);
const historyPage = Number.isInteger(requestedPage) && requestedPage >= 1 && requestedPage <= 10000
  ? requestedPage
  : 1;
const history = await listCustomerSupportTickets(user.id, historyPage).catch(() => null);

let faqItems: FaqItemProps[] = [];
try {
  faqItems = await getSupabaseFaqs();
} catch (err) {
  console.warn('[suporte] Falha ao carregar FAQs do Supabase — usando fallback:', err);
}
---

<AppLayout
  title="Central de Suporte"
>
  <div class="max-w-3xl mx-auto space-y-8 mt-4 md:mt-8 pb-16">
    <div>
      <h1 class="font-cinzel text-3xl font-bold text-white mb-2">Central de Suporte</h1>
      <p class="text-gray-400">Encontre respostas ou entre em contato com nossa equipe.</p>
    </div>

    <div class="flex flex-col gap-6">
      {/* Container Principal do Formulário */}
      <SupportForm client:visible />

      <section id="historico" aria-labelledby="historico-titulo" class="bg-white/5 border border-[#D4AF37]/20 rounded-2xl p-6">
        <h2 id="historico-titulo" class="font-cinzel text-lg font-bold text-white">Meus chamados</h2>
        {!history && <p class="mt-3 text-sm text-gray-300">Não foi possível carregar o histórico agora.</p>}
        {history?.tickets.length === 0 && <p class="mt-3 text-sm text-gray-300">Nenhum chamado nesta página.</p>}
        {history && (
          <>
            <ul class="mt-3 divide-y divide-white/10">
              {history.tickets.map((ticket) => (
                <li class="py-3">
                  <p class="break-words text-sm font-semibold text-white">{ticket.subject}</p>
                  <div class="mt-1 flex flex-wrap gap-x-3 text-xs text-gray-300">
                    {ticket.ticket_number && <span>{ticket.ticket_number}</span>}
                    <span>{supportStatusLabel(ticket.status)}</span>
                    <time datetime={ticket.created_at}>{supportDate(ticket.created_at)}</time>
                  </div>
                </li>
              ))}
            </ul>
            {(historyPage > 1 || history.hasNext) && (
              <nav aria-label="Páginas do histórico" class="mt-2 flex flex-wrap gap-4 text-sm text-[#D4AF37]">
                {historyPage > 1 && <a class="inline-flex min-h-11 items-center hover:underline" href={`?historico=${historyPage - 1}#historico`}>Anterior</a>}
                {history.hasNext && <a class="inline-flex min-h-11 items-center hover:underline" href={`?historico=${historyPage + 1}#historico`}>Próxima</a>}
              </nav>
            )}
          </>
        )}
      </section>

      <div class="bg-white/5 border border-[#D4AF37]/20 rounded-2xl p-6">
        <h3 class="font-cinzel text-lg font-bold text-white mb-2">Privacidade e exclusão de conta</h3>
        <p class="text-gray-400 text-sm leading-relaxed">
          Para solicitar exclusão da sua conta, análises e demais dados pessoais associados, selecione o assunto
          <strong class="text-gray-300">Privacidade e Exclusão de Conta</strong> no formulário acima ou escreva para
          <a href="mailto:privacidade@nomemagnetico.com.br" class="text-[#D4AF37] hover:underline">privacidade@nomemagnetico.com.br</a>.
        </p>
      </div>

      {/* Box de Email Fora do Container */}
      <a
        href="mailto:suporte@nomemagnetico.com.br"
        class="bg-white/5 border border-[#D4AF37]/20 rounded-2xl p-6 hover:border-[#D4AF37]/40 transition-all duration-300 flex items-center gap-4"
      >
        <div class="text-3xl">✉️</div>
        <div>
          <h3 class="font-cinzel text-lg font-bold text-white mb-1">Email para contato direto</h3>
          <p class="text-gray-400 text-sm">suporte@nomemagnetico.com.br</p>
          <p class="text-gray-600 text-xs mt-1">Resposta em até 24h</p>
        </div>
      </a>
    </div>

    <FAQSection items={faqItems} client:visible />
  </div>
</AppLayout>
