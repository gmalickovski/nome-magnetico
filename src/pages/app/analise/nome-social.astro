---
import AppLayout from '../../../layouts/AppLayout.astro';
import { hasActiveSubscription } from '../../../backend/db/subscriptions';
import { createUserClient, getSupabaseAdmin } from '../../../backend/db/supabase';
import { findLeadPrefill } from '../../../backend/public-free-analysis/lead-prefill';
import NomeSocialChat from '../../../frontend/components/app/chat/NomeSocialChat';
import { buildClientBirthNamePanel } from '../../../backend/numerology/birth-name-panel';
import { isFluxoMotivoAtivo } from '../../../backend/env/chat-flags';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login');

const client = createUserClient(Astro.locals.accessToken ?? '');
const { data: profile } = await client
  .from('profiles')
  .select('birth_name, birth_date, gender, role')
  .eq('id', user.id)
  .single();

const isAdmin = profile?.role === 'admin';
const hasAccess = isAdmin || await hasActiveSubscription(user.id, 'nome_social');

function dbDateToInput(dbDate: string | null): string {
  if (!dbDate) return '';
  const parts = dbDate.split('-');
  if (parts.length !== 3) return '';
  return `${parts[2]}/${parts[1]}/${parts[0]}`;
}

let nomeInicial = profile?.birth_name ?? '';
let dataInicial = dbDateToInput(profile?.birth_date ?? '');

// DEV-343: conta nova que já fez a análise grátis volta com nome e data preenchidos (só leitura,
// e-mail confirmado, nada na URL). O chat mostra os valores para a pessoa confirmar.
if (!nomeInicial.trim() || !dataInicial.trim()) {
  try {
    const lead = await findLeadPrefill(getSupabaseAdmin(), user.email, Boolean(user.email_confirmed_at));
    if (lead) {
      nomeInicial = lead.nome;
      dataInicial = lead.data;
    }
  } catch (e) {
    console.warn('[nome-social] pré-preenchimento pelo lead:', e);
  }
}
const generoInicial = profile?.gender ?? '';
const caminhoInicial = Astro.url.searchParams.get('caminho') ?? undefined;

let initialBirthPanel = null;
if (nomeInicial.trim() && dataInicial.trim()) {
  try {
    initialBirthPanel = buildClientBirthNamePanel(nomeInicial, dataInicial);
  } catch (e) {
    console.warn('[nome-social] painel inicial do nome de nascimento:', e);
  }
}
---

<AppLayout title="Análise de Nome Social" noPadding mobileFullViewport>
  <div class="nm-chat-shell">
    <NomeSocialChat
      client:load
      birthName={nomeInicial}
      birthDate={dataInicial}
      profileGender={generoInicial}
      initialBirthPanel={initialBirthPanel}
      userId={user.id}
      isSubscriber={hasAccess}
      emailConfirmed={Boolean(user.email_confirmed_at)}
      caminhoInicialAtivo={isFluxoMotivoAtivo()}
      initialCaminho={caminhoInicial}
    />
  </div>
</AppLayout>
