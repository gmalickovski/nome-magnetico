---
import LandingLayout from '../layouts/LandingLayout.astro';
import { LandingHeader } from '../frontend/components/landing/LandingHeader';
import { LandingFooter } from '../frontend/components/landing/LandingFooter';
import { SCORE_CONFIG_V3 } from '../backend/numerology/score-config';
import { AVISO_AUTOCONHECIMENTO } from '../shared/legal';
import { LetterNumberExample } from '../frontend/components/landing/LetterNumberExample';

const cfg = SCORE_CONFIG_V3;

const TITLE = 'Como Calculamos a Nota do Seu Nome';
const DESCRIPTION =
  'Veja como calculamos a nota do seu nome, de 0 a 100, pela Numerologia Cabalística e como o sistema escolhe os nomes do Nome Social, do Nome Artístico e do bebê.';

// Tabela cabalística das letras (docs/architecture/logica-analises.md).
const TABELA_LETRAS = [
  { valor: '1', letras: 'A · I · Q · J · Y' },
  { valor: '2', letras: 'B · K · R' },
  { valor: '3', letras: 'C · G · L · S' },
  { valor: '4', letras: 'D · M · T' },
  { valor: '5', letras: 'E · H · N' },
  { valor: '6', letras: 'U · V · W · X · Ç' },
  { valor: '7', letras: 'O · Z' },
  { valor: '8', letras: 'F · P' },
];

// Acentos e apóstrofo (backend/numerology/core.ts, calcularValor). Convenção do método.
const ACENTOS = [
  { sinal: '´', nome: 'Agudo', regra: '+2', exemplo: 'E = 5, É = 7' },
  { sinal: '~', nome: 'Til', regra: '+3', exemplo: 'A = 1, Ã = 4' },
  { sinal: '^', nome: 'Circunflexo', regra: '+7', exemplo: 'O = 7, Ô = 14' },
  { sinal: '`', nome: 'Grave', regra: '×2', exemplo: 'A = 1, À = 2' },
  { sinal: '¨', nome: 'Trema', regra: '×2', exemplo: 'U = 6, Ü = 12' },
  { sinal: '°', nome: 'Anel', regra: '+7', exemplo: 'A = 1, Å = 8' },
  { sinal: "'", nome: 'Apóstrofo', regra: '+2 na letra anterior', exemplo: "D'Angelo = 30" },
];

const PASSOS = [
  { n: '1', titulo: 'Cada letra vale um número', texto: 'Pela tabela cabalística, que é fixa. Acentos mudam o valor da letra (o agudo soma 2, o til soma 3, o circunflexo soma 7), por isso um acento ou uma letra a mais muda o resultado.' },
  { n: '2', titulo: 'A data dá o Destino', texto: 'Somamos os dígitos da data de nascimento. O Destino não muda nunca: é a referência com a qual o nome precisa conversar.' },
  { n: '3', titulo: 'O nome dá os 5 números', texto: 'Expressão (todas as letras), Motivação (vogais), Impressão (consoantes), Missão (Expressão mais Destino) e o próprio Destino. Os números mestres 11 e 22 são mantidos, menos na Impressão.' },
  { n: '4', titulo: 'O Triângulo da Vida mostra os bloqueios', texto: 'Os valores das letras ficam em linha e são somados de dois em dois, linha a linha, até a ponta. Três números iguais em sequência (111, 222… 999) formam um bloqueio.' },
  { n: '5', titulo: 'A nota resume tudo de 0 a 100', texto: 'Parte de 100 e perde pontos por bloqueios, tensão entre Expressão e Destino, dívidas kármicas, tendências ocultas e lições kármicas. Mesmo nome e mesma data dão sempre a mesma nota.' },
];

// Como o sistema escolhe os nomes de cada caminho (fonte: backend/numerology/products e docs/architecture).
const CAMINHOS = [
  {
    n: '9',
    id: 'regra-de-qualidade',
    titulo: 'Como escolhemos os nomes que você vê',
    intro: 'Antes de aparecer na sua tela, toda sugestão do sistema passa por duas travas objetivas:',
    itens: [
      '**Zero bloqueios** no Triângulo da Vida.',
      '**Nota mínima:** 80 para nomes totalmente novos (artístico e bebê) e 70 para variações do seu nome de nascimento. A lista sai do mais próximo de 100 para baixo.',
    ],
    fecho: 'Os nomes que **você** digita não são sugestões: eles passam só pelo cálculo e aparecem com a nota e com os bloqueios, se houver. O que não passa nas travas, você nem chega a ver.',
  },
  {
    n: '10',
    id: 'nome-social',
    titulo: 'Nome Social: as suas respostas ordenam as opções',
    intro: 'O sistema gera variações do seu nome (acentos, letras, ordem e retirada de sobrenomes), calcula cada uma com a sua data e descarta as que têm bloqueio.',
    itens: [
      'As suas respostas no chat (onde usa o nome, o que quer transmitir, quanto aceita mudar, se quer manter o primeiro nome) decidem a ordem entre as que passaram.',
      'Você vê **3 sugestões**, pode pedir até 2 novas rodadas (máximo de 9) e testar **até 5 nomes seus**.',
    ],
    fecho: 'O nome do seu registro não muda: a harmonização é a forma de assinar e de se apresentar.',
  },
  {
    n: '11',
    id: 'nome-artistico',
    titulo: 'Nome Artístico: a sua data, a sua área',
    intro: 'Todo nome artístico é calculado com a **sua** data de nascimento, porque quem sobe ao palco é você.',
    itens: [
      '**Nomes próximos** saem do seu nome de nascimento pelas técnicas que muitos artistas usam: só o primeiro nome, só o sobrenome, apelido, primeiro nome com sobrenome, grafia artística (letra dobrada, y, k, th, w) e, por último, um acento.',
      '**Nomes totalmente novos** nascem de ideias a partir do seu perfil (persona e imagem: marcante, sofisticada, divertida, misteriosa, popular) e de um banco de nomes de palco. A IA pode sugerir ideias, mas quem calcula e decide a nota é sempre o motor de cálculo.',
      '**Afinidade número × área:** cada número de Expressão favorece qualidades diferentes (por exemplo, o 3 traz comunicação e carisma; o 5, versatilidade; o 7, profundidade e autoria). É uma referência do método, simbólica, que só **ordena** nomes que já passaram nas travas e não entra no cálculo da nota.',
    ],
    fecho: 'Você recebe até 3 nomes próximos e até 3 totalmente novos, cada um com uma frase explicando por que o número combina com a sua área.',
  },
  {
    n: '12',
    id: 'nome-do-bebe',
    titulo: 'Nome do Bebê: a família e a data',
    intro: 'O nome é calculado **completo**, com o primeiro nome e os sobrenomes da família.',
    itens: [
      '**Sobrenomes:** vêm do nome da mãe e do pai (basta um) e você pode ajustá-los. Como a ordem muda o cálculo, o sistema testa as ordens possíveis e usa a que forma menos bloqueios.',
      '**Janela de Datas:** sem a data exata do parto, cada nome é calculado em todos os dias de 14 antes até 14 depois da data prevista (29 dias). Só é sugerido se ficar bom (nota 80 ou mais, sem bloqueio) em pelo menos metade desses dias, e o cartão mostra, por exemplo, "bom em 26 de 29 dias".',
      '**Perfil do filho:** sexo (ou "ainda não sei", que mostra menina, menino e neutros) e estilo (clássico, moderno, curto, bíblico, internacional). O estilo é preferência: escolhe quem entra primeiro, mas não elimina um nome bom do mapa.',
      '**Os nomes que vocês já pensaram** (até 5) são analisados do mesmo jeito e aparecem com o bloqueio, se houver.',
    ],
    fecho: 'A Janela de Datas é uma referência simbólica: a data do parto segue sempre a orientação médica e o tempo natural do bebê.',
  },
  {
    n: '13',
    id: 'arquetipo',
    titulo: 'Arquétipo: a leitura narrativa do número de Expressão',
    intro: 'O arquétipo é uma **camada narrativa** que o relatório coloca sobre o número de Expressão do nome. Ele ajuda a entender a imagem que o nome projeta e **não altera o cálculo nem a nota**.',
    itens: [
      '**Como é definido:** cada número de Expressão tem um arquétipo: 1 O Herói, 2 O Cuidador, 3 O Criador, 4 O Construtor, 5 O Explorador, 6 O Amante, 7 O Sábio, 8 O Governante, 9 O Humanista, 11 O Mensageiro e 22 O Arquiteto.',
      '**No Nome Artístico:** o PDF mostra o arquétipo do nome artístico (a Expressão do nome novo), com a essência dele. É uma referência de imagem para o palco, e por isso costuma ser a parte que mais conversa com quem cria um personagem.',
      '**O que ele não faz:** não entra na nota e não decide quais nomes são sugeridos. A ordem das sugestões usa a nota e a afinidade do número com a sua área.',
    ],
    fecho: 'É uma leitura simbólica, para inspirar a escolha. Para ver o arquétipo do seu nome atual, faça a análise gratuita.',
  },
];
---

<LandingLayout
  title={TITLE}
  description={DESCRIPTION}
  keywords="como calculamos a nota do nome, como funciona a nota numerologia, tabela cabalística das letras, triângulo da vida, nota de 0 a 100, janela de datas, nome artístico numerologia, nome do bebê numerologia"
>
  <LandingHeader client:load />

  <main class="bg-[#111111] pb-24">

    {/* ── HERO ── */}
    <section class="relative isolate overflow-hidden bg-[#111111] pt-[88px] sm:pt-28 lg:pt-32 pb-12 sm:pb-16">
      <div class="absolute inset-0 pointer-events-none z-0" aria-hidden="true">
        <div class="absolute inset-0 bg-gradient-to-br from-[#1a1400] via-[#111111] to-[#0d0d1a]"></div>
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[340px] h-[340px] sm:w-[560px] sm:h-[560px] lg:w-[760px] lg:h-[760px] bg-[#D4AF37]/15 rounded-full blur-[110px] sm:blur-[140px]"></div>
        <div class="absolute bottom-0 right-0 w-[300px] h-[300px] md:w-[500px] md:h-[500px] bg-purple-500/10 rounded-full blur-[100px]"></div>
      </div>
      <div class="relative z-10 max-w-[1440px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 lg:px-12 w-full min-w-0">
        <div class="max-w-3xl mx-auto text-center">
          <p class="nm-eyebrow mb-3">Transparência Metodológica</p>
          <h1 class="nm-h1">Como calculamos a nota do seu nome</h1>
          <p class="nm-body-lg mt-5 mx-auto max-w-[58ch]">
            Cada letra tem um valor fixo e cada ponto tem uma regra. Veja de onde vem a sua nota de 0 a 100 e como o sistema escolhe os nomes do Nome Social, do Nome Artístico e do Nome do Bebê.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/analise-gratuita"
              data-cta-id="como_calculamos_analise_gratuita"
              data-cta-position="como_calculamos_hero"
              class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#D4AF37] hover:bg-[#f2ca50] px-8 py-3.5 text-base font-semibold text-[#1A1A1A] shadow-lg shadow-[#D4AF37]/20 transition-colors duration-500"
            >
              Ver a nota do meu nome grátis
            </a>
            <a
              href="/glossario"
              data-cta-id="como_calculamos_glossario"
              data-cta-position="como_calculamos_hero"
              class="inline-flex min-h-12 items-center justify-center rounded-full bg-white/5 hover:bg-white/10 px-8 py-3.5 text-base font-medium text-[#e5e2e1] transition-colors duration-500"
            >
              Consultar o glossário
            </a>
          </div>
          <p class="nm-caption mt-4">Mesmo nome e mesma data dão sempre a mesma nota</p>
        </div>
      </div>
    </section>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 md:px-10">
      <div class="space-y-6 sm:space-y-10 text-[#e5e2e1]">

        {/* 0. O método em 5 passos */}
        <section class="space-y-6">
          <div class="text-center">
            <p class="nm-eyebrow mb-3">O Método</p>
            <h2 class="nm-h2">Do nome à nota em 5 passos</h2>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            {PASSOS.map((p) => (
              <div class={p.n === '5' ? 'nm-floating-card p-5 sm:p-6 sm:col-span-2' : 'nm-floating-card p-5 sm:p-6'}>
                <p class="text-[#f2ca50] font-cinzel font-bold text-sm mb-1">Passo {p.n}</p>
                <h3 class="nm-h4 mb-2">{p.titulo}</h3>
                <p class="nm-body">{p.texto}</p>
              </div>
            ))}
          </div>
          <div class="nm-floating-card p-5 sm:p-6">
            <h3 class="nm-h4 mb-3 text-center">A tabela cabalística das letras</h3>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
              {TABELA_LETRAS.map((t) => (
                <div class="rounded-xl bg-white/[0.03] px-3 py-3 text-center">
                  <span class="font-cinzel text-xl font-bold text-[#f2ca50] block">{t.valor}</span>
                  <span class="text-xs text-gray-300 tracking-wide">{t.letras}</span>
                </div>
              ))}
            </div>
            <h4 class="nm-h4 text-center mt-6 mb-3">E os acentos?</h4>
            <p class="nm-caption text-center mb-3 max-w-[62ch] mx-auto">Cada acento muda o valor da letra. O Ç vale 6 e não recebe acento.</p>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
              {ACENTOS.map((a) => (
                <div class={a.nome === 'Apóstrofo' ? 'rounded-xl bg-white/[0.03] px-3 py-3 text-center col-span-2 sm:col-span-1' : 'rounded-xl bg-white/[0.03] px-3 py-3 text-center'}>
                  <span class="font-cinzel text-xl font-bold text-[#bea5ff] block" aria-hidden="true">{a.sinal}</span>
                  <span class="text-xs text-gray-200 font-medium block">{a.nome}</span>
                  <span class="text-sm font-semibold text-[#f2ca50] block mt-0.5">{a.regra}</span>
                  <span class="text-[11px] text-gray-400 block mt-1">{a.exemplo}</span>
                </div>
              ))}
            </div>
            <p class="nm-caption text-center mt-4 max-w-[62ch] mx-auto">
              O acento agudo (+2) também aparece em outros materiais de numerologia cabalística em português. Os demais valores (til, circunflexo, grave, trema, anel e apóstrofo) são a convenção do método: não existe uma tabela clássica única para eles. Por isso deixamos cada valor aberto para você conferir.
            </p>
          </div>
          <div>
            <LetterNumberExample client:visible />
          </div>
        </section>

        {/* 1. Visão Geral */}
        <section class="nm-floating-card p-5 sm:p-8 space-y-4">
          <div class="flex items-start sm:items-center gap-3">
            <span class="w-8 h-8 shrink-0 rounded-full bg-[#f2ca50]/10 border border-[#f2ca50]/30 flex items-center justify-center text-[#f2ca50] font-cinzel font-bold text-sm">1</span>
            <h2 class="font-cinzel text-lg sm:text-2xl font-bold text-[#f2ca50] leading-snug">Visão Geral e Ponto de Partida</h2>
          </div>
          <p class="text-gray-300 leading-relaxed text-sm sm:text-base text-left sm:text-justify [text-align-last:left]">
            Toda avaliação começa com uma pontuação base de <strong class="text-[#f2ca50]">{cfg.base} pontos</strong>. A partir dessa base inicial, são analisadas tensões estruturais, repetições excessivas ou ausências vibracionais no nome. Cada categoria possui limites específicos para que nenhum fator isolado descaracterize a totalidade do mapa.
          </p>
          <p class="text-gray-400 leading-relaxed text-sm text-left sm:text-justify [text-align-last:left]">
            O resultado final respeita um piso mínimo absoluto de <strong class="text-gray-200">{cfg.piso} pontos</strong>, garantindo que o mapa expresse sempre uma graduação comparativa fiel à sua essência.
          </p>
        </section>

        {/* 2. Triângulo da Vida */}
        <section class="nm-floating-card p-5 sm:p-8 space-y-4">
          <div class="flex items-start sm:items-center gap-3">
            <span class="w-8 h-8 shrink-0 rounded-full bg-[#f2ca50]/10 border border-[#f2ca50]/30 flex items-center justify-center text-[#f2ca50] font-cinzel font-bold text-sm">2</span>
            <h2 class="font-cinzel text-lg sm:text-2xl font-bold text-[#f2ca50] leading-snug">Triângulo da Vida e Leituras Complementares</h2>
          </div>
          <p class="text-gray-300 leading-relaxed text-sm sm:text-base text-left sm:text-justify [text-align-last:left]">
            O cálculo principal é o <strong>Triângulo da Vida</strong>, a pirâmide formada pelas letras do nome. É ele que entra na nota e na regra das sugestões, e é ele que você vê na tela do seu resumo. Os triângulos <strong>Pessoal</strong>, <strong>Social</strong> e do <strong>Destino</strong> aparecem no seu PDF como leitura complementar, uma informação extra. Eles também alimentam duas pontas do Mapa de Alinhamento (o Social, o Magnetismo Social; o Pessoal, o Equilíbrio da Alma), que não muda a nota.
          </p>
          <ul class="space-y-3 text-sm text-gray-300 leading-relaxed pl-3 sm:pl-4 border-l border-[#f2ca50]/20">
            <li>
              • <strong class="text-white">Triângulo da Vida (Entra no Score):</strong> É a pirâmide pura formada pelas letras do nome. Sequências repetidas de 3 ou mais números idênticos (como 111, 222, até 999) geram um desconto de <strong>-{cfg.sequenciasVida.porCodigoDistinto} pontos</strong> por código distinto presente.
            </li>
            <li>
              • <strong class="text-white">Ocorrências Adicionais:</strong> Se um mesmo código se repetir em linhas adicionais, adiciona-se <strong>-{cfg.sequenciasVida.porLinhaExtraMesmoCodigo} pontos</strong> por linha extra (com teto de <strong>-{cfg.sequenciasVida.maxExtraPorCodigo} pontos</strong> extras por código).
            </li>
            <li>
              • <strong class="text-white">Teto da Categoria:</strong> O desconto acumulado por sequências no Triângulo da Vida nunca ultrapassa <strong>-{cfg.sequenciasVida.tetoCategoria} pontos</strong>.
            </li>
            <li>
              • <strong class="text-white">Triângulos Pessoal, Social e Destino (Leitura Complementar):</strong> Esses triângulos combinam as letras com o dia e o mês de nascimento. Padrões repetidos neles são apresentados como reflexos complementares e <strong>não descontam pontos no score do nome</strong> (teto 0).
            </li>
          </ul>
        </section>

        {/* 3. Alinhamento Expressão x Destino */}
        <section class="nm-floating-card p-5 sm:p-8 space-y-4">
          <div class="flex items-start sm:items-center gap-3">
            <span class="w-8 h-8 shrink-0 rounded-full bg-[#f2ca50]/10 border border-[#f2ca50]/30 flex items-center justify-center text-[#f2ca50] font-cinzel font-bold text-sm">3</span>
            <h2 class="font-cinzel text-lg sm:text-2xl font-bold text-[#f2ca50] leading-snug">Alinhamento Expressão × Destino</h2>
          </div>
          <p class="text-gray-300 leading-relaxed text-sm sm:text-base text-left sm:text-justify [text-align-last:left]">
            O número de <strong>Expressão</strong> (soma de todas as letras do nome) representa como você projeta sua energia no mundo, enquanto o número de <strong>Destino</strong> (soma dos dígitos da data de nascimento) é a sua estrada de vida imutável.
          </p>
          <div class="grid sm:grid-cols-3 gap-4 pt-2">
            <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20">
              <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider block mb-1">Harmônica / Favorável</span>
              <span class="font-cinzel text-xl font-bold text-emerald-300">0 pts</span>
              <p class="text-xs text-gray-400 mt-2">Mesma vibração essencial ou complementaridade ideal.</p>
            </div>
            <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/20">
              <span class="text-xs font-semibold text-amber-400 uppercase tracking-wider block mb-1">Neutra</span>
              <span class="font-cinzel text-xl font-bold text-amber-300">-{cfg.compatibilidade.neutro} pts</span>
              <p class="text-xs text-gray-400 mt-2">Relacionamento equilibrado que não gera atritos de base.</p>
            </div>
            <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20">
              <span class="text-xs font-semibold text-red-400 uppercase tracking-wider block mb-1">Tensão Vibracional</span>
              <span class="font-cinzel text-xl font-bold text-red-300">-{cfg.compatibilidade.desfavoravel} pts</span>
              <p class="text-xs text-gray-400 mt-2">Polaridades opostas que demandam adaptação consciente (teto de {cfg.compatibilidade.tetoCategoria} pts).</p>
            </div>
          </div>
        </section>

        {/* 4. Débitos Kármicos */}
        <section class="nm-floating-card p-5 sm:p-8 space-y-4">
          <div class="flex items-start sm:items-center gap-3">
            <span class="w-8 h-8 shrink-0 rounded-full bg-[#f2ca50]/10 border border-[#f2ca50]/30 flex items-center justify-center text-[#f2ca50] font-cinzel font-bold text-sm">4</span>
            <h2 class="font-cinzel text-lg sm:text-2xl font-bold text-[#f2ca50] leading-snug">Débitos Kármicos do Nome vs. Marca da Sua Data</h2>
          </div>
          <p class="text-gray-300 leading-relaxed text-sm sm:text-base text-left sm:text-justify [text-align-last:left]">
            Na tradição cabalística, os números 13, 14, 16 e 19 representam débitos kármicos (aprendizados de responsabilidade, moderação, desapego e liderança generosa). Nosso método separa rigorosamente a origem dessas vibrações:
          </p>
          <div class="space-y-3 pt-2 text-sm">
            <div class="p-4 rounded-xl bg-white/[0.03] border border-white/10">
              <h3 class="font-semibold text-[#f2ca50] mb-1">Débitos Originados no Nome (Entram no Score)</h3>
              <p class="text-gray-300">
                Quando a vibração surge nos números de <strong>Expressão</strong> ou <strong>Motivação</strong> do nome, aplica-se um desconto de <strong>-{cfg.debitos.porFonteNome} pontos</strong> por fonte ativa. Se o débito se repetir em duas ou mais fontes simultâneas no nome, aplica-se adicional de <strong>-{cfg.debitos.acentuada} pontos</strong>, com teto de categoria fixado em <strong>-{cfg.debitos.tetoCategoria} pontos</strong>. Esses débitos podem ser aliviados ou resolvidos pela escolha do Nome Social.
              </p>
            </div>
            <div class="p-4 rounded-xl bg-purple-500/10 border border-purple-500/20">
              <h3 class="font-semibold text-purple-300 mb-1">Marca da Sua Data (Não Desconta do Nome)</h3>
              <p class="text-gray-300">
                Débitos oriundos do <strong>dia de nascimento</strong> (dias 13, 14, 16 ou 19) ou do número de <strong>Destino</strong> são âncoras permanentes da sua data de nascimento. Eles <strong>não sofrem desconto no score do nome</strong> (desconto 0), pois são aprendizados da alma que nenhuma mudança de nome pode ou deve apagar.
              </p>
            </div>
          </div>
        </section>

        {/* 5. Tendências Ocultas */}
        <section class="nm-floating-card p-5 sm:p-8 space-y-4">
          <div class="flex items-start sm:items-center gap-3">
            <span class="w-8 h-8 shrink-0 rounded-full bg-[#f2ca50]/10 border border-[#f2ca50]/30 flex items-center justify-center text-[#f2ca50] font-cinzel font-bold text-sm">5</span>
            <h2 class="font-cinzel text-lg sm:text-2xl font-bold text-[#f2ca50] leading-snug">Tendências Ocultas (Excessos)</h2>
          </div>
          <p class="text-gray-300 leading-relaxed text-sm sm:text-base text-left sm:text-justify [text-align-last:left]">
            Ocorrem quando uma determinada vibração numérica (de 1 a 8) aparece repetida quatro ou mais vezes nas letras do seu nome de nascimento. Representa uma qualidade que, por excesso de intensidade, pode gerar padrões compulsivos ou desequilíbrio:
          </p>
          <p class="text-gray-400 text-sm">
            Cada tendência oculta identificada desconta <strong>-{cfg.tendenciasOcultas.porItem} pontos</strong>, com teto máximo da categoria de <strong>-{cfg.tendenciasOcultas.tetoCategoria} pontos</strong>.
          </p>
        </section>

        {/* 6. Lições Kármicas */}
        <section class="nm-floating-card p-5 sm:p-8 space-y-4">
          <div class="flex items-start sm:items-center gap-3">
            <span class="w-8 h-8 shrink-0 rounded-full bg-[#f2ca50]/10 border border-[#f2ca50]/30 flex items-center justify-center text-[#f2ca50] font-cinzel font-bold text-sm">6</span>
            <h2 class="font-cinzel text-lg sm:text-2xl font-bold text-[#f2ca50] leading-snug">Lições Kármicas (Ausências)</h2>
          </div>
          <p class="text-gray-300 leading-relaxed text-sm sm:text-base text-left sm:text-justify [text-align-last:left]">
            Identificam os números de 1 a 8 que não aparecem em nenhuma letra do seu nome de nascimento. Representam virtudes ou recursos que a alma veio desenvolver conscientemente nesta encarnação:
          </p>
          <p class="text-gray-400 text-sm">
            Cada lição kármica pendente desconta <strong>-{cfg.licoesCarmicas.porItem} pontos</strong>, com teto máximo da categoria de <strong>-{cfg.licoesCarmicas.tetoCategoria} pontos</strong>.
          </p>
        </section>

        {/* 7. As 5 Faixas de Nível e Seu Potencial */}
        <section class="nm-floating-card p-5 sm:p-8 space-y-6">
          <div class="flex items-start sm:items-center gap-3">
            <span class="w-8 h-8 shrink-0 rounded-full bg-[#f2ca50]/10 border border-[#f2ca50]/30 flex items-center justify-center text-[#f2ca50] font-cinzel font-bold text-sm">7</span>
            <h2 class="font-cinzel text-lg sm:text-2xl font-bold text-[#f2ca50] leading-snug">As 5 Faixas de Nível e Seu Potencial</h2>
          </div>
          <p class="text-gray-300 leading-relaxed text-sm sm:text-base text-left sm:text-justify [text-align-last:left]">
            A pontuação final resultante (entre 5 e 100) é classificada em cinco níveis oficiais:
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-5 gap-2.5 sm:gap-3 pt-1">
            <div class="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-center">
              <span class="text-xs font-bold text-emerald-400 block mb-1">N5</span>
              <span class="text-xs text-white font-medium block">Harmonioso</span>
              <span class="text-xs text-gray-400 mt-1 block">85 a 100</span>
            </div>
            <div class="p-3.5 rounded-xl bg-lime-500/10 border border-lime-500/30 text-center">
              <span class="text-xs font-bold text-lime-400 block mb-1">N4</span>
              <span class="text-xs text-white font-medium block">Favorável</span>
              <span class="text-xs text-gray-400 mt-1 block">70 a 84</span>
            </div>
            <div class="p-3.5 rounded-xl bg-yellow-500/10 border border-yellow-500/30 text-center">
              <span class="text-xs font-bold text-yellow-400 block mb-1">N3</span>
              <span class="text-xs text-white font-medium block">Equilíbrio Parcial</span>
              <span class="text-xs text-gray-400 mt-1 block">50 a 69</span>
            </div>
            <div class="p-3.5 rounded-xl bg-orange-500/10 border border-orange-500/30 text-center">
              <span class="text-xs font-bold text-orange-400 block mb-1">N2</span>
              <span class="text-xs text-white font-medium block">Pede Atenção</span>
              <span class="text-xs text-gray-400 mt-1 block">30 a 49</span>
            </div>
            <div class="col-span-2 sm:col-span-1 p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-center">
              <span class="text-xs font-bold text-red-400 block mb-1">N1</span>
              <span class="text-xs text-white font-medium block">Em Tensão</span>
              <span class="text-xs text-gray-400 mt-1 block">0 a 29</span>
            </div>
          </div>

          <div class="p-5 rounded-xl bg-[#222222] border border-white/10 space-y-2">
            <h3 class="font-cinzel text-base font-bold text-[#f2ca50]">O que é o "Seu Potencial"?</h3>
            <p class="text-gray-300 text-sm leading-relaxed">
              O indicador de <strong>Potencial</strong> calcula a maior pontuação teoricamente atingível a partir de variações legítimas do seu próprio nome e sobrenomes de família. Ele aponta até onde seu campo pode chegar após a remoção dos bloqueios do Triângulo da Vida e a harmonização de Expressão e Destino com o Nome Social.
            </p>
          </div>
        </section>

        {/* 8. Mapa de Alinhamento Vibracional (DEV-265) */}
        <section class="nm-floating-card p-5 sm:p-8 space-y-5">
          <div class="flex items-start sm:items-center gap-3">
            <span class="w-8 h-8 shrink-0 rounded-full bg-[#bea5ff]/10 border border-[#bea5ff]/30 flex items-center justify-center text-[#bea5ff] font-cinzel font-bold text-sm">8</span>
            <h2 class="font-cinzel text-lg sm:text-2xl font-bold text-[#bea5ff] leading-snug">Mapa de Alinhamento Vibracional</h2>
          </div>
          <p class="text-gray-300 leading-relaxed text-sm sm:text-base text-left sm:text-justify [text-align-last:left]">
            O score mostra a força do nome. O Mapa mostra para onde essa força aponta no seu momento. Ele cruza os números do nome com o que você respondeu no início: a área em que quer foco e onde vai usar a assinatura.
          </p>
          <p class="text-gray-400 leading-relaxed text-sm text-left sm:text-justify [text-align-last:left]">
            Cada ponta vai de 0% no centro a 100% no vértice. Quanto mais perto da ponta, mais aquele aspecto está alinhado. Ao escolher uma sugestão, o desenho do nome harmonizado aparece por cima do nome de nascimento, na cor do nível da nota, e cada ponta mostra quanto subiu ou desceu.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
            <div class="p-4 rounded-xl bg-white/[0.03]">
              <h3 class="font-semibold text-[#f2ca50] mb-1">Foco do Momento</h3>
              <p class="text-gray-400 leading-relaxed">Afinidade do número de Expressão com a área que você escolheu. Bloqueios do Triângulo da Vida ligados a esse tema reduzem a ponta.</p>
            </div>
            <div class="p-4 rounded-xl bg-white/[0.03]">
              <h3 class="font-semibold text-[#f2ca50] mb-1">Fluidez</h3>
              <p class="text-gray-400 leading-relaxed">Chega a 100% quando o Triângulo da Vida não tem sequências repetidas. Cada bloqueio ativo reduz o fluxo.</p>
            </div>
            <div class="p-4 rounded-xl bg-white/[0.03]">
              <h3 class="font-semibold text-[#f2ca50] mb-1">Sintonia de Destino</h3>
              <p class="text-gray-400 leading-relaxed">Relação formal entre Expressão e Destino: harmônica, neutra ou Tensão Vibracional. A Missão pode reforçar a sintonia.</p>
            </div>
            <div class="p-4 rounded-xl bg-white/[0.03]">
              <h3 class="font-semibold text-[#f2ca50] mb-1">Magnetismo Social</h3>
              <p class="text-gray-400 leading-relaxed">Reflexos do Triângulo Social somados à vibração da Impressão no canal em que você vai assinar.</p>
            </div>
            <div class="p-4 rounded-xl bg-white/[0.03] sm:col-span-2">
              <h3 class="font-semibold text-[#f2ca50] mb-1">Equilíbrio da Alma</h3>
              <p class="text-gray-400 leading-relaxed">Ressonância da Motivação (as vogais do nome) com a Expressão, somada aos reflexos do Triângulo Pessoal. Metade de cada.</p>
            </div>
          </div>
          <p class="text-xs text-gray-500 leading-relaxed">
            O Mapa não muda o score. Ele é uma leitura complementar para ajudar você a escolher a assinatura que mais combina com o seu momento.
          </p>
        </section>

        {/* 9 a 12. Como escolhemos os nomes em cada caminho */}
        {CAMINHOS.map((c) => (
          <section id={c.id} class="nm-floating-card p-5 sm:p-8 space-y-4">
            <div class="flex items-start sm:items-center gap-3">
              <span class="w-8 h-8 shrink-0 rounded-full bg-[#f2ca50]/10 flex items-center justify-center text-[#f2ca50] font-cinzel font-bold text-sm">{c.n}</span>
              <h2 class="font-cinzel text-lg sm:text-2xl font-bold text-[#f2ca50] leading-snug">{c.titulo}</h2>
            </div>
            <p class="text-gray-300 leading-relaxed text-sm sm:text-base" set:html={c.intro.replace(/\*\*(.+?)\*\*/g, '<strong class="text-white">$1</strong>')} />
            <ul class="space-y-3 text-sm text-gray-300 leading-relaxed">
              {c.itens.map((i) => (
                <li class="flex gap-2.5">
                  <span class="text-[#D4AF37] shrink-0" aria-hidden="true">✦</span>
                  <span set:html={i.replace(/\*\*(.+?)\*\*/g, '<strong class="text-white">$1</strong>')} />
                </li>
              ))}
            </ul>
            <p class="text-gray-400 text-sm leading-relaxed" set:html={c.fecho.replace(/\*\*(.+?)\*\*/g, '<strong class="text-gray-200">$1</strong>')} />
          </section>
        ))}

        {/* Aviso Legal */}
        <section class="p-6 rounded-2xl bg-[#1c1a17] border border-[#f2ca50]/20 text-center space-y-3">
          <span class="text-[#f2ca50] text-lg">✦</span>
          <h3 class="font-cinzel text-base font-bold text-[#f2ca50]">Aviso Importante</h3>
          <p class="text-xs sm:text-sm text-gray-400 max-w-2xl mx-auto leading-relaxed">
            {AVISO_AUTOCONHECIMENTO}
          </p>
        </section>

        {/* CTA */}
        <div class="text-center pt-4">
          <a
            href="/analise-gratuita"
            class="inline-flex items-center gap-2 bg-gradient-to-r from-[#f2ca50] to-[#d4af37] text-black font-bold px-8 py-3.5 rounded-full text-sm hover:opacity-95 transition-all shadow-lg shadow-[#f2ca50]/20"
          >
            <span>✦</span>
            <span>Ver a nota do meu nome grátis</span>
          </a>
        </div>

      </div>
    </div>
  </main>

  <LandingFooter client:load />
</LandingLayout>
