---
import LandingLayout from '../layouts/LandingLayout.astro';
import { LandingHeader } from '../frontend/components/landing/LandingHeader';
import { LandingFooter } from '../frontend/components/landing/LandingFooter';
import { PublicAnalysisForm } from '../frontend/components/landing/PublicAnalysisForm';
import { FreePdfPreviewScene } from '../frontend/components/landing/mockups/FreePdfPreviewScene';

const user = Astro.locals.user;

const REDIRECT_URL = '/app/analise-gratuita';
const LOGIN_URL = `/auth/login?redirect=${encodeURIComponent(REDIRECT_URL)}`;
---

<LandingLayout
  title="Análise Gratuita do Nome: Veja a Sua Nota"
  description="Descubra grátis a nota do seu nome pela Numerologia Cabalística, de 0 a 100, e receba um PDF com Triângulo da Vida, bloqueios e lições kármicas. Sem cartão."
  keywords="análise gratuita do nome, nota do nome, numerologia grátis, numerologia cabalística grátis, triângulo da vida, bloqueios no nome, lições kármicas"
>
  <LandingHeader client:load />

  <main class="bg-[#111111]">

    {/* ── HERO + FORMULÁRIO ── */}
    <section class="relative isolate overflow-hidden bg-[#111111] pt-[88px] sm:pt-28 lg:pt-32 pb-12 sm:pb-16">
      <div class="absolute inset-0 pointer-events-none z-0" aria-hidden="true">
        <div class="absolute inset-0 bg-gradient-to-br from-[#1a1400] via-[#111111] to-[#0d0d1a]"></div>
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[340px] h-[340px] sm:w-[560px] sm:h-[560px] lg:w-[760px] lg:h-[760px] bg-[#D4AF37]/15 rounded-full blur-[110px] sm:blur-[140px]"></div>
        <div class="absolute bottom-0 right-0 w-[300px] h-[300px] md:w-[500px] md:h-[500px] bg-purple-500/10 rounded-full blur-[100px]"></div>
      </div>

      <div class="relative z-10 max-w-[1440px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 lg:px-12 w-full min-w-0">
        <div class="max-w-2xl mx-auto text-center">
          <p class="nm-eyebrow mb-3">Análise gratuita</p>
          <h1 class="nm-h1">Descubra grátis a nota do seu nome</h1>
          <p class="nm-body-lg mt-5 mx-auto max-w-[56ch]">
            Digite o seu nome completo de nascimento e a sua data. Na hora, você vê a nota do seu nome de 0 a 100 e até onde ela pode chegar. Depois, recebe por e-mail um PDF gratuito com o Triângulo da Vida, os bloqueios encontrados, as suas lições kármicas e um arquétipo simbólico.
          </p>
          <ul class="mt-6 flex flex-col sm:flex-row sm:flex-wrap items-center sm:justify-center gap-x-6 gap-y-2">
            {[
              'Resultado na hora, sem cartão',
              'PDF gratuito no seu e-mail',
              'Uma análise gratuita por pessoa',
            ].map(item => (
              <li class="flex items-center gap-2 nm-caption">
                <span class="text-[#D4AF37] text-xs" aria-hidden="true">✦</span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="max-w-4xl mx-auto mt-10">
          <PublicAnalysisForm client:load />
        </div>
      </div>
    </section>

    {/* ── PRÉVIA DO PDF (páginas reais, exemplo fictício) ── */}
    <section class="py-12 sm:py-16 md:py-20">
      <div class="max-w-[1440px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 lg:px-12 w-full min-w-0">
        <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
          <div class="min-w-0 text-center lg:text-left">
            <p class="nm-eyebrow mb-3">O que chega no seu e-mail</p>
            <h2 class="nm-h2">Seu PDF gratuito, página por página</h2>
            <p class="nm-body-lg mt-4 max-w-[48ch] mx-auto lg:mx-0">
              Capa, o mapa do seu nome em 1 página e a leitura de como você está hoje, no mesmo layout do relatório completo.
            </p>
          </div>
          <div class="min-w-0 w-full max-w-[360px] mx-auto">
            <FreePdfPreviewScene client:visible />
          </div>
        </div>
      </div>
    </section>

    {/* ── O QUE O PDF TRAZ ── */}
    <section class="py-12 sm:py-16 md:py-20 animate-on-scroll">
      <div class="max-w-[1440px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 lg:px-12 w-full min-w-0">
        <div class="text-center mx-auto max-w-3xl">
          <p class="nm-eyebrow mb-3">No seu PDF</p>
          <h2 class="nm-h2">O que a sua análise gratuita mostra</h2>
        </div>
        <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5 max-w-5xl mx-auto">
          {[
            { icon: '◇', title: 'Nota de 0 a 100', desc: 'A nota do seu nome de nascimento hoje, a faixa em que ela está e até onde ela pode chegar com uma assinatura harmonizada.' },
            { icon: '△', title: 'Triângulo da Vida', desc: 'A leitura principal da Numerologia Cabalística: cada letra vira um número e mostra onde o seu nome flui e onde aparecem sequências repetidas.' },
            { icon: '⚠', title: 'Bloqueios', desc: 'Sequências de três ou mais números iguais, lidas pelo método como padrões simbólicos, com o tema de cada código explicado em linguagem simples.' },
            { icon: '☯', title: 'Lições kármicas', desc: 'Números ausentes no nome, lidos como qualidades a desenvolver, e tendências ocultas, quando um número se repete em excesso.' },
            { icon: '⬠', title: '5 números principais', desc: 'Expressão, Destino, Motivação, Impressão e Missão: o retrato numerológico do seu nome e da sua data.' },
            { icon: '✦', title: 'Arquétipo simbólico', desc: 'Uma leitura para explorar qualidades e pontos de atenção associados à sua análise.' },
          ].map(item => (
            <div class="nm-floating-card-interactive p-6 text-left">
              <p class="text-[#D4AF37] text-2xl mb-3" aria-hidden="true">{item.icon}</p>
              <h3 class="nm-h4 mb-2">{item.title}</h3>
              <p class="nm-body">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── PRÓXIMO PASSO ── */}
    <section class="pb-16 sm:pb-24 animate-on-scroll">
      <div class="max-w-[1440px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 lg:px-12 w-full min-w-0">
        <div class="nm-floating-card max-w-3xl mx-auto px-6 py-10 sm:px-10 text-center">
          <p class="nm-eyebrow mb-3">E depois da nota?</p>
          <h2 class="nm-h3 mb-3">Veja o seu nome sem bloqueios, com a nota lá em cima</h2>
          <p class="nm-body mb-6 mx-auto max-w-[58ch]">
            A análise completa abre um chat que conduz você até as versões do seu nome sem bloqueios: as 3 mais bem pontuadas para o seu perfil, mais 6 quando quiser e espaço para testar até 5 ideias suas. Inclui os triângulos Pessoal, Social e Destino e o PDF completo. Acesso imediato, pagamento único por 30 dias e garantia de 7 dias.
          </p>
          <a
            href="/nome-social"
            data-cta-id="nome_social"
            data-cta-position="analise_gratuita_final"
            class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#D4AF37] hover:bg-[#f2ca50] px-8 py-3.5 text-base font-semibold text-[#1A1A1A] shadow-lg shadow-[#D4AF37]/20 transition-colors duration-500"
          >
            Ver Meu Nome Sem Bloqueios
          </a>
        </div>
      </div>
    </section>

  </main>

  <LandingFooter client:load />
</LandingLayout>
