---
import LandingLayout from '../layouts/LandingLayout.astro';
import { LandingHeader } from '../frontend/components/landing/LandingHeader';
import { LandingFooter } from '../frontend/components/landing/LandingFooter';
import { getSupabaseFaqs } from '../backend/faqs/getSupabaseFaqs';
import type { FaqItemProps } from '../frontend/components/landing/FAQSection';
import { FAQSection } from '../frontend/components/landing/FAQSection';
import type { PriceInfo, ActivePromotion } from '../backend/payments/prices';
import { applyPricingPageCache, loadPagePricing } from '../backend/pricing/astro-pricing';
import { Price } from '../frontend/components/ui/Price';
import { promotionAppliesToProduct } from '../backend/payments/prices';

applyPricingPageCache(Astro);
import { LandingCheckout } from '../frontend/components/purchase/LandingCheckout';
import { HeroNomeSocial } from '../frontend/components/landing/HeroNomeSocial';
import { hasActiveSubscription } from '../backend/db/subscriptions';

const user = Astro.locals.user;

let isOwned = false;
if (user) {
  try {
    isOwned = await hasActiveSubscription(user.id, 'nome_social');
  } catch {
    isOwned = false;
  }
}

let faqItems: FaqItemProps[] = [];
try {
  faqItems = await getSupabaseFaqs({ featuredOnly: true });
} catch {
  // fallback silencioso
}

let hqPrices: Record<string, PriceInfo> | undefined;
let promotion: ActivePromotion | null = null;
try {
  const result = await loadPagePricing();
  hqPrices = result.prices;
  promotion = result.promotion;
} catch (err) {
  console.warn('[nome-social] Falha ao carregar preços:', err);
}

const EMPTY: PriceInfo = { cents: 0, formatted: '—', hasDiscount: false };
const prices = hqPrices ?? {};
function getPrice(id: string) { return prices[id] ?? EMPTY; }

function showDiscount(id: 'nome_social' | 'nome_bebe' | 'nome_empresa') {
  const p = getPrice(id);
  return !!(promotion && promotionAppliesToProduct(promotion, id) && p.hasDiscount && p.discountedFormatted);
}

const social = getPrice('nome_social');
const socialPriceProps = {
  product: 'nome_social' as const,
  baseFormatted: social.baseFormatted ?? social.formatted,
  finalFormatted: social.discountedFormatted ?? social.formatted,
  hasDiscount: showDiscount('nome_social'),
  validUntilLabel: social.validUntilLabel ?? null,
};

const schemaProduct = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Nome Social: Harmonização de Assinatura',
  description: 'Harmonização de assinatura pelo Nome Social: compare o nome de nascimento com variações de nome social, veja o ranking de candidatos, a nota de 0 a 100, os 5 números fundamentais, o Triângulo da Vida e leituras complementares, arcanos, bloqueios, débitos, lições kármicas e tendências ocultas.',
  url: 'https://www.nomemagnetico.com.br/nome-social',
  brand: { '@type': 'Brand', name: 'Nome Magnético' },
  offers: {
    '@type': 'Offer',
    price: (getPrice('nome_social').cents / 100).toFixed(2),
    priceCurrency: 'BRL',
    availability: 'https://schema.org/InStock',
    url: 'https://www.nomemagnetico.com.br/comprar?produto=nome_social',
  },
};

const schemaPrice = social.cents > 0 ? (social.cents / 100).toFixed(2) : undefined;
const displayFinal = social.discountedFormatted ?? social.formatted;
---

<LandingLayout
  title="Harmonização de Assinatura e Nome Social | Nome Magnético"
  description="Compare seu nome de nascimento e variações de nome social e veja a nota de cada assinatura. Leitura numerológica simbólica, com Triângulo da Vida e PDF."
  keywords="harmonização de assinatura, assinatura numerológica, numerologia do nome social, numerologia do nome completo, mudar nome numerologia, assinatura harmonizada, nome sem bloqueios, nome magnético numerologia, numerologia cabalística nome"
  schemaOfferPrice={schemaPrice}
  schemaEstimatedCost={schemaPrice}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaProduct)} />

  <LandingHeader client:load />

  <main class="bg-[#111111]">

    {/* ── HERO ── */}
    <section class="relative isolate overflow-hidden bg-[#111111] pt-[88px] sm:pt-28 lg:pt-32 pb-12 sm:pb-16 lg:pb-20">
      <div class="absolute inset-0 pointer-events-none z-0" aria-hidden="true">
        <div class="absolute inset-0 bg-gradient-to-br from-[#1a1400] via-[#111111] to-[#0d0d1a]"></div>
        <div class="absolute top-1/3 left-1/2 lg:left-[22%] -translate-x-1/2 -translate-y-1/2 w-[340px] h-[340px] sm:w-[560px] sm:h-[560px] lg:w-[760px] lg:h-[760px] bg-[#D4AF37]/15 rounded-full blur-[110px] sm:blur-[140px]"></div>
        <div class="absolute bottom-0 left-0 w-[300px] h-[300px] md:w-[500px] md:h-[500px] bg-purple-500/10 rounded-full blur-[100px]"></div>
      </div>
      <div class="relative z-10 max-w-[1440px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 lg:px-12 w-full min-w-0">
        <div class="max-w-[1120px] xl:max-w-[1280px] mx-auto grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-12 items-center text-center lg:text-left">
          <div class="flex flex-col items-center lg:items-start min-w-0">
            <p class="nm-eyebrow mb-3">Nome Social · {displayFinal}</p>
            <h1 class="nm-h1">
              Conheça seu nome e explore novas formas de assinatura
            </h1>
            <p class="nm-body-lg mt-5 md:mt-6 max-w-[56ch]">
              A análise Nome Social apresenta uma leitura numerológica do seu nome e permite conhecer variações de assinatura para comparar suas opções com mais clareza. Você vê o ranking dos candidatos, a nota de 0 a 100, os 5 números, o Triângulo da Vida como leitura principal, as leituras complementares e um arquétipo simbólico, tudo no PDF.
            </p>
            <div class="mt-8 w-full sm:w-auto flex flex-col sm:flex-row items-center gap-3">
              <LandingCheckout
                client:load
                product="nome_social"
                isLoggedIn={!!user}
                isOwned={isOwned}
                priceInfo={getPrice('nome_social')}
                promotion={promotion}
                label="Conhecer Minha Análise Completa"
                ctaId="nome_social_hero"
                ctaPosition="hero"
                className="w-full sm:w-auto text-center bg-[#D4AF37] text-[#1A1A1A] font-semibold text-base px-8 py-3.5 rounded-full hover:bg-[#f2ca50] transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] shadow-lg shadow-[#D4AF37]/20 cursor-pointer"
              />
              <a
                href="/analise-gratuita"
                data-cta-id="analise_gratis"
                data-cta-position="nome_social_hero"
                class="w-full sm:w-auto text-center rounded-full bg-white/5 hover:bg-white/10 px-8 py-3.5 text-base font-medium text-[#e5e2e1] transition-colors duration-500"
              >
                Ver Minha Nota Grátis
              </a>
            </div>
            <p class="nm-caption mt-4">Pagamento único · {displayFinal} · Acesso imediato · Garantia de 7 dias</p>
          </div>
          <div class="w-full min-w-0 flex justify-center">
            <HeroNomeSocial client:load />
          </div>
        </div>
      </div>
    </section>

    {/* ── CONTEXTO ── */}
    <section class="py-12 sm:py-16 md:py-20 animate-on-scroll">
      <div class="max-w-[1440px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 lg:px-12 w-full min-w-0">
        <div class="nm-floating-card max-w-4xl mx-auto px-6 py-8 sm:px-10 sm:py-10">
          <p class="nm-eyebrow mb-3">Momento de identidade</p>
          <h2 class="nm-h3 mb-4">O Brasil está atualizando a identidade. E a sua assinatura?</h2>
          <p class="nm-body mb-4">
            Com a Carteira de Identidade Nacional, a identificação brasileira entra em uma nova fase: CPF como número único, documento físico e digital e dados mais padronizados. O RG antigo segue válido até 2032, então não existe pressa documental.
          </p>
          <p class="nm-body">
            Para quem quer conhecer melhor o próprio nome, esse é um bom momento para olhar também a assinatura que você usa em cadastros, redes, contratos, crachás e apresentações. O Nome Social não altera documentos nem o registro civil: é uma leitura numerológica simbólica, para você comparar opções e escolher com mais consciência.
          </p>
        </div>
      </div>
    </section>

    {/* ── BLOQUEIOS ── */}
    <section class="py-12 sm:py-16 md:py-20 animate-on-scroll">
      <div class="max-w-[1440px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 lg:px-12 w-full min-w-0">
        <div class="text-center mx-auto max-w-3xl">
          <p class="nm-eyebrow mb-3">Leitura do método</p>
          <h2 class="nm-h2">O que é um bloqueio no nome?</h2>
          <p class="nm-body-lg mt-5 mx-auto max-w-[60ch]">
            Cada letra do nome vira um número. Quando o mesmo número aparece três ou mais vezes em sequência no Triângulo da Vida, o método lê isso como um bloqueio: um padrão simbólico associado a um tema. É uma leitura de autoconhecimento, não uma previsão.
          </p>
        </div>
        <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5 max-w-5xl mx-auto">
          {[
            { numero: '333', titulo: 'Expressão', desc: 'Tema simbólico de comunicação, criatividade e posicionamento.' },
            { numero: '444', titulo: 'Estruturação', desc: 'Tema simbólico de organização, método e construção de base.' },
            { numero: '555', titulo: 'Liberdade', desc: 'Tema simbólico de mudança, movimento e desapego de padrões.' },
            { numero: '666', titulo: 'Harmonia', desc: 'Tema simbólico de equilíbrio, cuidado e convivência.' },
            { numero: '888', titulo: 'Poder e Abundância', desc: 'Tema simbólico de realização, recursos e reconhecimento.' },
            { numero: '999', titulo: 'Compaixão Universal', desc: 'Tema simbólico de encerramento de ciclos e entrega.' },
          ].map(b => (
            <div class="nm-floating-card-interactive p-6 text-left">
              <p class="font-cinzel text-3xl font-bold text-[#D4AF37] mb-2">{b.numero}</p>
              <h3 class="nm-h4 mb-2">{b.titulo}</h3>
              <p class="nm-body">{b.desc}</p>
            </div>
          ))}
        </div>
        <p class="nm-caption text-center mt-8 max-w-2xl mx-auto">
          A análise completa verifica os 9 códigos (111 a 999) no Triângulo da Vida, a leitura principal, e traz os triângulos Pessoal, Social e Destino como leituras complementares.
        </p>
      </div>
    </section>

    {/* ── COMO FUNCIONA ── */}
    <section class="py-12 sm:py-16 md:py-20 animate-on-scroll">
      <div class="max-w-[1440px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 lg:px-12 w-full min-w-0">
        <div class="text-center mx-auto max-w-3xl">
          <p class="nm-eyebrow mb-3">Processo</p>
          <h2 class="nm-h2">Como funciona a análise</h2>
        </div>
        <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5 max-w-6xl mx-auto">
          {[
            { n: '01', t: 'Seu nome de nascimento', d: 'Lemos o nome e a data para calcular Expressão, Destino, Motivação, Impressão e Missão.' },
            { n: '02', t: 'Triângulo da Vida', d: 'É a leitura principal. Pessoal, Social e Destino aparecem como leituras complementares, com arcanos e um arquétipo simbólico.' },
            { n: '03', t: 'Ranking de assinaturas', d: 'Comparamos o seu nome e as sugestões em uma lista ordenada por nota, compatibilidade e ausência de bloqueios.' },
            { n: '04', t: 'Opções para testar', d: 'Você recebe 3 sugestões por rodada, até 9, e pode comparar no uso social, profissional e digital.' },
          ].map(s => (
            <div class="nm-floating-card p-6 text-left">
              <p class="font-cinzel text-4xl font-bold text-[#D4AF37]/40 mb-3">{s.n}</p>
              <h3 class="nm-h4 mb-2">{s.t}</h3>
              <p class="nm-body">{s.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── O QUE VOCÊ ACESSA ── */}
    <section class="py-12 sm:py-16 md:py-20 animate-on-scroll">
      <div class="max-w-[1440px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 lg:px-12 w-full min-w-0">
        <div class="text-center mx-auto max-w-3xl">
          <p class="nm-eyebrow mb-3">Incluído na análise</p>
          <h2 class="nm-h2">O PDF completo da sua análise</h2>
          <p class="nm-body-lg mt-5 mx-auto max-w-[58ch]">
            Um relatório para baixar, consultar e comparar suas opções sempre que precisar.
          </p>
        </div>
        <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5 max-w-6xl mx-auto">
          {[
            { icon: '◎', titulo: 'Ranking das assinaturas', desc: 'Os nomes avaliados da maior para a menor nota, com a recomendação principal.' },
            { icon: '◇', titulo: 'Nota de 0 a 100', desc: 'Pontuação objetiva por bloqueios, débitos, tendências, lições e compatibilidade entre Expressão e Destino.' },
            { icon: '⬠', titulo: '5 números principais', desc: 'Expressão, Destino, Motivação, Impressão e Missão com leitura aplicada ao seu caso.' },
            { icon: '△', titulo: 'Triângulo da Vida e leituras complementares', desc: 'A Vida é a leitura principal. Pessoal, Social e Destino complementam, cada um com a sua interpretação simbólica.' },
            { icon: '✦', titulo: 'Arcanos e arquétipo', desc: 'Arcanos por triângulo e uma leitura simbólica para explorar qualidades e pontos de atenção associados à sua análise.' },
            { icon: '⚠', titulo: 'Bloqueios e débitos', desc: 'Sequências repetidas e débitos kármicos mapeados com clareza, em linguagem simbólica.' },
            { icon: '☯', titulo: 'Lições e tendências', desc: 'Números ausentes (lições kármicas) e números em excesso (tendências ocultas) no seu nome.' },
            { icon: '✎', titulo: 'Sugestões de assinatura', desc: 'Variações sem bloqueios, cada uma com nota de 0 a 100: 3 por rodada, até 9.' },
            { icon: '⬇', titulo: 'PDF para consultar', desc: 'Baixe e revise quando quiser.' },
          ].map(c => (
            <div class="nm-floating-card-interactive p-6 text-left">
              <p class="text-[#D4AF37] text-2xl mb-3" aria-hidden="true">{c.icon}</p>
              <h3 class="nm-h4 mb-2">{c.titulo}</h3>
              <p class="nm-body">{c.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── GRÁTIS ANTES ── */}
    <section class="py-12 sm:py-16 md:py-20 animate-on-scroll">
      <div class="max-w-[1440px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 lg:px-12 w-full min-w-0">
        <div class="nm-floating-card max-w-3xl mx-auto px-6 py-10 sm:px-10 text-center">
          <p class="nm-eyebrow mb-3">Antes de decidir</p>
          <h2 class="nm-h3 mb-3">Conheça a nota do seu nome, sem custo</h2>
          <p class="nm-body mb-6 mx-auto max-w-[56ch]">
            Digite seu nome de nascimento e sua data. Você vê a nota de hoje, até onde ela pode chegar e recebe um PDF com a sua leitura.
          </p>
          <a
            href="/analise-gratuita"
            data-cta-id="analise_gratis"
            data-cta-position="nome_social_meio"
            class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#D4AF37] hover:bg-[#f2ca50] px-8 py-3.5 text-base font-semibold text-[#1A1A1A] shadow-lg shadow-[#D4AF37]/20 transition-colors duration-500"
          >
            Conheça a Nota do Seu Nome
          </a>
        </div>
      </div>
    </section>

    {/* ── FAQ ── */}
    {faqItems.length > 0 && (
      <FAQSection items={faqItems} client:visible />
    )}

    {/* ── GARANTIA ── */}
    <section class="py-12 sm:py-16 animate-on-scroll">
      <div class="max-w-[1440px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 lg:px-12 w-full min-w-0">
        <div class="nm-floating-card max-w-2xl mx-auto px-6 py-8 sm:px-10 text-center">
          <h3 class="nm-h3 mb-3">Garantia de 7 dias</h3>
          <p class="nm-body mx-auto max-w-[52ch]">
            Se por qualquer motivo você não ficar satisfeito com a análise, devolvemos 100% do valor, sem burocracia.
          </p>
        </div>
      </div>
    </section>

    {/* ── CTA FINAL ── */}
    <section class="py-16 sm:py-20 animate-on-scroll">
      <div class="max-w-xl mx-auto px-4 sm:px-6 text-center">
        <p class="nm-eyebrow mb-3">Investimento</p>
        <h2 class="nm-h2 mb-4">Explore as opções da sua assinatura</h2>
        <div class="mb-2 flex justify-center">
          <Price client:visible {...socialPriceProps} size="card" />
        </div>
        <p class="nm-body mb-8">Pagamento único · Acesso por 30 dias · Análise na hora</p>
        <LandingCheckout
          client:load
          product="nome_social"
          isLoggedIn={!!user}
          isOwned={isOwned}
          priceInfo={getPrice('nome_social')}
          promotion={promotion}
          label="Conhecer Minha Análise Completa"
          ctaId="nome_social_final"
          ctaPosition="cta_final"
          className="block w-full text-center bg-[#D4AF37] text-[#1A1A1A] font-semibold text-base px-8 py-3.5 rounded-full hover:bg-[#f2ca50] transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] shadow-lg shadow-[#D4AF37]/20 cursor-pointer"
        />
        <p class="nm-caption mt-5">Pagamento seguro via Stripe · Garantia de 7 dias · Acesso imediato</p>
      </div>
    </section>

  </main>

  <LandingFooter client:visible />
</LandingLayout>
