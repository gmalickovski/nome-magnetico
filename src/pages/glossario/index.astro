---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LandingHeader } from '../../frontend/components/landing/LandingHeader';
import { LandingFooter } from '../../frontend/components/landing/LandingFooter';
import { GlossaryExplorer } from '../../frontend/components/glossary/GlossaryExplorer';
import { listPublishedGlossaryTerms } from '../../backend/glossary/glossary-service';

const terms = await listPublishedGlossaryTerms();
const explorerTerms = terms.map((item) => ({
  slug: item.slug,
  term: item.term,
  category: item.category,
  shortSummary: item.shortSummary,
  relatedNumber: item.relatedNumber,
  tags: item.tags,
}));
---

<BaseLayout
  title="Glossário de Numerologia Cabalística | Nome Magnético"
  description="Dicionário dinâmico completo de numerologia cabalística: número de expressão, destino, o Triângulo da Vida, bloqueios energéticos, lições e débitos kármicos."
  keywords="glossário numerologia cabalística, termos numerologia, número de expressão, número de destino, triângulo da vida, bloqueios energéticos"
>
  <LandingHeader client:load />

  <main class="min-h-screen bg-[#131313] pt-28 pb-16 md:pt-32 md:pb-24">
    <section class="mx-auto max-w-[1440px] px-6 md:px-10 lg:px-12 pb-8">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-[#f2ca50]">
            Referência Técnica
          </p>
          <h1 class="font-cinzel text-3xl font-bold leading-tight text-[#e5e2e1] sm:text-4xl">
            Glossário de Numerologia Cabalística
          </h1>
          <p class="mt-3 text-sm leading-relaxed text-[#A0A0A0] sm:text-base">
            Explore todos os conceitos, números, pirâmides e bloqueios utilizados nas análises do Nome Magnético.
          </p>
        </div>

        <a
          href="/analise-gratuita"
          class="inline-flex shrink-0 items-center justify-center rounded-full bg-[#D4AF37] px-6 py-3 text-xs font-bold uppercase tracking-wider text-[#131313] shadow-[0_2px_16px_rgba(212,175,55,0.3)] transition hover:bg-[#f2ca50]"
        >
          Analisar meu nome grátis →
        </a>
      </div>
    </section>

    <section class="mx-auto max-w-[1440px] px-6 md:px-10 lg:px-12">
      <GlossaryExplorer client:load terms={explorerTerms} baseHref="/glossario" />
    </section>
  </main>

  <LandingFooter client:visible />
</BaseLayout>
