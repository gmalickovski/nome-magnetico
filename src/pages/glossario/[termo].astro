---
import { resolveGlossaryRedirect } from '../../shared/glossary/canonical-terms';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LandingHeader } from '../../frontend/components/landing/LandingHeader';
import { LandingFooter } from '../../frontend/components/landing/LandingFooter';
import { GlossaryTermOverlay } from '../../frontend/components/glossary/GlossaryTermOverlay';
import {
  getGlossaryTermBySlug,
  listPublishedGlossaryTerms,
} from '../../backend/glossary/glossary-service';
import { GLOSSARY_CATEGORY_LABELS } from '../../shared/glossary/canonical-terms';
import { linkGlossaryTermsInHtml } from '../../shared/glossary/term-linker';
import { marked } from 'marked';

const { termo } = Astro.params;
if (!termo) {
  return Astro.redirect('/glossario', 301);
}

const redirectSlug = resolveGlossaryRedirect(termo);
if (redirectSlug) {
  return Astro.redirect(`/glossario/${redirectSlug}`, 301);
}

const resolved = await getGlossaryTermBySlug(termo);
if (!resolved) {
  return Astro.redirect('/glossario', 302);
}

const { term: termData, relatedTerms } = resolved;
const allTerms = await listPublishedGlossaryTerms();

marked.use({ gfm: true, breaks: false });
const rawContentHtml = await marked.parse(termData.definitionMarkdown || '');
const contentHtml = linkGlossaryTermsInHtml(
  rawContentHtml,
  allTerms.filter((item) => item.slug !== termData.slug),
  { baseHref: '/glossario' },
);

const siteUrl = 'https://nomemagnetico.com.br';
const canonicalUrl = `${siteUrl}/glossario/${termData.slug}`;

const schemaDefinedTerm = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: termData.term,
  description: termData.metaDescription ?? termData.shortSummary,
  url: canonicalUrl,
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: 'Glossário de Numerologia Cabalística — Nome Magnético',
    url: `${siteUrl}/glossario`,
  },
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Glossário', item: `${siteUrl}/glossario` },
    { '@type': 'ListItem', position: 3, name: termData.term, item: canonicalUrl },
  ],
};
---

<BaseLayout
  title={termData.metaTitle ?? `${termData.term} — O Que É na Numerologia Cabalística | Nome Magnético`}
  description={termData.metaDescription ?? termData.shortSummary}
  keywords={`o que é ${termData.term.toLowerCase()}, ${termData.term.toLowerCase()} numerologia, numerologia cabalística, ${(termData.tags ?? []).join(', ').toLowerCase()}`}
  noIndex={false}
  noIndexFollow={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaDefinedTerm)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />

  <LandingHeader client:load />

  <main class="min-h-screen bg-[#131313] pt-28 pb-16 md:pt-32 md:pb-24">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10 lg:px-12">
      <div class="mx-auto max-w-3xl">
        {/* Breadcrumb */}
        <nav aria-label="Navegação estrutural" class="mb-6 flex flex-wrap items-center gap-2 text-xs text-[#A0A0A0]">
          <a href="/" class="hover:text-[#f2ca50] transition-colors">Início</a>
          <span>/</span>
          <a href="/glossario" class="hover:text-[#f2ca50] transition-colors">Glossário</a>
          <span>/</span>
          <span class="text-[#e5e2e1] font-medium">{termData.term}</span>
        </nav>

        {/* Cabeçalho do termo */}
        <header class="nm-floating-card rounded-2xl p-6 sm:p-8 mb-8">
          <div class="flex flex-wrap items-center gap-2.5 mb-3">
            <span class="rounded-full bg-[#bea5ff]/15 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-[#d7c6ff]">
              {GLOSSARY_CATEGORY_LABELS[termData.category]}
            </span>
            {termData.relatedNumber != null && (
              <span class="rounded-full bg-[#D4AF37]/15 px-3 py-1 text-[11px] font-bold tabular-nums text-[#f2ca50]">
                Número {termData.relatedNumber}
              </span>
            )}
          </div>

          <h1 class="font-cinzel text-2xl sm:text-4xl font-bold leading-tight text-[#e5e2e1]">
            {termData.term}
          </h1>

          <p class="mt-4 text-base leading-relaxed text-[#e5e2e1]/85">
            {termData.shortSummary}
          </p>

          {termData.tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {termData.tags.map((tag) => (
                <span class="rounded-full bg-white/[0.05] px-3 py-1 text-xs text-[#A0A0A0]">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </header>

        {/* Definição detalhada */}
        <article class="prose prose-invert max-w-none prose-headings:font-cinzel prose-headings:text-[#f2ca50] prose-h3:text-xl prose-p:text-[#e5e2e1]/90 prose-p:leading-relaxed prose-strong:text-[#e5e2e1] prose-li:text-[#e5e2e1]/90 mb-12">
          <Fragment set:html={contentHtml} />
        </article>

        {/* CTA contextual */}
        <section class="nm-floating-card rounded-2xl p-6 sm:p-8 mb-12 text-center sm:text-left flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#f2ca50]">
              Diagnóstico Gratuito
            </p>
            <h2 class="mt-1 font-cinzel text-xl font-bold text-[#e5e2e1]">
              Descubra como isso aparece no seu nome
            </h2>
            <p class="mt-1.5 text-sm text-[#A0A0A0]">
              Veja o seu Triângulo da Vida, a nota atual e os bloqueios em segundos.
            </p>
          </div>
          <a
            href="/analise-gratuita"
            class="inline-flex shrink-0 items-center justify-center rounded-full bg-[#D4AF37] px-6 py-3 text-xs font-bold uppercase tracking-wider text-[#131313] hover:bg-[#f2ca50] transition"
          >
            Fazer análise gratuita →
          </a>
        </section>

        {/* Termos Relacionados */}
        {relatedTerms.length > 0 && (
          <section>
            <h2 class="mb-4 font-cinzel text-xl font-bold text-[#e5e2e1]">
              Conceitos Relacionados
            </h2>
            <div class="grid gap-3.5 sm:grid-cols-2">
              {relatedTerms.map((rel) => (
                <a
                  href={`/glossario/${rel.slug}`}
                  class="nm-floating-card block rounded-2xl p-4 transition hover:bg-[#202020] hover:ring-1 hover:ring-[#D4AF37]/40"
                >
                  <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#bea5ff]">
                    {GLOSSARY_CATEGORY_LABELS[rel.category]}
                  </p>
                  <h3 class="mt-1.5 font-cinzel text-base font-bold text-[#e5e2e1]">
                    {rel.term}
                  </h3>
                  <p class="mt-1 text-xs leading-relaxed text-[#A0A0A0] line-clamp-2">
                    {rel.shortSummary}
                  </p>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </main>

  <GlossaryTermOverlay client:load baseHref="/glossario" />
  <LandingFooter client:visible />
</BaseLayout>
