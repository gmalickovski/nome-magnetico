---
import BaseLayout from './BaseLayout.astro';
import { createUserClient } from '../backend/db/supabase';
import { memoize } from '../backend/cache/memo';
import AppDesktopHeader from '../frontend/components/app/AppDesktopHeader';
import AppSidebarLogout from '../frontend/components/app/AppSidebarLogout';
import AppMobileHeader from '../frontend/components/app/AppMobileHeader';
import AppMobileDock from '../frontend/components/app/AppMobileDock';
import ClientMessagePopup from '../frontend/components/app/ClientMessagePopup';
import { resolveMobileDockContext } from '../frontend/lib/mobile-dock-context.ts';
import {
  APP_CLIENT_NAV_HREFS,
  APP_CLIENT_NAV_LABELS,
  sidebarNavIconClass,
  sidebarNavLinkClass,
} from '../frontend/components/app/app-client-nav-shared.ts';
import AppSidebarNavIcons from '../frontend/components/app/AppSidebarNavIcons.astro';

export interface Props {
  title: string;
  description?: string;
  noPadding?: boolean;
  /** Shell full-viewport no mobile (chat): clearance fica no conteúdo interno, não no main. */
  mobileFullViewport?: boolean;
  /** Oculta o header desktop padrão quando a página usa header integrado próprio (ex.: chat). */
  hideDesktopHeader?: boolean;
}

const {
  title,
  description,
  noPadding = false,
  mobileFullViewport = false,
  hideDesktopHeader = false,
} = Astro.props;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login?redirect=' + encodeURIComponent(Astro.url.pathname));
}

let isAdmin = false;
let hasAnyActive = false;
let userNome = user.email?.split('@')[0] ?? '';
let isTest = false;
let testEndsAt: Date | null = null;
let hasPaidAnalysisHistory = false;

try {
  const client = createUserClient(Astro.locals.accessToken ?? '');
  const [profileRes, subsRes, paidAnalysesRes] = await Promise.all([
    client
      .from('profiles')
      .select('role, nome, is_test, test_ends_at')
      .eq('id', user.id)
      .single(),
    memoize<{ data: { product_type: string }[] | null }>(`user_subs:${user.id}`, 60 * 1000, async () => {
      const res = await client
        .from('subscriptions')
        .select('product_type')
        .eq('user_id', user.id)
        .gt('ends_at', new Date().toISOString());
      return { data: (res.data ?? []) as { product_type: string }[] };
    }),
    client
      .from('analyses')
      .select('id')
      .eq('user_id', user.id)
      .neq('product_type', 'analise_gratuita')
      .limit(1),
  ]);

  isAdmin = profileRes.data?.role === 'admin';
  if (profileRes.data?.nome) userNome = profileRes.data.nome;
  if (profileRes.data?.is_test) {
    const exp = profileRes.data.test_ends_at;
    isTest = exp === null || new Date(exp) > new Date();
    if (exp) testEndsAt = new Date(exp);
  }
  hasAnyActive = isAdmin || isTest || (subsRes.data?.length ?? 0) > 0;
  hasPaidAnalysisHistory = (paidAnalysesRes.data?.length ?? 0) > 0;
} catch { /* silencioso */ }

const showAnalisesNav = isAdmin || hasAnyActive || hasPaidAnalysisHistory;
const pathname = Astro.url.pathname;
const isActive = (path: string) =>
  pathname === path || pathname.startsWith(path + '/');
const navInicioActive = isActive('/app') && !isActive('/app/analise') && !isActive('/app/resultado') && !isActive('/app/analises') && !isActive('/app/suporte') && !isActive('/app/admin-analise') && !isActive('/app/sentry-test');
const navAnalisesActive = isActive('/app/analises') || isActive('/app/resultado');
const navGlossarioActive = isActive('/glossario');
const navSuporteActive = isActive('/app/suporte');
const mobileDockContext = resolveMobileDockContext(pathname);
---

<BaseLayout title={title} description={description} noIndex={true}>
  <script is:inline define:vars={{ analyticsUserId: isAdmin ? '' : user.id, analyticsEmail: isAdmin ? '' : (user.email ?? '') }}>
    function identifyNmUser() {
      if (!analyticsUserId) return;
      if (typeof window.nmIdentifyPostHog === 'function') {
        window.nmIdentifyPostHog(analyticsUserId, analyticsEmail);
        return;
      }
      window.__nm_pending_identify = { userId: analyticsUserId, email: analyticsEmail || '' };
    }
    identifyNmUser();
    window.addEventListener('nm-posthog-ready', identifyNmUser);
  </script>
  <div class:list={[
    'min-h-screen bg-[#1a1a1a] nm-app-shell--with-mobile-dock',
    { 'nm-app-shell--dock-action-only': mobileDockContext === 'action' },
  ]}>
    {false && isTest && (
      <div class="bg-[#D4AF37]/10 border-b border-[#D4AF37]/20 px-4 py-2 text-center text-sm text-[#D4AF37]">
        Você está usando um acesso de teste.
        {testEndsAt
          ? ` Válido até ${testEndsAt?.toLocaleDateString('pt-BR')}.`
          : ' Sem data de expiração.'}
        <a href="/comprar" class="underline font-medium ml-1 hover:text-[#f2ca50] transition-colors">
          Assinar agora
        </a>
      </div>
    )}

    <aside id="app-sidebar" class="group hidden lg:flex fixed inset-y-0 left-0 z-50 w-20 flex-col overflow-hidden border-r border-[#D4AF37]/15 bg-[#111111]/95 backdrop-blur-md px-4 pt-6 pb-7 transition-[width,box-shadow] duration-300 ease-out hover:w-60 focus-within:w-60 hover:shadow-[12px_0_40px_rgba(0,0,0,0.6)] focus-within:shadow-[12px_0_40px_rgba(0,0,0,0.6)]">
      <nav class="flex flex-col gap-2" aria-label="Navegação principal">
        <a href={APP_CLIENT_NAV_HREFS.inicio} class={sidebarNavLinkClass(navInicioActive)} aria-current={navInicioActive ? 'page' : undefined}>
          <AppSidebarNavIcons name="inicio" class={sidebarNavIconClass(navInicioActive)} />
          <span class="whitespace-nowrap opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100">{APP_CLIENT_NAV_LABELS.inicio}</span>
        </a>

        {showAnalisesNav ? (
          <a href={APP_CLIENT_NAV_HREFS.analises} class={sidebarNavLinkClass(navAnalisesActive)} aria-current={navAnalisesActive ? 'page' : undefined}>
            <AppSidebarNavIcons name="analises" class={sidebarNavIconClass(navAnalisesActive)} />
            <span class="whitespace-nowrap opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100">{APP_CLIENT_NAV_LABELS.analises}</span>
          </a>
        ) : (
          <div title="Disponível após adquirir um produto" class="relative flex h-12 min-h-[44px] cursor-not-allowed items-center gap-3 rounded-2xl px-3 text-sm font-semibold text-[#A0A0A0] opacity-60">
            <AppSidebarNavIcons name="analises" class="h-5 w-5 flex-shrink-0 text-[#A0A0A0]" />
            <span class="whitespace-nowrap opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100">{APP_CLIENT_NAV_LABELS.analises}</span>
            <svg class="ml-auto h-4 w-4 flex-shrink-0 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100 text-[#A0A0A0]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
          </div>
        )}

        <a href={APP_CLIENT_NAV_HREFS.glossario} class={sidebarNavLinkClass(navGlossarioActive)} aria-current={navGlossarioActive ? 'page' : undefined}>
          <AppSidebarNavIcons name="glossario" class={sidebarNavIconClass(navGlossarioActive)} />
          <span class="whitespace-nowrap opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100">{APP_CLIENT_NAV_LABELS.glossario}</span>
        </a>

        <a href={APP_CLIENT_NAV_HREFS.suporte} class={sidebarNavLinkClass(navSuporteActive)} aria-current={navSuporteActive ? 'page' : undefined}>
          <AppSidebarNavIcons name="suporte" class={sidebarNavIconClass(navSuporteActive)} />
          <span class="whitespace-nowrap opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100">{APP_CLIENT_NAV_LABELS.suporte}</span>
        </a>
      </nav>

      <div class="mt-auto flex flex-col gap-2 pt-4 border-t border-white/[0.06]">
        <a
          href="/blog"
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-12 min-h-[44px] items-center gap-3 rounded-2xl px-3 text-sm font-semibold text-[#A0A0A0] transition-all hover:bg-white/[0.03] hover:text-[#f2ca50]"
        >
          <svg class="h-5 w-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-.586-1.414l-4.5-4.5A2 2 0 0015.5 3H15m3 12h-3m3-4h-3m3-4h-3"></path></svg>
          <span class="whitespace-nowrap opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100">Blog</span>
        </a>
        <AppSidebarLogout client:load />
      </div>
    </aside>

    <AppMobileHeader client:load nome={userNome} isAdmin={isAdmin} />

    <AppMobileDock
      client:load
      pathname={pathname}
      isAdmin={isAdmin}
      showAnalisesNav={showAnalisesNav}
    />

    {!hideDesktopHeader && (
      <>
        <AppDesktopHeader client:load nome={userNome} isAdmin={isAdmin}>
          <slot name="header-actions" />
        </AppDesktopHeader>
        <div class="hidden lg:block h-14 shrink-0" aria-hidden="true"></div>
      </>
    )}

    <main class:list={[
      'nm-app-main lg:ml-20 overflow-x-hidden lg:pb-10',
      noPadding ? 'h-full overflow-x-hidden' : 'px-3.5 sm:px-6 md:px-10 lg:px-14 py-6 sm:py-8 md:py-10',
      mobileFullViewport ? 'nm-app-main--flush' : '',
    ]}>
      <div class={noPadding ? "h-full" : "max-w-[1440px] 2xl:max-w-[1600px] mx-auto w-full"}>
        <slot />
      </div>
    </main>

    <ClientMessagePopup client:load />
  </div>

</BaseLayout>

<style is:global>
  @media (min-width: 1024px) {
    .app-fixed-header {
      left: 5rem;
    }
  }
</style>

<script>
  import { recordAppNavigationPath } from '../frontend/lib/app-nav-back.ts';

  recordAppNavigationPath();
</script>


