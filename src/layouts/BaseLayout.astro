---
import { CookieBanner } from '../frontend/components/ui/CookieBanner';
import PostHog from '../components/posthog.astro';
import { getSentryRuntimeConfig } from '../sentry/env';
import { paidAttributionEnabled } from '../backend/analytics/paid-attribution';
import { readServerEnv } from '../backend/env/runtime';

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  noIndex?: boolean;
  noIndexFollow?: boolean;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  opsShell?: boolean;
}

const {
  title,
  description = 'Análise de numerologia cabalística: detecte os bloqueios energéticos no seu nome e descubra a variação que alinha Expressão ao Destino. Relatório completo com o Triângulo da Vida e leituras complementares.',
  keywords = 'numerologia cabalística, numerologia do nome, mapa numerológico, bloqueios energéticos nome, análise vibracional nome, nome magnético, significado do nome numerologia, nome sem bloqueios energéticos, como meu nome afeta minha vida, mudar nome numerologia',
  ogImage = '/og-image.jpg',
  ogType = 'website',
  noIndex = false,
  noIndexFollow = false,
  articlePublishedTime,
  articleModifiedTime,
  opsShell = false,
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL('https://www.nomemagnetico.com.br')).origin;
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${siteOrigin}${ogImage}`;
const robotsContent = noIndex || opsShell
  ? (noIndexFollow && !opsShell ? 'noindex, follow' : 'noindex, nofollow')
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';
// process.env lê em runtime da VPS — import.meta.env seria substituído em build-time pelo CI
const ga4MeasurementId = process.env.PUBLIC_GA4_MEASUREMENT_ID ?? '';
const paidAttribution = !opsShell && paidAttributionEnabled();
const metaPixelId = paidAttribution && Astro.url.pathname.replace(/\/$/, '') === '/analise-gratuita'
  ? readServerEnv('PUBLIC_META_PIXEL_ID')
  : undefined;
const sentry = getSentryRuntimeConfig();
---

<!DOCTYPE html>
<html lang="pt-BR" data-paid-attribution={paidAttribution ? '1' : '0'} data-ga4-id={ga4MeasurementId}>
  <head>
    <meta charset="UTF-8" />
    {sentry && <meta name="nm-sentry-dsn" content={sentry.dsn} />}
    {sentry && <meta name="nm-sentry-environment" content={sentry.environment} />}
    {sentry?.release && <meta name="nm-sentry-release" content={sentry.release} />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- Recarga resiliente de chunk desatualizado pós-deploy (DEV-209) -->
    <script is:inline>
      (function () {
        function nmSessionGet(key) {
          try {
            return sessionStorage.getItem(key);
          } catch (e) {
            return null;
          }
        }
        function nmSessionSet(key, value) {
          try {
            sessionStorage.setItem(key, value);
          } catch (e) {}
        }

        function reloadOnceOnChunkError() {
          var k = 'nm-chunk-reload';
          if (!nmSessionGet(k)) {
            nmSessionSet(k, String(Date.now()));
            location.reload();
          }
        }

        window.addEventListener('vite:preloadError', function (e) {
          e.preventDefault();
          reloadOnceOnChunkError();
        });

        window.addEventListener('unhandledrejection', function (e) {
          var m = String((e.reason && (e.reason.message || e.reason)) || '');
          if (/Failed to fetch dynamically imported module|Importing a module script failed|error loading dynamically imported module/i.test(m)) {
            reloadOnceOnChunkError();
          }
        });
      })();
    </script>

    <!-- SEO Primário -->
    <title>{title} | Nome Magnético</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robotsContent} />

    <!-- Geo (Brasil) -->
    <meta name="geo.region" content="BR" />
    <meta name="geo.placename" content="Brasil" />
    <meta name="language" content="Portuguese" />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | Nome Magnético`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} - Nome Magnético`} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Nome Magnético" />
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@nomemagnetico" />
    <meta name="twitter:creator" content="@nomemagnetico" />
    <meta name="twitter:title" content={`${title} | Nome Magnético`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <meta name="twitter:image:alt" content={`${title} - Nome Magnético`} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />
    <meta name="theme-color" content="#D4AF37" />
    <meta name="msapplication-TileColor" content="#1A1A1A" />

    <!-- Autor, Propriedade e E-E-A-T (Experience, Expertise, Authoritativeness, Trustworthiness) -->
    <meta name="author" content="Nome Magnético - Studio MLK" />
    <meta name="copyright" content="Nome Magnético" />
    <meta name="publisher" content="Studio MLK" />
    <!-- Sinais de conteúdo especializado para AI Overviews (Google SGE 2026) -->
    <meta name="subject" content="Numerologia Cabalística, Desenvolvimento Pessoal, Branding Pessoal" />
    <meta name="category" content="Ferramentas de Autoconhecimento" />
    <meta name="coverage" content="Brasil" />
    <meta name="rating" content="general" />

    <!-- Performance: Preconnect + DNS prefetch (Core Web Vitals 2026) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <!-- DNS prefetch para serviços externos — reduz latência de lookup -->
    <link rel="dns-prefetch" href="https://js.stripe.com" />
    <link rel="dns-prefetch" href="https://bhxneaeuhybtucmbmpvg.supabase.co" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <!-- Fontes com font-display=swap para não bloquear renderização -->
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@300;400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>
    {!opsShell && (
    <>
    {metaPixelId && <meta name="nm-meta-pixel-id" content={metaPixelId} />}
    <!-- Google Analytics 4: carregado somente apos consentimento explicito. -->
    <script is:inline define:vars={{ ga4MeasurementId }}>
      function nmLocalGet(key) {
        try {
          return localStorage.getItem(key);
        } catch (e) {
          return null;
        }
      }

      function loadGA4() {
        try {
          if (nmLocalGet('nm-cookie-consent') !== 'all') return;
          if (!ga4MeasurementId) return;
          if (document.getElementById('ga4-script')) return;

          window.dataLayer = window.dataLayer || [];
          window.gtag = window.gtag || function gtag(){ window.dataLayer.push(arguments); };

          const script = document.createElement('script');
          script.id = 'ga4-script';
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(ga4MeasurementId);
          document.head.appendChild(script);

          window.gtag('js', new Date());
          updateGaConsent();
          const page = new URL(window.location.href);
          const safeParams = new URLSearchParams();
          if (nmLocalGet('nm-ad-measurement') === 'granted') {
            for (const key of ['gclid', 'gbraid', 'wbraid', 'utm_id', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content']) {
              const value = page.searchParams.get(key);
              if (value && /^[a-zA-Z0-9_-]{1,256}$/.test(value)) safeParams.set(key, value);
            }
          }
          page.pathname = page.pathname.replace(/^\/app\/resultado\/[^/]+(?:\/.*)?$/, '/app/resultado');
          page.search = safeParams.toString();
          page.hash = '';
          window.gtag('config', ga4MeasurementId, {
            anonymize_ip: true,
            allow_google_signals: false,
            allow_ad_personalization_signals: false,
            page_location: page.toString(),
            page_referrer: document.referrer ? new URL(document.referrer).origin : '',
          });
        } catch {
          // Falha de storage nao deve quebrar a pagina.
        }
      }

      function updateGaConsent() {
        const analytics = nmLocalGet('nm-cookie-consent') === 'all';
        const ads = analytics && nmLocalGet('nm-ad-measurement') === 'granted';
        if (ga4MeasurementId) window['ga-disable-' + ga4MeasurementId] = !analytics;
        window.gtag?.('consent', 'update', {
          analytics_storage: analytics ? 'granted' : 'denied',
          ad_storage: ads ? 'granted' : 'denied',
          ad_user_data: ads ? 'granted' : 'denied',
          ad_personalization: 'denied',
        });
      }

      loadGA4();
      window.addEventListener('consentGranted', loadGA4);
      window.addEventListener('nm-cookie-preferences-changed', updateGaConsent);
      window.addEventListener('storage', (event) => {
        if (event.key === 'nm-cookie-consent' || event.key === 'nm-ad-measurement') {
          loadGA4();
          updateGaConsent();
        }
      });
    </script>
    <PostHog />
    <!-- AdSense é independente da conversão Google Ads e exige permissão de anúncios. -->
    <script is:inline>
      function loadConsentedAdSense() {
        try {
          if (localStorage.getItem('nm-ad-measurement') !== 'granted' ||
              document.getElementById('nm-adsense-script') ||
              !['/', '/analise-gratuita', '/blog'].includes(location.pathname) ||
              location.search || location.hash) return;
          window.adsbygoogle = window.adsbygoogle || [];
          window.adsbygoogle.requestNonPersonalizedAds = 1;
          const script = document.createElement('script');
          script.id = 'nm-adsense-script';
          script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2915950435320918';
          script.async = true;
          script.crossOrigin = 'anonymous';
          document.head.appendChild(script);
        } catch {}
      }
      loadConsentedAdSense();
      window.addEventListener('nm-cookie-preferences-changed', loadConsentedAdSense);
    </script>
    </>
    )}
    <slot name="head" />
    <script>
      import { captureFirstTouchUtm } from '../frontend/lib/utm';
      import { initializePaidAttribution } from '../frontend/lib/paid-attribution';
      import { initializeMetaPixel } from '../frontend/lib/meta-pixel';
      captureFirstTouchUtm();
      const { paidAttribution, ga4Id } = document.documentElement.dataset;
      initializePaidAttribution(ga4Id ?? '', paidAttribution === '1');
      const metaPixelId = document.querySelector<HTMLMetaElement>('meta[name="nm-meta-pixel-id"]')?.content;
      if (metaPixelId) initializeMetaPixel(metaPixelId);
    </script>
  </head>
  <body class:list={['bg-[#1a1a1a] text-gray-200 font-inter antialiased', opsShell ? 'overflow-hidden' : 'min-h-screen']}>
    <slot />
    {!opsShell && <CookieBanner client:only="react" />}
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  /* Transparência ao rolar — botão PDF mobile */
  body.is-scrolling #mobile-pdf-btn {
    opacity: 0.25;
    transition: opacity 0.3s ease;
  }

  #mobile-pdf-btn {
    transition: opacity 0.3s ease;
  }
</style>

<script is:inline>
  (function () {
    var scrollTimer;
    window.addEventListener('scroll', function () {
      document.body.classList.add('is-scrolling');
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(function () {
        document.body.classList.remove('is-scrolling');
      }, 1000);
    }, { passive: true });
  })();
</script>
