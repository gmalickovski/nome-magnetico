---
import BaseLayout from './BaseLayout.astro';
import { OPS_NAV, isOpsNavActive } from '../frontend/ops/nav';
import { OpsLogoutButton } from '../frontend/components/ops/OpsLogoutButton';
import OpsMobileDock from '../frontend/components/ops/OpsMobileDock';
import { IconSair, OpsNavIcon } from '../frontend/components/ops/OpsNavIcons';
import { sidebarNavIconClass, sidebarNavLinkClass } from '../frontend/components/app/app-client-nav-shared';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Painel operacional do Nome Magnético.' } = Astro.props;

if (!Astro.locals.user || !Astro.locals.isStaff) {
  return Astro.redirect('/login');
}

const current = Astro.locals.adminPath ?? Astro.url.pathname;
const labelClass =
  'whitespace-nowrap opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100';
---

<BaseLayout title={title} description={description} noIndex={true} opsShell={true}>
  <div class="nm-app-shell--with-mobile-dock fixed inset-0 overflow-y-auto bg-[#1a1a1a] text-[#e5e2e1]">
    <aside
      id="ops-sidebar"
      class="group hidden lg:flex fixed inset-y-0 left-0 z-50 w-20 flex-col overflow-hidden bg-[#111111]/95 px-4 pt-6 pb-7 shadow-[8px_0_30px_rgba(0,0,0,0.45)] backdrop-blur-md transition-[width,box-shadow] duration-300 ease-out hover:w-60 focus-within:w-60 hover:shadow-[12px_0_40px_rgba(0,0,0,0.6)] focus-within:shadow-[12px_0_40px_rgba(0,0,0,0.6)]"
    >
      <a href="/" class="mb-6 flex h-12 items-center gap-3 rounded-2xl px-3" aria-label="Nome Magnético, Operação">
        <span class="font-cinzel text-lg font-bold text-[#f2ca50] flex-shrink-0 w-5 text-center">N</span>
        <span class={`${labelClass} font-cinzel text-xs tracking-[0.18em] text-[#f2ca50]`}>
          NOME MAGNÉTICO
          <span class="block mt-0.5 font-inter text-[10px] uppercase tracking-[0.16em] text-[#76746a]">Operação</span>
        </span>
      </a>

      <nav class="flex flex-1 flex-col gap-1.5 overflow-y-auto overflow-x-hidden [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" aria-label="Painel operacional">
        {OPS_NAV.map((item) => {
          const active = isOpsNavActive(current, item.href);
          return (
            <a href={item.href} class={sidebarNavLinkClass(active)} aria-current={active ? 'page' : undefined}>
              <OpsNavIcon href={item.href} className={sidebarNavIconClass(active)} />
              <span class={labelClass}>{item.label}</span>
            </a>
          );
        })}
      </nav>

      <div class="mt-4 flex flex-col gap-2 pt-4">
        <div class="relative flex h-12 min-h-[44px] items-center gap-3 rounded-2xl px-3 text-sm font-semibold text-[#A0A0A0]">
          <IconSair className="h-5 w-5 flex-shrink-0" />
          <span class={labelClass}><OpsLogoutButton client:load className="!px-0 !py-0 hover:bg-transparent" /></span>
        </div>
      </div>
    </aside>

    <header class="lg:hidden flex items-center justify-between px-3.5 sm:px-5 pt-[max(0.75rem,env(safe-area-inset-top))] pb-2">
      <a href="/" class="block" aria-label="Nome Magnético, Operação">
        <p class="font-cinzel text-sm tracking-[0.18em] text-[#f2ca50]">NOME MAGNÉTICO</p>
        <p class="mt-0.5 text-[10px] uppercase tracking-[0.16em] text-[#76746a]">Operação</p>
      </a>
    </header>

    <main class="lg:ml-20 min-w-0 pb-[calc(6.5rem+env(safe-area-inset-bottom,0px))] lg:pb-10">
      <div class="max-w-[1440px] 2xl:max-w-[1600px] mx-auto w-full">
        <div class="px-3.5 sm:px-6 md:px-10 lg:px-14 py-5 sm:py-8">
          <p class="text-[11px] uppercase tracking-[0.16em] text-[#76746a]">Operação</p>
          <h1 class="mt-2 font-cinzel text-2xl sm:text-3xl font-bold text-[#e5e2e1]">{title}</h1>
        </div>
        <div class="px-3.5 sm:px-6 md:px-10 lg:px-14">
          <slot />
        </div>
      </div>
    </main>

    <OpsMobileDock client:load pathname={current} />
  </div>
</BaseLayout>
