---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title} noIndex={true} opsShell={true}>
  <div class="relative min-h-[100dvh] bg-[#131313]">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_0%,rgba(242,202,80,0.12),transparent_32%),radial-gradient(circle_at_80%_100%,rgba(215,198,255,0.08),transparent_28%)]"></div>
    <main class="relative mx-auto flex min-h-[100dvh] w-full max-w-md flex-col justify-start px-5 pb-[max(1rem,env(safe-area-inset-bottom))] pt-[calc(env(safe-area-inset-top)+clamp(1.5rem,8dvh,4rem))] sm:justify-center sm:py-12">
      <a href="/" class="mb-4 flex justify-center transition-opacity duration-300 hover:opacity-85 sm:mb-8" aria-label="Nome Magnético">
        <img src="/logo-nm-header.svg" alt="Nome Magnético" class="h-8 w-auto sm:h-10" />
      </a>
      <slot />
    </main>
  </div>
</BaseLayout>
