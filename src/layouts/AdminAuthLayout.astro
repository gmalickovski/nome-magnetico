---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title} noIndex={true} opsShell={true}>
  <div class="relative min-h-screen bg-[#131313]">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_0%,rgba(242,202,80,0.12),transparent_32%),radial-gradient(circle_at_80%_100%,rgba(215,198,255,0.08),transparent_28%)]"></div>
    <main class="relative mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-5 py-12">
      <p class="mb-8 text-center font-cinzel text-sm tracking-[0.22em] text-[#f2ca50]">NOME MAGNÉTICO</p>
      <slot />
    </main>
  </div>
</BaseLayout>
