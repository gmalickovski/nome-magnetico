---
import AppLayout from './AppLayout.astro';
import { PDFFeedbackButton } from '../frontend/components/app/PDFFeedbackButton';
import ResultadoMobileDock from '../frontend/components/app/chat/ResultadoMobileDock';

export interface Props {
  title: string;
  analysisId: string;
  productType?: string;
  isFree?: boolean;
  showActions?: boolean;
  isAnalyst?: boolean;
}

const { title, analysisId, productType = 'nome_social', isFree = false, showActions = true, isAnalyst = false } = Astro.props;
---

<AppLayout
  title={title}
  headerBackHref="/app/analises"
  headerBackLabel="Voltar para minhas análises"
>
  {showActions && (
    <PDFFeedbackButton
      slot="header-actions"
      client:load
      analysisId={analysisId}
      productType={productType}
      isFree={isFree}
      showFab={false}
      isAnalyst={isAnalyst}
    />
  )}

  <div class="mx-auto max-w-4xl nm-mobile-dock-pad-action md:pb-20">
    <slot />
  </div>

  {showActions && (
    <ResultadoMobileDock
      client:load
      analysisId={analysisId}
      productType={productType}
      isFree={isFree}
      redoHref={`/app/analise/${productType.replace('_', '-')}`}
    />
  )}

</AppLayout>
