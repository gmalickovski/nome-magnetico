---
// PostHog (analytics de produto) em paralelo ao GA4.
// A chave é lida em runtime na VPS (process.env), como PUBLIC_GA4_MEASUREMENT_ID.
// Sem PUBLIC_POSTHOG_KEY o snippet não inicializa.
const posthogKey = (process.env.PUBLIC_POSTHOG_KEY ?? '').trim();
const posthogHost = (process.env.PUBLIC_POSTHOG_HOST ?? '').trim() || 'https://us.i.posthog.com';
---
<!-- PostHog: só depois do consentimento de cookies, igual ao GA4. -->
<script is:inline define:vars={{ posthogKey, posthogHost }}>
  var NM_UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
  var NM_UTM_STORAGE_KEY = 'nm-utm-first-touch';
  var NM_PENDING_IDENTIFY_KEY = 'nm-posthog-pending-identify';

  function nmHasAnalyticsConsent() {
    return nmStorageGet('nm-cookie-consent') === 'all';
  }

  function nmStorageGet(key) {
    try {
      return localStorage.getItem(key);
    } catch (e) {
      return null;
    }
  }

  function nmStorageSet(key, value) {
    try {
      localStorage.setItem(key, value);
    } catch (e) {}
  }

  function nmReadStoredUtm() {
    try {
      var raw = nmStorageGet(NM_UTM_STORAGE_KEY);
      if (!raw) return null;
      var parsed = JSON.parse(raw);
      if (!parsed || typeof parsed !== 'object') return null;
      return parsed;
    } catch (e) {
      return null;
    }
  }

  function nmPersistUtmFirstTouch() {
    try {
      if (nmStorageGet(NM_UTM_STORAGE_KEY)) return;
      var params = new URLSearchParams(window.location.search);
      var stored = {};
      var found = false;
      for (var i = 0; i < NM_UTM_KEYS.length; i++) {
        var key = NM_UTM_KEYS[i];
        var value = (params.get(key) || '').trim().slice(0, 200);
        if (!value) continue;
        stored[key] = value;
        found = true;
      }
      if (found) nmStorageSet(NM_UTM_STORAGE_KEY, JSON.stringify(stored));
    } catch (e) {}
  }

  function nmUtmSetOnce() {
    var stored = nmReadStoredUtm();
    if (!stored) return null;
    var once = {};
    var found = false;
    for (var i = 0; i < NM_UTM_KEYS.length; i++) {
      var key = NM_UTM_KEYS[i];
      if (typeof stored[key] !== 'string' || !stored[key]) continue;
      once['initial_' + key] = stored[key];
      once['$initial_' + key] = stored[key];
      found = true;
    }
    return found ? once : null;
  }

  function nmNormalizeResultadoPath(pathname) {
    if (typeof pathname !== 'string') return pathname;
    var path = pathname.length > 1 && pathname.charAt(pathname.length - 1) === '/'
      ? pathname.slice(0, -1)
      : pathname;
    if (/^\/app\/resultado\/[^/]+$/.test(path)) return '/app/resultado/:id';
    return pathname;
  }

  function nmSanitizePostHogProperties(props) {
    function isInternalReferrer(value) {
      if (typeof value !== 'string') return false;
      try {
        var host = new URL(value.includes('://') ? value : 'https://' + value).hostname;
        return host === 'nomemagnetico.com.br' || host.endsWith('.nomemagnetico.com.br');
      } catch (e) {
        return false;
      }
    }
    ['$referrer', '$referring_domain', '$initial_referrer', '$initial_referring_domain'].forEach(function (key) {
      if (isInternalReferrer(props[key])) delete props[key];
    });
    ['email', '$email', 'name', '$name', 'nome', 'first_name', 'last_name'].forEach(function (key) {
      delete props[key];
    });
    if (typeof props.$pathname === 'string') {
      props.$pathname = nmNormalizeResultadoPath(props.$pathname);
    }
    ['$current_url', '$referrer', '$entry_url', '$initial_current_url', '$initial_referrer'].forEach(function (key) {
      if (typeof props[key] !== 'string') return;
      try {
        var url = new URL(props[key]);
        url.pathname = nmNormalizeResultadoPath(url.pathname);
        ['email', 'nome', 'name', 'chosen_signature', 'redirect', 'error_description'].forEach(function (param) {
          url.searchParams.delete(param);
        });
        if (url.pathname.startsWith('/auth/')) url.hash = '';
        props[key] = url.toString();
      } catch (e) {}
    });
  }

  function nmSanitizePostHogEvent(event) {
    if (!nmHasAnalyticsConsent()) return null;
    if (!event || !event.properties) return event;
    nmSanitizePostHogProperties(event.properties);
    ['$set', '$set_once'].forEach(function (key) {
      var props = event.properties[key];
      if (props && typeof props === 'object') nmSanitizePostHogProperties(props);
    });
    return event;
  }

  function nmFlushIdentify(sdk) {
    if (!nmHasAnalyticsConsent() || nmStorageGet('nm-user-role') === 'admin') return;
    var pending = window.__nm_pending_identify;
    var userId = pending && pending.userId;
    try {
      if (!userId) userId = sessionStorage.getItem(NM_PENDING_IDENTIFY_KEY);
    } catch (e) {}
    var ph = sdk || window.posthog;
    if (!userId || typeof ph?.get_distinct_id !== 'function') return;
    var once = nmUtmSetOnce();
    ph.identify(userId, undefined, once || undefined);
    window.__nm_pending_identify = undefined;
    try { sessionStorage.removeItem(NM_PENDING_IDENTIFY_KEY); } catch (e) {}
  }

  window.nmIdentifyPostHog = function (userId) {
    if (!userId) return;
    window.__nm_pending_identify = { userId: String(userId) };
    if (nmHasAnalyticsConsent()) {
      try { sessionStorage.setItem(NM_PENDING_IDENTIFY_KEY, String(userId)); } catch (e) {}
    }
    nmFlushIdentify();
  };

  function loadPostHog() {
    try {
      if (!posthogKey || !nmHasAnalyticsConsent()) return;
      nmPersistUtmFirstTouch();
      if (window.__nm_posthog_ready) return;
      window.__nm_posthog_ready = true;

      !function(t,e){var o,n,p,r;e.__SV||(window.posthog && window.posthog.__loaded)||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}p||((p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",p.onerror=function(){p=null},(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r));var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],Object.defineProperty(u,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e}}),Object.defineProperty(u.people,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(){return u.toString(1)+".people (stub)"}}),o="init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group identify setPersonProperties setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags resetGroups onFeatureFlags addFeatureFlagsHandler onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep startSessionRecording stopSessionRecording set_config".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init(posthogKey, {
        api_host: posthogHost || 'https://us.i.posthog.com',
        defaults: '2026-05-30',
        persistence: 'localStorage+cookie',
        cross_subdomain_cookie: true,
        disable_session_recording: false,
        session_recording: {
          maskAllInputs: true,
        },
        before_send: nmSanitizePostHogEvent,
        loaded: function (sdk) {
          if (!nmHasAnalyticsConsent()) {
            sdk.opt_out_capturing();
            return;
          }
          nmFlushIdentify(sdk);
          sdk.startSessionRecording();
          window.dispatchEvent(new Event('nm-posthog-ready'));
        },
      });
    } catch (e) {
      window.__nm_posthog_ready = false;
    }
  }

  loadPostHog();
  if (!window.__nm_posthog_consent_listener) {
    window.__nm_posthog_consent_listener = true;
    window.addEventListener('consentGranted', loadPostHog);
  }
</script>

<script is:inline>
  (function () {
    if (window.__nm_posthog_events) return;
    window.__nm_posthog_events = true;

    function isAdmin() {
      try {
        return nmStorageGet('nm-user-role') === 'admin';
      } catch (e) {
        return false;
      }
    }

    function capture(event, properties) {
      if (isAdmin() || !nmHasAnalyticsConsent()) return false;
      if (typeof window.posthog?.capture !== 'function') return false;
      window.posthog.capture(event, properties);
      return true;
    }

    document.addEventListener('click', function (event) {
      var target = event.target;
      if (!target || !target.closest) return;
      var el = target.closest('[data-cta-id]');
      if (!el) return;
      var ctaId = el.getAttribute('data-cta-id');
      if (!ctaId) return;
      capture('cta_click', {
        cta_id: ctaId,
        position: el.getAttribute('data-cta-position') || '',
      });
    });

    function pagePath() {
      var path = window.location.pathname || '/';
      if (path.length > 1 && path.charAt(path.length - 1) === '/') path = path.slice(0, -1);
      return path;
    }

    var path = pagePath();
    if (path === '/' || path === '/nome-social' || path === '/analise-gratuita') {
      var fired = { 25: false, 50: false, 75: false, 100: false };
      var marks = [25, 50, 75, 100];

      function scrollPercent() {
        var doc = document.documentElement;
        var scrollTop = window.scrollY || doc.scrollTop || 0;
        var height = (doc.scrollHeight || 0) - window.innerHeight;
        if (height <= 0) return 100;
        return Math.min(100, (scrollTop / height) * 100);
      }

      function onScroll() {
        var pct = scrollPercent();
        for (var i = 0; i < marks.length; i++) {
          var mark = marks[i];
          if (fired[mark] || pct < mark) continue;
          if (capture('scroll_depth', { percent: mark, path: pagePath() })) fired[mark] = true;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('nm-posthog-ready', onScroll);
      if (document.readyState === 'complete') onScroll();
      else window.addEventListener('load', onScroll);
    }
  })();
</script>
