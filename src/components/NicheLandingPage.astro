---
import LandingLayout from '../layouts/LandingLayout.astro';
import { LandingHeader } from '../frontend/components/landing/LandingHeader';
import { LandingFooter } from '../frontend/components/landing/LandingFooter';
import { PricingSection } from '../frontend/components/landing/PricingSection';
import { FAQSection } from '../frontend/components/landing/FAQSection';
import {
  NicheHeroScene,
  NicheQuestionsSection,
  NicheAnalysisSection,
  NicheSuggestionsSection,
  NicheDeliverablesSection,
  NicheNoticeSection,
  NicheFinalCtaSection,
  type NichePageCopy,
} from '../frontend/components/landing/niche';
import type { NichePageSsrData } from '../backend/landing/niche-page-data';

export interface Props {
  copy: NichePageCopy;
  ssr: NichePageSsrData;
}

const { copy, ssr } = Astro.props;
const isArtistico = copy.id === 'artistico';
const isBebe = copy.id === 'bebe';
const heroGlowClass = isBebe
  ? 'bg-[#f9a8d4]/10'
  : isArtistico
    ? 'bg-[#bea5ff]/14'
    : 'bg-[#D4AF37]/14';
---

<LandingLayout
  title={copy.seo.title}
  description={copy.seo.description}
  keywords={copy.seo.keywords}
  schemaOfferPrice={ssr.schemaOfferPrice}
  schemaEstimatedCost={ssr.schemaOfferPrice}
>
  <script type="application/ld+json" set:html={JSON.stringify(ssr.schemaProduct)} />
  <script type="application/ld+json" set:html={JSON.stringify(ssr.schemaFaq)} />

  <LandingHeader client:load />

  <main class="bg-[#111111]">
    {/* Seção 1: Hero SSR + DeviceFrame both + ChatScene */}
    <section
      id="inicio"
      class="relative isolate overflow-hidden bg-[#111111] pt-[88px] sm:pt-28 lg:pt-32 pb-12 sm:pb-16 lg:pb-20"
    >
      <div class="absolute inset-0 pointer-events-none z-0" aria-hidden="true">
        <div
          class={`absolute top-1/3 left-1/2 lg:left-[24%] -translate-x-1/2 -translate-y-1/2 w-[320px] h-[320px] sm:w-[520px] sm:h-[520px] lg:w-[700px] lg:h-[700px] ${heroGlowClass} rounded-full blur-[120px]`}
        ></div>
      </div>

      <div class="relative z-10 max-w-[1440px] 2xl:max-w-[1600px] mx-auto px-4 sm:px-6 md:px-10 lg:px-12 w-full min-w-0">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center text-center lg:text-left">
          <div class="lg:col-span-5 flex flex-col items-center lg:items-start min-w-0">
            <p class="nm-eyebrow mb-3">{copy.hero.eyebrow}</p>
            <h1 class="nm-h1">
              {copy.hero.titleLead}{' '}
              <span class="bg-gradient-to-r from-[#f2ca50] via-[#D4AF37] to-[#bea5ff] bg-clip-text text-transparent">
                {copy.hero.titleHighlight}
              </span>
            </h1>
            <p class="nm-body-lg mt-5 md:mt-6 max-w-[54ch]">{copy.hero.description}</p>

            <div class="mt-8 w-full sm:w-auto flex flex-col sm:flex-row items-center gap-3">
              <a
                href={copy.ctaHref}
                data-cta-id={copy.hero.primaryCtaId}
                data-cta-position="hero"
                class="w-full sm:w-auto inline-flex min-h-12 items-center justify-center rounded-full bg-[#D4AF37] hover:bg-[#f2ca50] px-8 py-3.5 text-base font-semibold text-[#131313] shadow-lg shadow-[#D4AF37]/20 transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
              >
                {copy.hero.primaryCtaLabel}
              </a>
              <a
                href={copy.hero.secondaryCtaHref}
                data-cta-id="analise_gratis"
                data-cta-position={`${copy.id}_hero`}
                class="w-full sm:w-auto inline-flex min-h-12 items-center justify-center rounded-full bg-white/5 hover:bg-white/10 px-8 py-3.5 text-base font-medium text-[#e5e2e1] transition-colors duration-500"
              >
                {copy.hero.secondaryCtaLabel}
              </a>
            </div>
            <p class="nm-caption mt-4">{copy.hero.trustLine}</p>
          </div>

          <div class="lg:col-span-7 w-full min-w-0">
            <NicheHeroScene client:idle niche={copy.id} srSummary={copy.hero.sceneSrSummary} />
          </div>
        </div>
      </div>
    </section>

    {/* Seção 2: O que perguntamos */}
    <NicheQuestionsSection client:visible copy={copy} />

    {/* Seção 3: O que o cálculo mostra */}
    <NicheAnalysisSection client:visible copy={copy} />

    {/* Seção 4: Os nomes que você recebe */}
    <NicheSuggestionsSection client:visible copy={copy} />

    {/* Seção 5: O que você leva */}
    <NicheDeliverablesSection client:visible copy={copy} />

    {/* Seção 6: Avisos (contratos em artístico, registro sem prazos em bebê, ausente em social) */}
    <NicheNoticeSection client:visible copy={copy} />

    {/* Seção 7: Preço */}
    <PricingSection
      client:visible
      hqPrices={ssr.hqPrices}
      promotion={ssr.promotion}
      isLoggedIn={ssr.isLoggedIn}
    />

    {/* Seção 8: FAQ do nicho */}
    <FAQSection client:visible items={ssr.faqItems} />

    {/* Seção 9: CTA final */}
    <NicheFinalCtaSection client:visible copy={copy} />
  </main>

  <LandingFooter client:visible />
</LandingLayout>
