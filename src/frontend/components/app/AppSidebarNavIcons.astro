---
/** Ícones Lucide (stroke 1.5) para a sidebar desktop da área do cliente. */
export interface Props {
  name: 'inicio' | 'analises' | 'glossario' | 'suporte';
  class?: string;
}

const { name, class: className = 'h-5 w-5 flex-shrink-0' } = Astro.props;
const sw = '1.5';
---

{name === 'inicio' && (
  <svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <rect x="3" y="3" width="7" height="9" rx="1" stroke-width={sw}></rect>
    <rect x="14" y="3" width="7" height="5" rx="1" stroke-width={sw}></rect>
    <rect x="14" y="12" width="7" height="9" rx="1" stroke-width={sw}></rect>
    <rect x="3" y="16" width="7" height="5" rx="1" stroke-width={sw}></rect>
  </svg>
)}
{name === 'analises' && (
  <svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
    <path stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" d="M14 2v4a2 2 0 0 0 2 2h4"></path>
    <path stroke-width={sw} stroke-linecap="round" d="M10 9H8"></path>
    <path stroke-width={sw} stroke-linecap="round" d="M16 13H8"></path>
    <path stroke-width={sw} stroke-linecap="round" d="M16 17H8"></path>
  </svg>
)}
{name === 'glossario' && (
  <svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" d="M12 7v14"></path>
    <path stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path>
  </svg>
)}
{name === 'suporte' && (
  <svg class={className} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="10" stroke-width={sw}></circle>
    <path stroke-width={sw} d="m4.93 4.93 4.24 4.24"></path>
    <path stroke-width={sw} d="m14.83 9.17 4.24-4.24"></path>
    <path stroke-width={sw} d="m14.83 14.83 4.24 4.24"></path>
    <path stroke-width={sw} d="m9.17 14.83-4.24 4.24"></path>
    <circle cx="12" cy="12" r="4" stroke-width={sw}></circle>
  </svg>
)}
