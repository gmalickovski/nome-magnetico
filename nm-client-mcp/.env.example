# Configuração do Servidor nm-client-mcp (DEV-208)
MCP_PORT=8766
MCP_HOST=127.0.0.1

# URL base do app Nome Magnético (para chamadas HMAC internas)
APP_URL=http://127.0.0.1:4321

# Segredo compartilhado HMAC para endpoints internos (/api/internal/client-mcp/*)
INTERNAL_HMAC_SECRET=coloque_aqui_o_segredo_hmac_compartilhado

# Credenciais Supabase (role nm_client_mcp_bot / anon - NUNCA a service_role!)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-ou-jwt-scoped
