# Configuração do Servidor nm-mcp
MCP_PORT=8765
MCP_HOST=127.0.0.1

# URL base do app Nome Magnético (para chamadas HMAC internas)
APP_URL=http://127.0.0.1:4321

# Segredo compartilhado HMAC para endpoints internos (/api/internal/mcp/*)
# Deve ser idêntico ao INTERNAL_HMAC_SECRET (ou INTERNAL_API_SECRET) do app
INTERNAL_HMAC_SECRET=coloque_aqui_o_segredo_hmac_compartilhado

# Credenciais Supabase (role nm_mcp_bot / anon - NUNCA a service_role!)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-ou-jwt-scoped

# Configuração de tokens dos agentes (JSON array)
# Gere novos tokens com: npm run token:generate <nome_do_agente>
MCP_TOKENS_JSON='[{"agent":"grok_bot","token_hash":"hash_sha256_aqui","scopes":["read","reprocess","resend"],"is_active":true}]'
